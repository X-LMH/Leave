# 生产服务器模板；复制为 /www/wwwroot/Leave/config/config.server.yaml。
# MYSQL_PASSWORD、REDIS_PASSWORD 和 JWT_SECRET 从服务器 .env 注入，不随发布包上传。
log:
  # debug、info、warn、error、dpanic、panic、fatal；缺省为 info。
  level: info
  # 服务器采用结构化 JSON 输出；省略此项时为 console。
  encoding: json

app:
  port: 8000
  package_dir: /www/wwwroot/Leave/packages/android

storage:
  root_dir: /www/wwwroot/Leave/uploads
  base_url: http://leave.mhspace.dpdns.org/api/v1/uploads

redis:
  host: 127.0.0.1
  port: 6379
  username: ""
  # 生产环境建议通过 REDIS_PASSWORD 环境变量注入。
  password: ""
  db: 0

mysql:
  host: 127.0.0.1
  port: 3306
  database: leave_list
  user: leave_list
  password: ""

jwt:
  secret: ""
  expiration_days: 30
