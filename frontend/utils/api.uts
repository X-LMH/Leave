import { getAppVersionCode } from '@/utils/device.uts'

// HBuilderX“运行”是 development，“发行/打包”是 production。
export const API_BASE_URL = process.env.NODE_ENV === 'development'
	? 'http://192.168.0.86:8080/api/v1'
	: 'http://leave.mhspace.dpdns.org/api/v1'

export const STORAGE_TOKEN_KEY = 'leave_token'
export const STORAGE_STUDENT_ID_KEY = 'leave_student_id'
export const STORAGE_NAME_KEY = 'leave_name'
export const STORAGE_CLASS_NAME_KEY = 'leave_class_name'
export const STORAGE_DEVICE_NAME_KEY = 'leave_device_name'
export const STORAGE_UPDATE_INFO_KEY = 'leave_update_info'
export const APP_PLATFORM = 'android'

export type ApiResponse<T> = {
	code: number
	message: string
	data: T
}

export type AppVersionInfo = {
	platform: string
	latest_version_code: number
	latest_version_name: string
	updates: AppVersionUpdate[]
}

export type AppVersionUpdate = {
	version_code: number
	version_name: string
	release_notes: string[]
}

let isRedirectingToUpdate = false

export class LoginData {
	token: string = ''
	user: CurrentUser = {
		student_id: '',
		name: '',
		class_name: ''
	}
	profile_completed: boolean = false
}

export type CurrentUser = {
	student_id: string
	name: string
	class_name: string
}

export type ProfileClassInfo = {
	college: string
	major: string
	class_name: string
}

export type ProfileApartmentInfo = {
	apartment_name: string
	dormitory_number: string
}

export type ProfileData = {
	student_id: string
	name: string
	phone: string
	gender: string
	parent_name: string
	parent_phone: string
	teacher_name: string
	class_id: number
	apartment_id: number
	class_info: ProfileClassInfo
	apartment_info: ProfileApartmentInfo
}

export type ClassOption = {
	id: number
	college: string
	major: string
	class_name: string
}

export type ApartmentOption = {
	id: number
	name: string
	gender: string
}

export type ProfilePayload = {
	name: string
	phone: string
	gender: string
	parent_name: string
	parent_phone: string
	class_id: number
	apartment_id: number
	dormitory_number: string
	teacher_name: string
}

export type RecordApplicantInfo = {
	name: string
	parent_name: string
	parent_phone: string
	teacher_name: string
}

export type LeaveTypeOption = {
	id: number
	name: string
}

export type RecordCreatePayload = {
	leave_type_id: number
	start_time: string
	end_time: string
	affected_course: string
	is_leave_school: boolean
	leave_reason: string
	travel_way: string
	applied_at: string
	approved_at: string
}

export type RecordDetail = {
	id: number
	student_id: string
	applicant_info: RecordApplicantInfo
	class_info: ProfileClassInfo
	leave_type: string
	start_time: string
	end_time: string
	duration_days: number
	duration_hours: number
	affected_course: string
	is_leave_school: boolean
	leave_reason: string
	travel_way: string
	applied_at: string
	approved_at: string
}

export type RecordListItem = {
	id: number
	leave_type: string
	leave_reason: string
	start_time: string
	end_time: string
	duration_days: number
	duration_hours: number
}

export type FeedbackPayload = {
	content: string
	is_anonymous: boolean
}

export type FeedbackResponse = {
	id: number
	is_anonymous: boolean
	content: string
	created_at: string
}

function clearSession() {
	uni.removeStorageSync(STORAGE_TOKEN_KEY)
	uni.removeStorageSync(STORAGE_STUDENT_ID_KEY)
	uni.removeStorageSync(STORAGE_NAME_KEY)
	uni.removeStorageSync(STORAGE_CLASS_NAME_KEY)
	uni.removeStorageSync(STORAGE_DEVICE_NAME_KEY)
}

export function getStoredName(): string {
	const storedName = uni.getStorageSync(STORAGE_NAME_KEY)
	return typeof storedName == 'string' ? storedName : ''
}

export function getCurrentUser(): CurrentUser {
	const studentID = uni.getStorageSync(STORAGE_STUDENT_ID_KEY)
	const name = uni.getStorageSync(STORAGE_NAME_KEY)
	const className = uni.getStorageSync(STORAGE_CLASS_NAME_KEY)
	return {
		student_id: typeof studentID == 'string' ? studentID : '',
		name: typeof name == 'string' ? name : '',
		class_name: typeof className == 'string' ? className : ''
	}
}

export function updateCurrentUser(user: CurrentUser) {
	uni.setStorageSync(STORAGE_STUDENT_ID_KEY, user.student_id)
	uni.setStorageSync(STORAGE_NAME_KEY, user.name)
	uni.setStorageSync(STORAGE_CLASS_NAME_KEY, user.class_name)
}

export function getStoredDeviceName(): string {
	const storedDeviceName = uni.getStorageSync(STORAGE_DEVICE_NAME_KEY)
	return typeof storedDeviceName == 'string' ? storedDeviceName : ''
}

export function saveSession(studentID: string, data: LoginData, deviceName: string = '') {
	uni.setStorageSync(STORAGE_TOKEN_KEY, data.token)
	uni.setStorageSync(STORAGE_STUDENT_ID_KEY, data.user.student_id)
	uni.setStorageSync(STORAGE_NAME_KEY, data.user.name)
	uni.setStorageSync(STORAGE_CLASS_NAME_KEY, data.user.class_name)
	uni.setStorageSync(STORAGE_DEVICE_NAME_KEY, deviceName)
}

export function logout() {
	clearSession()
}

export function logoutRequest(): Promise<void> {
	return request<void>('/logout', 'POST', null, true)
}

export function updateClientInfo(deviceName: string, appVersion: string): Promise<void> {
	return request<void>('/client-info', 'POST', { device_name: deviceName, app_version: appVersion }, true)
}

export function changePassword(password: string, newPassword: string, rePassword: string): Promise<void> {
	return request<void>('/password', 'POST', {
		password: password,
		new_password: newPassword,
		re_password: rePassword
	}, true)
}

function handleUnauthorized() {
	clearSession()
	uni.reLaunch({ url: '/pages/auth/login' })
}

function appVersionInfoFromJSON(data: UTSJSONObject): AppVersionInfo {
	const updatesData = data['updates'] as UTSJSONObject[] | null
	// TODO: 旧客户端全部升级后，删除旧字段回退逻辑。
	const latestVersionCode = data['latest_version_code'] as number | null
	const latestVersionName = data['latest_version_name'] as string | null
	const updates: AppVersionUpdate[] = []
	if (updatesData != null) {
		for (const update of updatesData) {
			const updateNotes = update['release_notes'] as string[] | null
			updates.push({
				version_code: update['version_code'] as number,
				version_name: update['version_name'] as string,
				release_notes: updateNotes == null ? [] : updateNotes
			})
		}
	}
	return {
		platform: data['platform'] as string,
		latest_version_code: latestVersionCode == null ? data['version_code'] as number : latestVersionCode,
		latest_version_name: latestVersionName == null ? data['version_name'] as string : latestVersionName,
		updates: updates
	}
}

export function saveUpdateInfo(version: AppVersionInfo) {
	uni.setStorageSync(STORAGE_UPDATE_INFO_KEY, JSON.stringify(version))
}

export function getStoredUpdateInfo(): AppVersionInfo | null {
	const storedValue = uni.getStorageSync(STORAGE_UPDATE_INFO_KEY)
	if (typeof storedValue != 'string' || storedValue == '') return null

	try {
		const data = JSON.parse<UTSJSONObject>(storedValue)
		if (data == null) return null
		return appVersionInfoFromJSON(data)
	} catch (_) {
		return null
	}
}

function handleForceUpdate(data: UTSJSONObject | null) {
	if (data != null) {
		saveUpdateInfo(appVersionInfoFromJSON(data))
	}
	if (isRedirectingToUpdate) return

	isRedirectingToUpdate = true
	uni.reLaunch({
		url: '/pages/update/index',
		complete: () => {
			isRedirectingToUpdate = false
		}
	})
}

function toRequestData(data: object): UTSJSONObject {
	return JSON.parse<UTSJSONObject>(JSON.stringify(data))!
}

export function getCurrentAppVersion(): Promise<AppVersionInfo> {
	return new Promise((resolve, reject) => {
		uni.request<UTSJSONObject>({
			url: API_BASE_URL + '/app-version?platform=' + APP_PLATFORM + '&version_code=' + getAppVersionCode(),
			method: 'GET',
			success: (response) => {
				const body = response.data
				const code = body == null ? -1 : body['code'] as number
				if (body == null || code != 0) {
					const message = body == null ? '' : body['message'] as string
					reject(new Error(message == '' ? '无法获取最新版本信息' : message))
					return
				}
				resolve(appVersionInfoFromJSON(body['data'] as UTSJSONObject))
			},
			fail: (error) => {
				const detail = error.errMsg
				reject(new Error(detail == null || detail == '' ? '网络连接失败，请检查网络后重试' : detail))
			}
		})
	})
}

export function getAppDownloadURL(): string {
	return API_BASE_URL + '/app-download?platform=' + APP_PLATFORM
}

export function request<T>(path: string, method: 'GET' | 'POST' | 'DELETE' = 'GET', data: object | null = null, requiresAuth: boolean = false): Promise<T> {
	return new Promise((resolve, reject) => {
		const header = { 'Content-Type': 'application/json' } as UTSJSONObject
		header['X-App-Platform'] = APP_PLATFORM
		header['X-App-Version-Code'] = getAppVersionCode().toString()
		if (requiresAuth) {
			const storedToken = uni.getStorageSync(STORAGE_TOKEN_KEY)
			const token = typeof storedToken == 'string' ? storedToken : ''
			if (token == '') {
				handleUnauthorized()
				reject(new Error('请先登录'))
				return
			}
			header['Authorization'] = 'Bearer ' + token
		}

		// uni.request 无法读取外层 request<T> 的动态泛型信息。
		// 使用 ApiResponse<T> 会使原生 JSONObject 在运行时被强转为 T 而失败。
		uni.request<UTSJSONObject>({
			url: API_BASE_URL + path,
			method: method,
			data: data == null ? null : toRequestData(data),
			header: header,
			success: (response) => {
				const body = response.data
				if (body == null) {
					reject(new Error('服务器未返回有效数据'))
					return
				}
				const code = body['code'] as number
				const message = body['message'] as string
				if (code == 0) {
					resolve(body['data'] as T)
					return
				}
				if (code == 1004 || code == 1005) {
					handleUnauthorized()
				}
				if (code == 5002) {
					handleForceUpdate(body['data'] as UTSJSONObject | null)
				}
				reject(new Error(message == '' ? '请求失败' : message))
			},
			fail: (error) => {
				const detail = error.errMsg
				reject(new Error(detail == null || detail == '' ? '网络连接失败，请检查后端服务和局域网连接' : detail))
			}
		})
	})
}

export function register(studentID: string, password: string, rePassword: string): Promise<void> {
	return request<void>('/register', 'POST', {
		student_id: studentID,
		password: password,
		re_password: rePassword
	})
}

export async function login(studentID: string, password: string, deviceName: string, appVersion: string): Promise<LoginData> {
	const data = await request<UTSJSONObject>('/login', 'POST', {
		student_id: studentID,
		password: password,
		device_name: deviceName,
		app_version: appVersion
	})
	const loginData = new LoginData()
	loginData.token = data['token'] as string
	const userData = data['user'] as UTSJSONObject
	loginData.user = {
		student_id: userData['student_id'] as string,
		name: userData['name'] as string,
		class_name: userData['class_name'] as string
	}
	loginData.profile_completed = data['profile_completed'] as boolean
	return loginData
}

export async function getProfile(): Promise<ProfileData | null> {
	const data = await request<UTSJSONObject | null>('/profile', 'GET', null, true)
	if (data == null) return null
	const profile = {
		student_id: data['student_id'] as string,
		name: data['name'] as string,
		phone: data['phone'] as string,
		gender: data['gender'] as string,
		parent_name: data['parent_name'] as string,
		parent_phone: data['parent_phone'] as string,
		teacher_name: data['teacher_name'] as string,
		class_id: data['class_id'] as number,
		apartment_id: data['apartment_id'] as number,
		class_info: {
			college: '',
			major: '',
			class_name: ''
		},
		apartment_info: {
			apartment_name: '',
			dormitory_number: ''
		}
	} as ProfileData
	const classInfo = data['class_info'] as UTSJSONObject
	const apartmentInfo = data['apartment_info'] as UTSJSONObject
	profile.class_info = {
		college: classInfo['college'] as string,
		major: classInfo['major'] as string,
		class_name: classInfo['class_name'] as string
	}
	profile.apartment_info = {
		apartment_name: apartmentInfo['apartment_name'] as string,
		dormitory_number: apartmentInfo['dormitory_number'] as string
	}
	return profile
}

export function saveProfile(payload: ProfilePayload): Promise<void> {
	return request<void>('/profile', 'POST', payload, true)
}

export async function getClasses(): Promise<ClassOption[]> {
	const data = await request<UTSJSONObject[]>('/classes', 'GET', null, true)
	return data.map((item): ClassOption => {
		return {
			id: item['id'] as number,
			college: item['college'] as string,
			major: item['major'] as string,
			class_name: item['class_name'] as string
		}
	})
}

export async function getApartments(gender: string): Promise<ApartmentOption[]> {
	const data = await request<UTSJSONObject[]>('/apartments?gender=' + gender, 'GET', null, true)
	return data.map((item): ApartmentOption => {
		return {
			id: item['id'] as number,
			name: item['name'] as string,
			gender: item['gender'] as string
		}
	})
}

export async function getLeaveTypes(): Promise<LeaveTypeOption[]> {
	const data = await request<UTSJSONObject[]>('/leave-types', 'GET', null, true)
	return data.map((item): LeaveTypeOption => {
		return {
			id: item['id'] as number,
			name: item['name'] as string
		}
	})
}

export async function createRecord(payload: RecordCreatePayload): Promise<RecordDetail> {
	return recordDetailFromJSON(await request<UTSJSONObject>('/record', 'POST', payload, true))
}

export function submitFeedback(content: string, isAnonymous: boolean): Promise<FeedbackResponse> {
	const payload: FeedbackPayload = {
		content: content,
		is_anonymous: isAnonymous
	}
	return request<FeedbackResponse>('/feedback', 'POST', payload, true)
}

export async function getRecord(id: number): Promise<RecordDetail> {
	return recordDetailFromJSON(await request<UTSJSONObject>('/record/' + id, 'GET', null, true))
}

export async function getRecords(page: number, pageSize: number): Promise<RecordListItem[]> {
	const path = '/records?page=' + page + '&page_size=' + pageSize
	const data = await request<UTSJSONObject[]>(path, 'GET', null, true)
	return data.map((item): RecordListItem => {
		return {
			id: item['id'] as number,
			leave_type: item['leave_type'] as string,
			leave_reason: item['leave_reason'] as string,
			start_time: item['start_time'] as string,
			end_time: item['end_time'] as string,
			duration_days: item['duration_days'] as number,
			duration_hours: item['duration_hours'] as number
		}
	})
}

export function deleteRecord(id: number): Promise<void> {
	return request<void>('/record/' + id, 'DELETE', null, true)
}

function recordDetailFromJSON(data: UTSJSONObject): RecordDetail {
	const classInfo = data['class_info'] as UTSJSONObject
	return {
		id: data['id'] as number,
		student_id: data['student_id'] as string,
		applicant_info: {
			name: (data['applicant_info'] as UTSJSONObject)['name'] as string,
			parent_name: (data['applicant_info'] as UTSJSONObject)['parent_name'] as string,
			parent_phone: (data['applicant_info'] as UTSJSONObject)['parent_phone'] as string,
			teacher_name: (data['applicant_info'] as UTSJSONObject)['teacher_name'] as string
		},
		class_info: {
			college: classInfo['college'] as string,
			major: classInfo['major'] as string,
			class_name: classInfo['class_name'] as string
		},
		leave_type: data['leave_type'] as string,
		start_time: data['start_time'] as string,
		end_time: data['end_time'] as string,
		duration_days: data['duration_days'] as number,
		duration_hours: data['duration_hours'] as number,
		affected_course: data['affected_course'] as string,
		is_leave_school: data['is_leave_school'] as boolean,
		leave_reason: data['leave_reason'] as string,
		travel_way: data['travel_way'] as string,
		applied_at: data['applied_at'] as string,
		approved_at: data['approved_at'] as string
	}
}
