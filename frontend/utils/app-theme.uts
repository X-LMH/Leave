import { reactive } from 'vue'
import { systemIncreasesContrast } from '@/utils/navigation-preferences.uts'

export type AppearanceMode = 'light' | 'dark' | 'auto'

type AppThemeState = {
	mode: AppearanceMode
	isDark: boolean
	highContrast: boolean
}

const STORAGE_KEY = 'appearance_mode'
export const themeState = reactive({ mode: 'auto', isDark: false, highContrast: false } as AppThemeState)
let initialized = false

export function appearanceLabel(mode: string): string {
	return mode == 'dark' ? '暗色' : mode == 'light' ? '亮色' : '自动'
}

export function syncThemePreferences() {
	themeState.highContrast = uni.getStorageSync('navigation_high_contrast') == true || systemIncreasesContrast()
}

export function refreshAppTheme() {
	// #ifdef WEB
	themeState.isDark = themeState.mode == 'auto'
		? uni.getAppBaseInfo().hostTheme == 'dark'
		: themeState.mode == 'dark'
	// #endif
	// #ifdef APP
	const appTheme = uni.getAppBaseInfo().appTheme
	themeState.isDark = appTheme == 'auto'
		? uni.getDeviceInfo().osTheme == 'dark'
		: appTheme == 'dark'
	// #endif
	syncThemePreferences()
}

export function initializeAppTheme() {
	if (initialized) return
	initialized = true
	const saved = uni.getStorageSync(STORAGE_KEY)
	const mode = saved == 'light' || saved == 'dark' ? saved as string : 'auto'
	themeState.mode = mode
	// 在启动页面创建前先计算颜色，防止暗色启动短暂显示亮色内容。
	// #ifdef WEB
	refreshAppTheme()
	uni.onHostThemeChange((result) => {
		if (themeState.mode == 'auto') themeState.isDark = result.hostTheme == 'dark'
	})
	// #endif
	// #ifdef APP
	themeState.isDark = mode == 'auto' ? uni.getDeviceInfo().osTheme == 'dark' : mode == 'dark'
	syncThemePreferences()
	uni.onAppThemeChange((result: AppThemeChangeResult) => {
		themeState.isDark = result.appTheme == 'dark'
	})
	uni.setAppTheme({ theme: mode, fail: (_) => refreshAppTheme() })
	// #endif
}

export function setAppearanceMode(mode: AppearanceMode) {
	// #ifdef WEB
	themeState.mode = mode
	uni.setStorageSync(STORAGE_KEY, mode)
	refreshAppTheme()
	// #endif
	// #ifdef APP
	uni.setAppTheme({
		theme: mode,
		success: (_) => {
			themeState.mode = mode
			uni.setStorageSync(STORAGE_KEY, mode)
			refreshAppTheme()
		},
		fail: (_) => {
			uni.showToast({ title: '外观切换失败，请重试', icon: 'none' })
		}
	})
	// #endif
}

// 每个元素直接绑定自己的主题类，兼容原生 uvue 的样式隔离与缓存页面。
export function themeClass(classes: string): string {
	if (!themeState.isDark) return classes
	let result = classes
	classes.split(' ').forEach((name: string) => {
		if (name == '') return
		result += ' dark-' + name
		if (themeState.highContrast) result += ' contrast-' + name
	})
	return result
}

export function themeImage(source: string): string {
	if (!themeState.isDark) return source
	return darkImages.get(source) ?? source
}

// 仅替换经过配色的线性 SVG；头像、附件和更新插画保持原图。
