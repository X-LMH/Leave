<template>
	<AuthPageShell ref="pageShell" enter-direction="forward" title="登录" subtitle="欢迎使用请假申请系统" button-text="登录" switch-prefix="还没有账号?" switch-text="立即注册" card-class="auth-login-card" @submit="login" @switch-page="goRegister">
		<AuthInputField label="学号" placeholder="请输入学号" icon="/static/auth/icons/denglu.svg" :password="false" :required="true" :maxlength="30" field-class="" />
		<AuthInputField label="密码" placeholder="请输入密码" icon="/static/auth/icons/mima.svg" :password="true" :required="true" :maxlength="30" field-class="auth-field-spaced" />
		<template #card-footer>
			<view class="register-link" @click="goRegister">
				<text class="register-link-text">去注册</text>
				<text class="register-arrow">›</text>
			</view>
		</template>
	</AuthPageShell>
</template>

<script setup lang="uts">
import AuthPageShell from '@/components/AuthPageShell.uvue'
import AuthInputField from '@/components/AuthInputField.uvue'
function goRegister() {
	uni.navigateTo({ url: '/pages/auth/register' })
}

function login() {
	uni.reLaunch({ url: '/pages/home/index' })
}
</script>

<style>
.register-link { height: 76rpx; padding-right: 18rpx; flex-direction: row; justify-content: flex-end; align-items: center; }
.register-link-text { color: #5475d8; font-size: 25rpx; }
.register-arrow { margin-left: 8rpx; color: #5475d8; font-size: 38rpx; line-height: 38rpx; }
