<template>
	<ProfilePageShell
		title="个人信息"
		subtitle=""
		:scrollable="true"
		:logout-on-back="false"
	>
		<template #toolbar>
			<view
				:class="themeClass('toolbar-edit')"
				@click="editProfile"
			>
				<text :class="themeClass('toolbar-edit-text')">编辑</text>
			</view>
		</template>
		<view :class="themeClass('avatar-section')">
			<view
				:class="themeClass('avatar-frame')"
				@click.stop="openAvatar"
			>
				<image
					v-if="avatarURL != '' && !avatarLoadFailed"
					:class="themeClass('profile-avatar')"
					:src="themeImage(avatarURL)"
					mode="aspectFill"
					@error="handleAvatarError"
				></image>
				<view
					v-else
					:class="themeClass('profile-avatar avatar-placeholder')"
				>
					<text :class="themeClass('avatar-initial')">
						{{ profile.name.trim() == '' ? '同' : profile.name.trim().slice(0, 1) }}
					</text>
				</view>
			</view>
			<text :class="themeClass('profile-name')">{{ profile.name }}</text>
			<text :class="themeClass('profile-class')">{{ profile.class_info.class_name }}</text>
		</view>
		<view :class="themeClass('quick-actions')">
			<view
				:class="themeClass('quick-action')"
				@click="editProfile"
			>
				<image
					:class="themeClass('action-symbol')"
					:src="themeImage('/static/ios/edit-blue.svg')"
					mode="aspectFit"
				></image>
				<text :class="themeClass('action-label')">编辑资料</text>
			</view>
			<view
				:class="themeClass('quick-action')"
				@click="openPassword"
			>
				<image
					:class="themeClass('action-symbol')"
					:src="themeImage('/static/ios/lock-blue.svg')"
					mode="aspectFit"
				></image>
				<text :class="themeClass('action-label')">账号安全</text>
			</view>
		</view>
		<text :class="themeClass('group-title')">学生资料</text>
		<view :class="themeClass('info-card')">
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">学号</text>
				<text :class="themeClass('info-value')">{{ profile.student_id }}</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">班级</text>
				<text :class="themeClass('info-value')">{{ profile.class_info.class_name }}</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">性别</text>
				<text :class="themeClass('info-value')">{{ profile.gender == 'male' ? '男' : '女' }}</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">导员</text>
				<text :class="themeClass('info-value')">{{ profile.teacher_name }}</text>
			</view>
		</view>
		<text :class="themeClass('group-title')">联系方式</text>
		<view :class="themeClass('info-card')">
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">手机号</text>
				<text :class="themeClass('info-value')">{{ formatPhone(profile.phone) }}</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">家长姓名</text>
				<text :class="themeClass('info-value')">{{ profile.parent_name }}</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">家长电话</text>
				<text :class="themeClass('info-value')">{{ formatPhone(profile.parent_phone) }}</text>
			</view>
		</view>
		<text :class="themeClass('group-title')">住宿信息</text>
		<view :class="themeClass('info-card')">
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">公寓</text>
				<text :class="themeClass('info-value')">
					{{
						profile.apartment_info.apartment_name == ''
							? '未填写'
							: profile.apartment_info.apartment_name
					}}
				</text>
			</view>
			<view :class="themeClass('info-row')">
				<text :class="themeClass('info-label')">宿舍号</text>
				<text :class="themeClass('info-value')">
					{{
						profile.apartment_info.dormitory_number == ''
							? '未填写'
							: profile.apartment_info.dormitory_number
					}}
				</text>
			</view>
		</view>
		<text :class="themeClass('privacy-note')">资料仅用于请假申请与身份核验</text>
	</ProfilePageShell>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
import { ref } from 'vue'
import {
	getCurrentUser,
	getProfile,
	getStoredAvatarURL,
	ProfileData,
	uploadAvatar,
	AvatarUploadError
} from '@/utils/api.uts'
import {
	cacheAvatarFile,
	clearAvatarFileCache,
	getCachedAvatarSource
} from '@/utils/avatar-cache.uts'
import { chooseAvatarImage } from '@/utils/avatar-picker.uts'

const avatarURL = ref(getCachedAvatarSource(getCurrentUser().student_id, getStoredAvatarURL()))
const avatarLoadFailed = ref(false)
const changingAvatar = ref(false)
const avatarMenuOpen = ref(false)
let avatarUpdateVersion = 0
let pageActive = true

const profile = ref<ProfileData>({
	avatar_url: '',
	student_id: '',
	name: '',
	phone: '',
	gender: '',
	parent_name: '',
	parent_phone: '',
	teacher_name: '',
	class_id: 0,
	apartment_id: 0,
	class_info: { college: '', major: '', class_name: '' },
	apartment_info: { apartment_name: '', dormitory_number: '' }
})

function openPassword() {
	uni.navigateTo({ url: '/pages/profile/password' })
}

function editProfile() {
	uni.navigateTo({ url: '/pages/profile/edit' })
}

function handleAvatarError() {
	const remoteURL = getStoredAvatarURL()
	if (remoteURL != '' && avatarURL.value != remoteURL) {
		clearAvatarFileCache(getCurrentUser().student_id)
		avatarURL.value = remoteURL
		return
	}
	avatarLoadFailed.value = true
}

async function changeAvatar(): Promise<void> {
	if (changingAvatar.value) return
	changingAvatar.value = true
	const currentStudentID = getCurrentUser().student_id
	let uploading = false
	try {
		const path = await chooseAvatarImage()
		if (path == '' || !pageActive || currentStudentID != getCurrentUser().student_id) return
		// 上传期间使旧的头像加载任务失效，避免覆盖新头像。
		avatarUpdateVersion++
		uploading = true
		uni.showLoading({ title: '正在上传…', mask: true })
		const remoteURL = await uploadAvatar(path)
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		avatarLoadFailed.value = false
		avatarURL.value = remoteURL
		const source = await cacheAvatarFile(currentStudentID, remoteURL)
		if (
			!pageActive ||
			currentStudentID != getCurrentUser().student_id ||
			remoteURL != getStoredAvatarURL()
		)
			return
		avatarLoadFailed.value = false
		avatarURL.value = source
		uni.hideLoading()
		uploading = false
		uni.showToast({ title: '头像更新成功', icon: 'success' })
	} catch (error) {
		if (uploading) {
			uni.hideLoading()
			uploading = false
		}
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		if (error instanceof AvatarUploadError) return
		const message = (error as Error).message
		if (message == '请先完善个人信息') {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		uni.showToast({
			title: message == null || message == '' ? '头像上传失败，请重试' : message,
			icon: 'none'
		})
	} finally {
		if (uploading) uni.hideLoading()
		changingAvatar.value = false
	}
}

function openAvatar() {
	if (changingAvatar.value || avatarMenuOpen.value) return
	avatarMenuOpen.value = true
	const currentStudentID = getCurrentUser().student_id
	uni.showActionSheet({
		itemList: ['查看头像', '更换头像'],
		success: (result) => {
			if (!pageActive || currentStudentID != getCurrentUser().student_id) return
			if (result.tapIndex == 1) {
				changeAvatar()
				return
			}
			if (result.tapIndex != 0) return
			const source = avatarLoadFailed.value ? getStoredAvatarURL() : avatarURL.value
			if (source == '') {
				uni.showToast({ title: '暂无可查看的头像', icon: 'none' })
				return
			}
			uni.previewImage({
				urls: [source],
				current: source,
				fail: (_) => {
					uni.showToast({ title: '头像预览失败，请重试', icon: 'none' })
				}
			})
		},
		complete: (_) => {
			avatarMenuOpen.value = false
		}
	})
}

function formatPhone(value: string): string {
	if (value.length != 11) return value
	return value.slice(0, 3) + ' ' + value.slice(3, 7) + ' ' + value.slice(7)
}

async function loadProfile() {
	const updateVersion = avatarUpdateVersion
	const studentID = getCurrentUser().student_id
	try {
		const data = await getProfile()
		if (!pageActive || studentID != getCurrentUser().student_id) return
		if (data == null) {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		profile.value = data
		// 复用“我的”页面的头像缓存，返回本页时也使用上传后的最新地址。
		const cachedURL = getStoredAvatarURL()
		const remoteURL = cachedURL == '' ? data.avatar_url : cachedURL
		const source = await cacheAvatarFile(studentID, remoteURL)
		if (
			!pageActive ||
			changingAvatar.value ||
			updateVersion != avatarUpdateVersion ||
			studentID != getCurrentUser().student_id ||
			remoteURL != getStoredAvatarURL()
		)
			return
		avatarLoadFailed.value = false
		avatarURL.value = source
	} catch (error) {
		if (!pageActive || studentID != getCurrentUser().student_id) return
		const message = (error as Error).message
		if (message == '请先完善个人信息') {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		uni.showToast({
			title: message == null || message == '' ? '个人资料加载失败' : message,
			icon: 'none'
		})
	}
}

onShow(() => {
	const source = getCachedAvatarSource(getCurrentUser().student_id, getStoredAvatarURL())
	if (source != avatarURL.value) {
		avatarLoadFailed.value = false
		avatarURL.value = source
	}
	loadProfile()
})
onUnload(() => {
	pageActive = false
})

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
@import '@/styles/ios-theme.scss';
.toolbar-edit {
	min-width: 44px;
	min-height: 44px;
	align-items: flex-end;
	justify-content: center;
}
.toolbar-edit-text {
	color: $ios-blue;
	font-size: 15px;
}
.avatar-section {
	box-sizing: border-box;
	align-items: center;
	padding: 12px 0 26px;
}
.avatar-frame {
	box-sizing: border-box;
	width: 88px;
	height: 88px;
	border-radius: 44px;
	background-color: #dedee6;
}
.profile-avatar {
	box-sizing: border-box;
	width: 88px;
	height: 88px;
	border-radius: 44px;
}
.avatar-placeholder {
	align-items: center;
	justify-content: center;

	background-color: #5265a2;

	border: 1px solid #8290bb;
}
.avatar-initial {
	font-size: 40px;

	color: #ffffff;
}
.profile-name {
	font-size: 28px;
	font-weight: 700;
	color: $ios-ink;
	margin-top: 16px;
}
.profile-class {
	font-size: 13px;
	line-height: 21px;
	color: $ios-secondary;
	margin-top: 6px;
	text-align: center;
}
.quick-actions {
	flex-direction: row;
	margin-bottom: 8px;
}
.quick-action {
	box-sizing: border-box;
	flex: 1;
	min-height: 66px;
	margin: 0 4px;
	border-radius: 16px;
	background-color: $ios-surface;
	align-items: center;
	justify-content: center;
}
.action-symbol {
	width: 24px;
	height: 24px;
}
.action-label {
	font-size: 12px;
	color: $ios-blue;
	margin-top: 4px;
}
.group-title {
	color: $ios-secondary;
	font-size: 12px;
	margin: 24px 14px 10px;
}
.info-card {
	box-sizing: border-box;
	border-radius: $ios-radius;
	background-color: $ios-surface;
	padding: 0 16px;
}
.info-row {
	box-sizing: border-box;
	min-height: 51px;
	flex-direction: row;
	align-items: center;
	border-bottom: 0.5px solid $ios-separator;
}
.info-label {
	margin-top: 14px;
	margin-bottom: 14px;
	width: 80px;
	flex-shrink: 0;
	color: $ios-ink;
	font-size: 14px;
}
.info-value {
	margin-top: 14px;
	margin-bottom: 14px;
	flex: 1;
	min-width: 0;
	margin-left: 12px;
	font-size: 14px;
	line-height: 21px;
	color: $ios-secondary;
	text-align: right;
}
.privacy-note {
	font-size: 11px;
	color: $ios-secondary;
	margin-top: 28px;
	text-align: center;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-toolbar-edit-text {
	color: $ios-dark-blue;
}
.dark-avatar-frame {
	background-color: $ios-dark-panel;
}
.dark-profile-name {
	color: $ios-dark-ink;
}
.dark-profile-class {
	color: $ios-dark-secondary;
}
.dark-quick-action {
	background-color: $ios-dark-surface;
}
.dark-action-label {
	color: $ios-dark-blue;
}
.dark-group-title {
	color: $ios-dark-secondary;
}
.dark-info-card {
	background-color: $ios-dark-surface;
}
.dark-info-row {
	border-bottom: 0.5px solid $ios-dark-separator;
}
.dark-info-label {
	color: $ios-dark-ink;
}
.dark-info-value {
	color: $ios-dark-secondary;
}
.dark-privacy-note {
	color: $ios-dark-secondary;
}
.contrast-profile-name {
	color: #ffffff;
}
.contrast-profile-class {
	color: #d2d3dc;
}
.contrast-group-title {
	color: #d2d3dc;
}
.contrast-info-row {
	border-bottom: 0.5px solid #737580;
}
.contrast-info-label {
	color: #ffffff;
}
.contrast-info-value {
	color: #d2d3dc;
}
.contrast-privacy-note {
	color: #d2d3dc;
}
</style>
