	position: relative;
	flex: 1;
	overflow: hidden;
	background-color: #f5f8ff;
}
.page-background {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	width: 100%;
	height: 100%;
}
