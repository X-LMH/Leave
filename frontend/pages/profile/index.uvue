<template>
	<PageTransition ref="pageTransition" enter-direction="peer">
		<view class="page">
			<image class="page-background" src="/static/my/index/background.png" mode="aspectFill"></image>
			<scroll-view class="content-scroll" scroll-y="true" :show-scrollbar="false">
				<view class="content">
					<view class="header">
						<text class="page-title">我的</text>
						<text class="page-subtitle">管理个人信息与请假记录</text>
					</view>
					<view class="profile-card" @click="openInfo">
						<image class="profile-avatar" src="/static/my/index/avatar.jpg" mode="aspectFill"></image>
						<view class="profile-details">
							<view class="profile-name-row">
								<text class="profile-name">{{ profileName == '' ? '未完善资料' : profileName }}</text>
								<image class="edit-icon" src="/static/my/index/icons/edit.png" mode="aspectFit" @click.stop="openEdit"></image>
							</view>
							<view class="profile-meta-row">
								<image class="profile-meta-icon" src="/static/my/index/icons/user-badge.png" mode="aspectFit"></image>
								<text class="profile-meta-text">学号：{{ studentID }}</text>
							</view>
							<view class="profile-meta-row profile-school-row">
								<image class="profile-meta-icon" src="/static/my/index/icons/school.png" mode="aspectFit"></image>
								<text class="profile-meta-text">{{ className == '' ? '请完善个人资料' : className }}</text>
							</view>
						</view>
						<image class="card-arrow" src="/static/my/index/icons/arrow-right.png" mode="aspectFit"></image>
					</view>
					<text class="section-title">我的服务</text>
					<view class="service-card">
						<view class="service-item" @click="openInfo">
							<image class="service-icon" src="/static/my/index/icons/user-avatar.png" mode="aspectFit"></image>
							<view class="service-copy">
								<text class="service-title">个人信息</text>
								<text class="service-description">查看与修改个人资料</text>
							</view>
							<image class="service-arrow" src="/static/my/index/icons/arrow-right.png" mode="aspectFit"></image>
						</view>
						<view class="service-divider">
						</view>
						<view class="service-item" @click="openRecords">
							<image class="service-icon" src="/static/my/index/icons/form-edit.png" mode="aspectFit"></image>
							<view class="service-copy">
								<text class="service-title">请假记录</text>
								<text class="service-description">查看我的请假申请记录</text>
							</view>
							<image class="service-arrow" src="/static/my/index/icons/arrow-right.png" mode="aspectFit"></image>
						</view>
						<view class="service-divider">
						</view>
						<view class="service-item" @click="openPassword">
							<image class="service-icon" src="/static/my/index/icons/lock.png" mode="aspectFit"></image>
							<view class="service-copy">
								<text class="service-title">修改密码</text>
								<text class="service-description">修改账户登录密码</text>
							</view>
							<image class="service-arrow" src="/static/my/index/icons/arrow-right.png" mode="aspectFit"></image>
						</view>
					</view>
					<view class="logout-card" @click="handleLogout">
						<image class="logout-icon" src="/static/my/index/icons/power.png" mode="aspectFit"></image>
						<text class="logout-text">退出登录</text>
						<text class="logout-arrow">›</text>
					</view>
					<view class="bottom-spacer">
					</view>
				</view>
			</scroll-view>
			<BottomNavigation active="profile" @navigate="handleTabNavigation" />
			</view>
		</PageTransition>
</template>

<script setup lang="uts">
import BottomNavigation from '@/components/BottomNavigation.uvue'
import PageTransition from '@/components/PageTransition.uvue'
import { ref } from 'vue'
import { getProfile, getStoredName, logout as clearSession, logoutRequest, ProfileData } from '@/utils/api.uts'

const profileName = ref(getStoredName())
const storedStudentID = uni.getStorageSync('leave_student_id')
const studentID = ref(typeof storedStudentID == 'string' ? storedStudentID : '')
const className = ref('')


function handleTabNavigation(url: string) {
	uni.reLaunch({ url: url })
}

function openInfo() {
	uni.navigateTo({ url: '/pages/profile/info' })
}

function openEdit() {
	uni.navigateTo({ url: '/pages/profile/edit' })
}

function openRecords() {
	uni.navigateTo({ url: '/pages/leave/records' })
}

function openPassword() {
	uni.navigateTo({ url: '/pages/profile/password' })
}

async function handleLogout() {
	try {
		await logoutRequest()
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '退出登录失败' : message, icon: 'none' })
	} finally {
		clearSession()
		uni.reLaunch({ url: '/pages/auth/login' })
	}
}

async function loadProfile() {
	try {
		const profile: ProfileData | null = await getProfile()
		if (profile == null) return
		profileName.value = profile.name
		studentID.value = profile.student_id
		className.value = profile.class_info.class_name
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '个人资料加载失败' : message, icon: 'none' })
	}
}

onShow(() => {
	loadProfile()
})
</script>

