<template>
	<view class="profile-entry"></view>
</template>

<script setup lang="uts">
// 保留旧路由入口；首页和我的现在由同一个常驻主页面承载。
onLoad(() => {
	uni.reLaunch({
		url: '/pages/home/index?tab=profile',
		fail: () => {
			uni.showToast({ title: '页面打开失败，请重试', icon: 'none' })
		}
	})
})
</script>

<style>
.profile-entry {
	flex: 1;
	background-color: #f5f5f7;
}
</style>
