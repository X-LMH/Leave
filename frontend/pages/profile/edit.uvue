<template>
	<ProfilePageShell
		:title="firstProfile ? '完善资料' : '编辑资料'"
		:subtitle="firstProfile ? '完善必填信息，即可开始请假。' : ''"
		:scrollable="true"
		:scroll-target="scrollTarget"
		:intercept-back="true"
		@back="requestLeave"
	>
		<view :class="themeClass('edit-content')">
			<AvatarPicker
				:avatar-url="avatarURL"
				:file-path="selectedPath"
				:initial="name"
				:disabled="pageLoading || submitting || avatarRetryPending"
				:compact="true"
				@select="selectAvatar"
				@busy="setChoosing"
				@preview-error="handleAvatarError"
			/>
			<text :class="themeClass('field-help')">学号 {{ studentID }} 不可修改。</text>
			<view
				v-if="pageLoading"
				:class="themeClass('load-panel')"
			>
				<text :class="themeClass('load-message')">正在加载资料…</text>
			</view>
			<view
				v-else-if="loadError != ''"
				:class="themeClass('load-panel')"
				@click="loadPage"
			>
				<text :class="themeClass('load-message')">{{ loadError }}</text>
				<text :class="themeClass('retry-text')">轻点重新加载</text>
			</view>
			<view
				v-else-if="!avatarRetryPending"
				:class="themeClass('form-card')"
			>
				<view
					id="edit-class"
					:class="themeClass(errorField == 'class' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">班级</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<ThemedPicker title="班级"
							:class="themeClass('field-picker')"
							:disabled="submitting"
							:range="classLabels"
							:value="pickerClassIndex"
							@change="classChange"
						>
							<view :class="themeClass('picker-box')">
								<text :class="themeClass(className == '' ? 'picker-placeholder' : 'picker-value')">
									{{ className == '' ? '请选择' : className }}
								</text>
								<image
									:class="themeClass('picker-arrow')"
									:src="themeImage('/static/ios/back-ink.svg')"
									mode="aspectFit"
								></image>
							</view>
						</ThemedPicker>
						<text
							v-if="errorField == 'class'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-name"
					:class="themeClass(errorField == 'name' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">姓名</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="name"
							:disabled="submitting"
							type="text"
							maxlength="20"
							:focus="focusedField == 'name'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'name'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-phone"
					:class="themeClass(errorField == 'phone' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">手机号</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="phone"
							:disabled="submitting"
							type="number"
							maxlength="11"
							:focus="focusedField == 'phone'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'phone'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-gender"
					:class="themeClass(errorField == 'gender' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">性别</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<ThemedPicker title="性别"
							:class="themeClass('field-picker')"
							:disabled="submitting"
							:range="genders"
							:value="gender == '女' ? 1 : 0"
							@change="genderChange"
						>
							<view :class="themeClass('picker-box')">
								<text :class="themeClass(gender == '' ? 'picker-placeholder' : 'picker-value')">
									{{ gender == '' ? '请选择' : gender }}
								</text>
								<image
									:class="themeClass('picker-arrow')"
									:src="themeImage('/static/ios/back-ink.svg')"
									mode="aspectFit"
								></image>
							</view>
						</ThemedPicker>
						<text
							v-if="errorField == 'gender'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-parentName"
					:class="themeClass(errorField == 'parentName' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">家长姓名</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="parentName"
							:disabled="submitting"
							type="text"
							maxlength="20"
							:focus="focusedField == 'parentName'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'parentName'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-parentPhone"
					:class="themeClass(errorField == 'parentPhone' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">家长电话</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="parentPhone"
							:disabled="submitting"
							type="number"
							maxlength="11"
							:focus="focusedField == 'parentPhone'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'parentPhone'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-apartment"
					:class="themeClass(errorField == 'apartment' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')"><text :class="themeClass('field-label')">公寓名称</text></view>
					<view :class="themeClass('field-box')">
						<ThemedPicker title="宿舍"
							:class="themeClass('field-picker')"
							:disabled="submitting || apartmentLoading || gender == ''"
							:range="apartmentLabels"
							:value="apartmentIndex"
							@change="apartmentChange"
						>
							<view :class="themeClass('picker-box')">
								<text :class="themeClass(apartment == '' ? 'picker-placeholder' : 'picker-value')">
									{{ apartment == '' ? '请选择' : apartment }}
								</text>
								<image
									:class="themeClass('picker-arrow')"
									:src="themeImage('/static/ios/back-ink.svg')"
									mode="aspectFit"
								></image>
							</view>
						</ThemedPicker>
						<text
							v-if="errorField == 'apartment'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-dormNumber"
					:class="themeClass(errorField == 'dormNumber' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')"><text :class="themeClass('field-label')">宿舍号</text></view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="dormNumber"
							:disabled="submitting"
							type="text"
							maxlength="20"
							:focus="focusedField == 'dormNumber'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'dormNumber'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
				<view
					id="edit-counselor"
					:class="themeClass(errorField == 'counselor' ? 'form-row form-row-invalid' : 'form-row')"
				>
					<view :class="themeClass('field-label-row')">
						<text :class="themeClass('field-label')">导员姓名</text>
						<text :class="themeClass('required')">*</text>
					</view>
					<view :class="themeClass('field-box')">
						<input
							:class="themeClass('field-input')"
							v-model="counselor"
							:disabled="submitting"
							type="text"
							maxlength="20"
							:focus="focusedField == 'counselor'"
							:cursor-spacing="24"
							@input="clearError"
						/>
						<text
							v-if="errorField == 'counselor'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
				</view>
			</view>
			<view
				v-if="avatarRetryPending"
				:class="themeClass('load-panel')"
			>
				<text :class="themeClass('load-message')">资料已保存，头像上传失败</text>
				<text :class="themeClass('field-help')">{{ avatarError }}</text>
				<view
					:class="themeClass('retry-action')"
					@click="retryAvatar"
				>
					<text :class="themeClass('retry-text')">{{ submitting ? '正在上传…' : '重试上传' }}</text>
				</view>
				<view
					:class="themeClass('retry-action')"
					@click="continueWithoutAvatar"
				>
					<text :class="themeClass('retry-text')">暂不上传，继续</text>
				</view>
			</view>
			<text
				v-else-if="errorField == '' && formError != ''"
				:class="themeClass('form-error')"
			>
				{{ formError }}
			</text>
			<view
				v-if="!avatarRetryPending && loadError == ''"
				:class="themeClass(submitting || pageLoading ? 'primary-button primary-button-disabled' : 'primary-button')"
				@click="save"
			>
				<text :class="themeClass('primary-button-text')">
					{{ submitting ? '正在保存…' : firstProfile ? '完成并进入首页' : '保存修改' }}
				</text>
			</view>
		</view>
	</ProfilePageShell>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { computed, nextTick, ref } from 'vue'
import ThemedPicker from '@/components/ThemedPicker.uvue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
import AvatarPicker from '@/components/AvatarPicker.uvue'
import {
	ApartmentOption,
	ClassOption,
	getApartments,
	getClassOptions,
	getCurrentUser,
	getProfile,
	getStoredAvatarURL,
	ProfileData,
	saveProfile,
	updateCurrentUser,
	uploadAvatar,
	AvatarUploadError,
	logout
} from '@/utils/api.uts'
import {
	cacheAvatarFile,
	clearAvatarFileCache,
	getCachedAvatarSource
} from '@/utils/avatar-cache.uts'

const errorField = ref('')
const formError = ref('')
const focusedField = ref('')
const scrollTarget = ref('')
const loadError = ref('')
const genders: string[] = ['男', '女']

function showFieldError(field: string, message: string) {
	errorField.value = field
	formError.value = message
	focusedField.value = ''
	scrollTarget.value = ''
	nextTick(() => {
		scrollTarget.value = 'edit-' + field
		focusedField.value = field
	})
}
function clearError() {
	errorField.value = ''
	formError.value = ''
}
const studentID = ref('')
const classOptions = ref<ClassOption[]>([])
const classIndex = ref(-1)
const name = ref('')
const phone = ref('')
const gender = ref('')
const parentName = ref('')
const parentPhone = ref('')
const apartmentOptions = ref<ApartmentOption[]>([])
const apartmentIndex = ref(-1)
const dormNumber = ref('')
const counselor = ref('')
const firstProfile = ref(false)
const submitting = ref(false)
const pageLoading = ref(true)
const apartmentLoading = ref(false)
const apartmentOptionsReady = ref(true)
let apartmentRequestSequence = 0
const avatarURL = ref(getCachedAvatarSource(getCurrentUser().student_id, getStoredAvatarURL()))
const selectedPath = ref('')
const choosing = ref(false)
const avatarRetryPending = ref(false)
const avatarError = ref('')
let pageActive = true
let initialForm = ''
let leaving = false
let confirmingLeave = false
function formSnapshot(): string {
	return JSON.stringify([
		name.value,
		phone.value,
		gender.value,
		parentName.value,
		parentPhone.value,
		dormNumber.value,
		counselor.value,
		classIndex.value.toString(),
		apartmentIndex.value.toString(),
		selectedPath.value
	])
}
function leavePage() {
	leaving = true
	if (firstProfile.value) {
		logout()
		uni.reLaunch({
			url: '/pages/auth/login',
			fail: () => {
				leaving = false
			}
		})
	} else {
		uni.navigateBack({
			fail: () => {
				leaving = false
			}
		})
	}
}
function requestLeave() {
	if (submitting.value || choosing.value || confirmingLeave) return
	if (pageLoading.value) {
		leavePage()
		return
	}
	if (formSnapshot() == initialForm && !avatarRetryPending.value) {
		leavePage()
		return
	}
	confirmingLeave = true
	uni.showModal({
		title: avatarRetryPending.value ? '暂不上传头像？' : '放弃修改？',
		content: avatarRetryPending.value
			? '个人资料已保存，离开后不会继续上传本次头像。'
			: '尚未保存的内容将不会保留。',
		confirmText: '离开',
		cancelText: '继续填写',
		success: (result) => {
			if (result.confirm) leavePage()
		},
		complete: () => {
			confirmingLeave = false
		}
	})
}
onBackPress((): boolean => {
	if (leaving) return false
	requestLeave()
	return true
})

function selectAvatar(path: string) {
	selectedPath.value = path
}
function setChoosing(value: boolean) {
	choosing.value = value
}

function handleAvatarError() {
	const remoteURL = getStoredAvatarURL()
	if (remoteURL == '' || avatarURL.value == remoteURL) return
	clearAvatarFileCache(getCurrentUser().student_id)
	avatarURL.value = remoteURL
}

function finishSave() {
	if (!pageActive) return
	leaving = true
	uni.showToast({ title: '保存成功', icon: 'success' })
	if (firstProfile.value) uni.reLaunch({ url: '/pages/home/index' })
	else uni.navigateBack({})
}

function continueWithoutAvatar() {
	if (submitting.value) return
	finishSave()
}

async function saveSelectedAvatar(): Promise<boolean> {
	try {
		avatarURL.value = await uploadAvatar(selectedPath.value)
		selectedPath.value = ''
		avatarRetryPending.value = false
		return true
	} catch (error) {
		if (!pageActive) return false
		if (error instanceof AvatarUploadError) return false
		const message = (error as Error).message
		avatarError.value = message == null || message == '' ? '请检查网络后重试' : message
		avatarRetryPending.value = true
		return false
	}
}

async function retryAvatar() {
	if (submitting.value || choosing.value) return
	submitting.value = true
	try {
		// 资料已保存，重试时只上传头像，避免重复提交个人资料。
		if (await saveSelectedAvatar()) finishSave()
	} finally {
		submitting.value = false
	}
}

function formatClass(item: ClassOption): string {
	return item.class_name + (item.is_enabled ? '' : '（已停用）')
}

const classLabels = computed((): string[] => classOptions.value.map((item) => formatClass(item)))
const apartmentLabels = computed((): string[] =>
	apartmentOptions.value.map((item) => item.name + (item.is_enabled ? '' : '（已停用）'))
)
const pickerClassIndex = computed((): number => (classIndex.value >= 0 ? classIndex.value : 0))
const className = computed((): string =>
	classIndex.value >= 0 && classIndex.value < classLabels.value.length
		? classLabels.value[classIndex.value]
		: ''
)
const apartment = computed((): string =>
	apartmentIndex.value >= 0 && apartmentIndex.value < apartmentLabels.value.length
		? apartmentLabels.value[apartmentIndex.value]
		: ''
)

function genderCode(): string {
	return gender.value == '男' ? 'male' : 'female'
}

async function loadApartments(selectedID: number = 0) {
	if (gender.value == '') return
	const sequence = ++apartmentRequestSequence
	apartmentLoading.value = true
	apartmentOptionsReady.value = false
	try {
		const options = await getApartments(genderCode())
		if (sequence != apartmentRequestSequence || !pageActive) return
		apartmentOptions.value = options
		const selectedIndex = apartmentOptions.value.findIndex(
			(item) => item.id.toString() == selectedID.toString()
		)
		// An existing assignment must never be replaced by a default option.
		if (selectedID != 0 && selectedIndex < 0) {
			uni.showToast({ title: '原公寓信息不可用，请重新加载资料', icon: 'none' })
			return
		}
		apartmentIndex.value =
			selectedIndex >= 0
				? selectedIndex
				: apartmentOptions.value.length == 1 && apartmentOptions.value[0].is_enabled
					? 0
					: -1
		apartmentOptionsReady.value = true
	} catch (error) {
		if (sequence != apartmentRequestSequence || !pageActive) return
		const message = (error as Error).message
		uni.showToast({
			title: message == null || message == '' ? '公寓列表加载失败' : message,
			icon: 'none'
		})
	} finally {
		if (sequence == apartmentRequestSequence) apartmentLoading.value = false
	}
}

function setGender(value: string) {
	if (pageLoading.value || submitting.value) return
	if (gender.value == value) return
	gender.value = value
	apartmentIndex.value = -1
	loadApartments()
}

function classChange(index: number) {
	if (index < 0 || index >= classOptions.value.length) return
	classIndex.value = index
}
function apartmentChange(index: number) {
	if (index < 0 || index >= apartmentOptions.value.length) return
	apartmentIndex.value = index
}

function genderChange(index: number) {
	if (index >= 0 && index < genders.length) setGender(genders[index])
}

function phoneIsValid(value: string): boolean {
	return /^1[3-9]\d{9}$/.test(value.trim())
}

async function fillProfile(profile: ProfileData) {
	const storedURL = getStoredAvatarURL()
	avatarURL.value = getCachedAvatarSource(
		profile.student_id,
		storedURL == '' ? profile.avatar_url : storedURL
	)
	studentID.value = profile.student_id
	name.value = profile.name
	phone.value = profile.phone
	gender.value = profile.gender == 'male' ? '男' : '女'
	parentName.value = profile.parent_name
	parentPhone.value = profile.parent_phone
	dormNumber.value = profile.apartment_info.dormitory_number
	counselor.value = profile.teacher_name
	classIndex.value = classOptions.value.findIndex(
		(item) => item.id.toString() == profile.class_id.toString()
	)
	await loadApartments(profile.apartment_id)
}

async function loadPage() {
	pageLoading.value = true
	loadError.value = ''
	const currentStudentID = getCurrentUser().student_id
	try {
		classOptions.value = await getClassOptions()
		const profile = await getProfile()
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		if (profile != null) {
			await fillProfile(profile)
			const storedURL = getStoredAvatarURL()
			const remoteURL = storedURL == '' ? profile.avatar_url : storedURL
			const source = await cacheAvatarFile(currentStudentID, remoteURL)
			if (
				pageActive &&
				currentStudentID == getCurrentUser().student_id &&
				remoteURL == getStoredAvatarURL()
			)
				avatarURL.value = source
			return
		}
		studentID.value = getCurrentUser().student_id
	} catch (error) {
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		const message = (error as Error).message
		if (firstProfile.value && message == '请先完善个人信息') return
		loadError.value = message == null || message == '' ? '个人资料加载失败' : message
		uni.showToast({
			title: message == null || message == '' ? '个人资料加载失败' : message,
			icon: 'none'
		})
	} finally {
		initialForm = formSnapshot()
		pageLoading.value = false
	}
}

async function save() {
	if (submitting.value || choosing.value || avatarRetryPending.value) return
	if (pageLoading.value || apartmentLoading.value) {
		uni.showToast({ title: '资料正在加载，请稍候', icon: 'none' })
		return
	}
	if (!apartmentOptionsReady.value) {
		uni.showToast({ title: '请先重新加载公寓信息', icon: 'none' })
		return
	}
	if (classIndex.value < 0) {
		showFieldError('class', '请选择班级')
		return
	}
	if (name.value.trim() == '') {
		showFieldError('name', '请填写姓名')
		return
	}
	if (!phoneIsValid(phone.value)) {
		showFieldError('phone', '请输入正确的 11 位手机号')
		return
	}
	if (gender.value == '') {
		showFieldError('gender', '请选择性别')
		return
	}
	if (parentName.value.trim() == '') {
		showFieldError('parentName', '请填写家长姓名')
		return
	}
	if (!phoneIsValid(parentPhone.value)) {
		showFieldError('parentPhone', '请输入正确的家长手机号')
		return
	}
	if (counselor.value.trim() == '') {
		showFieldError('counselor', '请填写导员姓名')
		return
	}
	clearError()
	uni.hideKeyboard()

	submitting.value = true
	try {
		await saveProfile({
			name: name.value.trim(),
			phone: phone.value.trim(),
			gender: genderCode(),
			parent_name: parentName.value.trim(),
			parent_phone: parentPhone.value.trim(),
			class_id: classOptions.value[classIndex.value].id,
			apartment_id: apartmentIndex.value >= 0 ? apartmentOptions.value[apartmentIndex.value].id : 0,
			dormitory_number: dormNumber.value.trim(),
			teacher_name: counselor.value.trim()
		})
		if (!pageActive) return
		const currentUser = getCurrentUser()
		updateCurrentUser({
			role: currentUser.role,
			student_id: currentUser.student_id,
			name: name.value.trim(),
			class_name: classOptions.value[classIndex.value].class_name
		})
		if (selectedPath.value != '' && !(await saveSelectedAvatar())) return
		finishSave()
	} catch (error) {
		const message = (error as Error).message
		formError.value = message == null || message == '' ? '保存失败，请重试' : message
		uni.showToast({ title: message == null || message == '' ? '保存失败' : message, icon: 'none' })
	} finally {
		submitting.value = false
	}
}

onLoad((options) => {
	firstProfile.value = options?.first == '1'
	studentID.value = getCurrentUser().student_id
	loadPage()
})

onUnload(() => {
	pageActive = false
})

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>
