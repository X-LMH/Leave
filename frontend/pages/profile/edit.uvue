<template>
	<ProfilePageShell title="修改个人信息" subtitle="修改您的个人信息" :scrollable="true">
		<view class="form-card">
			<view class="form-row"><text class="field-label">学号</text><view class="field-box field-disabled"><text class="disabled-text">2023123456</text></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">姓名</text><text class="required">*</text></view><view class="field-box"><input class="field-input" v-model="name" maxlength="20" /></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">手机号</text><text class="required">*</text></view><view class="field-box"><input class="field-input" v-model="phone" type="number" maxlength="11" /></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">性别</text><text class="required">*</text></view><view class="gender-group"><view :class="gender == '男' ? 'gender-item gender-active' : 'gender-item'" @click="setGender('男')"><text :class="gender == '男' ? 'gender-text gender-text-active' : 'gender-text'">男</text></view><view :class="gender == '女' ? 'gender-item gender-active' : 'gender-item'" @click="setGender('女')"><text :class="gender == '女' ? 'gender-text gender-text-active' : 'gender-text'">女</text></view></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">家长姓名</text><text class="required">*</text></view><view class="field-box"><input class="field-input" v-model="parentName" maxlength="20" /></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">家长电话</text><text class="required">*</text></view><view class="field-box"><input class="field-input" v-model="parentPhone" type="number" maxlength="11" /></view></view>
			<view class="form-row"><view class="required-label"><text class="required-field-label">公寓名称</text><text class="required">*</text></view><view class="field-box"><input class="field-input" v-model="apartment" maxlength="30" /></view></view>
			<view class="form-row"><text class="field-label">辅导员姓名</text><view class="field-box"><input class="field-input" v-model="counselor" maxlength="20" /></view></view>
		</view>
		<view class="primary-button" @click="save"><text class="primary-button-text">保存修改</text></view>
	</ProfilePageShell>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
const name = ref('刘明慧')
const phone = ref('13800138888')
const gender = ref('女')
const parentName = ref('刘女士')
const parentPhone = ref('13966778899')
const apartment = ref('北苑3号公寓')
const counselor = ref('王老师')
function setGender(value: string) { gender.value = value }
function save() {
	if (name.value.trim() == '' || phone.value.trim() == '' || parentName.value.trim() == '' || parentPhone.value.trim() == '' || apartment.value.trim() == '') {
		uni.showToast({ title: '请完整填写必填信息', icon: 'none' })
		return
	}
	uni.showToast({ title: '保存成功', icon: 'success' })
}
</script>

<style>
.form-card { margin-top: 38rpx; padding: 22rpx 26rpx; border-radius: 30rpx; background-color: rgba(255,255,255,0.88); box-shadow: 0 14rpx 34rpx rgba(92,126,190,0.11); }
.form-row { min-height: 104rpx; flex-direction: row; align-items: center; }
.required-label { width: 148rpx; flex-direction: row; align-items: center; }
.field-label { width: 148rpx; color: #123b78; font-size: 25rpx; font-weight: 600; }
.required-field-label { color: #123b78; font-size: 25rpx; font-weight: 600; }
.required { margin-left: 8rpx; color: #f04f48; font-size: 26rpx; }
.field-box { flex: 1; height: 68rpx; padding: 0 22rpx; border-width: 1rpx; border-style: solid; border-color: #d9e2f4; border-radius: 16rpx; justify-content: center; background-color: rgba(255,255,255,0.55); }
.field-disabled { background-color: rgba(236,240,248,0.75); }
.disabled-text { color: #9aabd0; font-size: 25rpx; }
.field-input { height: 66rpx; color: #506d9f; font-size: 25rpx; }
.gender-group { flex: 1; height: 68rpx; flex-direction: row; }
.gender-item { flex: 1; border-width: 1rpx; border-style: solid; border-color: #d9e2f4; border-radius: 16rpx; justify-content: center; align-items: center; }
.gender-active { border-color: #4676ff; background-color: rgba(235,241,255,0.6); }
.gender-text { color: #536d9e; font-size: 25rpx; }
.gender-text-active { color: #245cf0; }
.primary-button { height: 94rpx; margin: 48rpx 14rpx 20rpx; border-radius: 47rpx; background-color: #527df3; justify-content: center; align-items: center; box-shadow: 0 12rpx 26rpx rgba(65,102,224,0.25); }
.primary-button-text { color: #ffffff; font-size: 29rpx; font-weight: 500; }
</style>
