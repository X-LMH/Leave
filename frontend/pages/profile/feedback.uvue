<template>
	<ProfilePageShell
		title="反馈与建议"
		subtitle=""
		:scrollable="true"
		:scroll-target="scrollTarget"
	>
		<view :class="themeClass('field-label-row')">
			<text :class="themeClass('feedback-label')">反馈内容</text>
			<text :class="themeClass('required')">*</text>
		</view>
		<view
			id="feedback-content"
			:class="themeClass(formError != '' && content.trim() == '' ? 'content-box content-box-invalid' : 'content-box')"
		>
			<textarea
				:class="themeClass('content-input')"
				v-model="content"
				:disabled="submitting"
				:focus="contentFocused"
				:cursor-spacing="24"
				maxlength="500"
				placeholder="请描述问题或建议"
				:placeholder-class="themeClass('input-placeholder')"
				@input="clearError"
			/>
			<text :class="themeClass('word-count')">{{ content.length }}/500</text>
		</view>
		<text
			v-if="formError != ''"
			:class="themeClass('form-error')"
		>
			{{ formError }}
		</text>
		<view :class="themeClass('section-heading')">
			<text :class="themeClass('section-title')">附件图片</text>
			<text :class="themeClass('section-note')">选填 · 最多 3 张</text>
		</view>
		<view :class="themeClass('attachment-list')">
			<view
				v-for="(path, index) in imagePaths"
				:key="path"
				:class="themeClass('attachment-item')"
			>
				<image
					:class="themeClass('attachment-preview')"
					:src="themeImage(path)"
					mode="aspectFill"
					@click="previewImage(index)"
				></image>
				<view
					v-if="!submitting"
					:class="themeClass('attachment-remove')"
					role="button"
					aria-label="删除图片"
					@click="removeImage(index)"
				>
					<image
						:class="themeClass('remove-icon')"
						:src="themeImage('/static/ios/close-white.svg')"
						mode="aspectFit"
					></image>
				</view>
			</view>
			<view
				v-if="imagePaths.length < 3"
				:class="themeClass('attachment-add')"
				role="button"
				aria-label="添加图片"
				@click="addImage"
			>
				<image
					:class="themeClass('add-icon')"
					:src="themeImage('/static/ios/plus-blue.svg')"
					mode="aspectFit"
				></image>
				<text :class="themeClass('add-label')">{{ choosing ? '读取中…' : '添加图片' }}</text>
			</view>
		</view>
		<view
			:class="themeClass('anonymous-card')"
			role="switch"
			:aria-checked="isAnonymous"
			aria-label="匿名提交"
			@click="toggleAnonymous"
		>
			<view :class="themeClass('anonymous-copy')">
				<text :class="themeClass('anonymous-title')">匿名提交</text>
				<text :class="themeClass('anonymous-detail')">不展示个人身份信息</text>
			</view>
			<view :class="themeClass(isAnonymous ? 'toggle toggle-active' : 'toggle')">
				<view :class="themeClass(isAnonymous ? 'toggle-dot toggle-dot-active' : 'toggle-dot')"></view>
			</view>
		</view>
		<view
			:class="themeClass(submitting || choosing ? 'primary-button primary-button-disabled' : 'primary-button')"
			@click="submit"
		>
			<text :class="themeClass('primary-button-text')">{{ submitting ? '提交中…' : '提交反馈' }}</text>
		</view>
	</ProfilePageShell>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { nextTick, ref } from 'vue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
import { submitFeedback } from '@/utils/api.uts'
import { chooseUploadImages } from '@/utils/avatar-picker.uts'

const formError = ref('')
const contentFocused = ref(false)
const scrollTarget = ref('')
function clearError() {
	formError.value = ''
}
const content = ref('')
const isAnonymous = ref(false)
const submitting = ref(false)
const choosing = ref(false)
const imagePaths = ref<string[]>([])

async function addImage() {
	if (submitting.value || choosing.value || imagePaths.value.length >= 3) return
	choosing.value = true
	try {
		const paths = await chooseUploadImages('图片', 3 - imagePaths.value.length)
		for (let index = 0; index < paths.length; index++) {
			const path = paths[index]
			if (imagePaths.value.length < 3 && !imagePaths.value.includes(path))
				imagePaths.value.push(path)
		}
	} finally {
		choosing.value = false
	}
}
function removeImage(index: number) {
	if (submitting.value || choosing.value) return
	imagePaths.value.splice(index, 1)
}
function previewImage(index: number) {
	if (submitting.value) return
	uni.previewImage({ urls: imagePaths.value, current: index })
}

function toggleAnonymous() {
	if (submitting.value) return
	isAnonymous.value = !isAnonymous.value
}

async function submit() {
	if (submitting.value || choosing.value) return

	const normalizedContent = content.value.trim()
	if (normalizedContent == '') {
		formError.value = '请填写反馈内容'
		contentFocused.value = false
		scrollTarget.value = ''
		nextTick(() => {
			contentFocused.value = true
			scrollTarget.value = 'feedback-content'
		})
		return
	}

	formError.value = ''
	uni.hideKeyboard()
	submitting.value = true
	let submitted = false
	try {
		await submitFeedback(normalizedContent, isAnonymous.value, imagePaths.value)
		submitted = true
		uni.showToast({ title: '提交成功', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack({})
		}, 1200)
	} catch (error) {
		const message = (error as Error).message
		formError.value = message == null || message == '' ? '反馈提交失败，请重试' : message
		uni.showToast({
			title: message == null || message == '' ? '反馈提交失败' : message,
			icon: 'none'
		})
	} finally {
		if (!submitted) {
			submitting.value = false
		}
	}
}

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>
<style lang="scss">
@import '@/styles/ios-controls.scss';
