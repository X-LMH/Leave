<template>
	<ProfilePageShell title="用户反馈" subtitle="你的建议将帮助我们持续改进" :scrollable="true" :logout-on-back="false">
		<view class="feedback-form">
			<view class="feedback-card">
				<view class="field-header">
					<text class="field-title">反馈内容</text>
					<text class="required">*</text>
				</view>
				<view class="content-box">
					<textarea class="content-input" :disabled="submitting" v-model="content" maxlength="500" placeholder="请描述你遇到的问题或建议" placeholder-class="content-placeholder" />
					<text class="word-count">{{ content.length }}/500</text>
				</view>
			</view>

			<view class="feedback-card attachment-card">
				<view class="field-header">
					<text class="field-title">附件图片（选填）</text>
					<text class="attachment-count">{{ imagePaths.length }}/3</text>
				</view>
				<view class="attachment-list">
					<view v-for="(path, index) in imagePaths" :key="path" class="attachment-item">
						<image class="attachment-preview" :src="path" mode="aspectFill" @click="previewImage(index)" />
						<view v-if="!submitting" class="attachment-remove" @click="removeImage(index)"><text class="attachment-remove-text">×</text></view>
					</view>
					<view v-if="imagePaths.length < 3" class="attachment-add" @click="addImage">
						<text class="attachment-add-text">{{ choosing ? '读取中…' : '+ 添加图片' }}</text>
					</view>
				</view>
			</view>

			<view class="feedback-card anonymous-card" @click="toggleAnonymous">
				<view class="anonymous-copy">
					<text class="field-title">匿名提交</text>
				</view>
				<view :class="isAnonymous ? 'toggle toggle-active' : 'toggle'">
					<view :class="isAnonymous ? 'toggle-dot toggle-dot-active' : 'toggle-dot'"></view>
				</view>
			</view>

			<view :class="submitting ? 'submit-button submit-button-disabled' : 'submit-button'" @click="submit">
				<text class="submit-text">{{ submitting ? '提交中…' : '提交反馈' }}</text>
			</view>
		</view>
	</ProfilePageShell>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
import { submitFeedback } from '@/utils/api.uts'
import { chooseUploadImages } from '@/utils/avatar-picker.uts'

const content = ref('')
const isAnonymous = ref(false)
const submitting = ref(false)
const choosing = ref(false)
const imagePaths = ref<string[]>([])

async function addImage() {
	if (submitting.value || choosing.value || imagePaths.value.length >= 3) return
	choosing.value = true
	try {
		const paths = await chooseUploadImages('图片', 3 - imagePaths.value.length)
		for (let index = 0; index < paths.length; index++) {
			const path = paths[index]
			if (imagePaths.value.length < 3 && !imagePaths.value.includes(path)) imagePaths.value.push(path)
		}
	} finally {
		choosing.value = false
	}
}
function removeImage(index: number) {
	if (submitting.value || choosing.value) return
	imagePaths.value.splice(index, 1)
}
function previewImage(index: number) {
	if (submitting.value) return
	uni.previewImage({ urls: imagePaths.value, current: index })
}

function toggleAnonymous() {
	if (submitting.value) return
	isAnonymous.value = !isAnonymous.value
}

async function submit() {
	if (submitting.value || choosing.value) return

	const normalizedContent = content.value.trim()
	if (normalizedContent == '') {
		uni.showToast({ title: '请填写反馈内容', icon: 'none' })
		return
	}

	submitting.value = true
	let submitted = false
	try {
		await submitFeedback(normalizedContent, isAnonymous.value, imagePaths.value)
		submitted = true
		uni.showToast({ title: '提交成功', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack({})
		}, 1200)
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '反馈提交失败' : message, icon: 'none' })
	} finally {
		if (!submitted) {
			submitting.value = false
		}
	}
}
</script>

<style>
.feedback-form {
	margin: 88rpx 20rpx 0;
}
.feedback-card {
	padding: 34rpx 32rpx;
	border-radius: 30rpx;
	background-color: rgba(255, 255, 255, 0.9);
	box-shadow: none;
}
.field-header {
	flex-direction: row;
	align-items: center;
}
.field-title {
	color: #123b78;
	font-size: 30rpx;
	font-weight: 700;
	line-height: 42rpx;
}
.required {
	margin-left: 12rpx;
	color: #f04f48;
	font-size: 28rpx;
	line-height: 42rpx;
}
.content-box {
	position: relative;
	height: 332rpx;
	margin-top: 24rpx;
	padding: 22rpx 24rpx 54rpx;
	border-radius: 20rpx;
	background-color: rgba(248, 250, 255, 0.86);
}
.content-input {
	width: 100%;
	height: 252rpx;
	color: #405f98;
	font-size: 27rpx;
	line-height: 42rpx;
}
.content-placeholder {
	color: #8ea2ca;
}
.word-count {
	position: absolute;
	right: 24rpx;
	bottom: 18rpx;
	color: #8297c0;
	font-size: 22rpx;
	line-height: 32rpx;
}
.attachment-card {
	margin-top: 30rpx;
}
.attachment-count {
	margin-left: 16rpx;
	font-size: 24rpx;
	color: #7890bc;
}
.attachment-list {
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 24rpx;
}
.attachment-item {
	position: relative;
	width: 164rpx;
	height: 164rpx;
	margin-right: 16rpx;
	margin-bottom: 16rpx;
}
.attachment-preview {
	width: 164rpx;
	height: 164rpx;
	border-radius: 16rpx;
}
.attachment-remove {
	position: absolute;
	right: 0;
	top: 0;
	width: 44rpx;
	height: 44rpx;
	border-radius: 22rpx;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0.6);
}
.attachment-remove-text {
	font-size: 32rpx;
	color: #ffffff;
}
.attachment-add {
	width: 164rpx;
	height: 164rpx;
	border-radius: 16rpx;
	background-color: #edf2ff;
	align-items: center;
	justify-content: center;
}
.attachment-add-text {
	color: #245cf0;
	font-size: 24rpx;
}
.anonymous-card {
	margin-top: 30rpx;
	flex-direction: row;
	align-items: center;
}
.anonymous-copy {
	flex: 1;
	min-width: 0;
}
.toggle {
	width: 88rpx;
	height: 52rpx;
	margin-left: 24rpx;
	padding: 5rpx;
	border-radius: 30rpx;
	background-color: #c5d2eb;
	transition-property: background-color;
	transition-duration: 180ms;
	transition-timing-function: ease-out;
}
.toggle-active {
	background-color: #527df3;
}
.toggle-dot {
	width: 42rpx;
	height: 42rpx;
	border-radius: 22rpx;
	background-color: #ffffff;
	box-shadow: 0 3rpx 8rpx rgba(68, 95, 148, 0.2);
	transform: translateX(0);
	transition-property: transform;
	transition-duration: 180ms;
	transition-timing-function: ease-out;
}
.toggle-dot-active {
	transform: translateX(36rpx);
}
.submit-button {
	height: 104rpx;
	margin-top: 72rpx;
	border-radius: 52rpx;
	background-color: #527df3;
	justify-content: center;
	align-items: center;
	box-shadow: none;
}
.submit-button-disabled {
	background-color: #9aaee3;
	box-shadow: none;
}
.submit-text {
	color: #ffffff;
	font-size: 30rpx;
	font-weight: 500;
}
</style>
