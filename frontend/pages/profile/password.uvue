<template>
	<ProfilePageShell title="修改密码" subtitle="为了您的账号安全，请设置新密码" :scrollable="true">
		<view class="password-form">
			<view class="password-field">
				<view class="label-row"><text class="password-label">旧密码</text><text class="required">*</text></view>
				<view class="input-card">
					<image class="lock-icon" src="/static/my/password/lock.png" mode="aspectFit"></image>
					<input class="password-input" v-model="oldPassword" :password="!showOld" maxlength="30" placeholder="请输入当前密码" placeholder-class="input-placeholder" />
					<image class="eye-icon" src="/static/my/password/lock_2.png" mode="aspectFit" @click="toggleOld"></image>
				</view>
			</view>
			<view class="password-field next-field">
				<view class="label-row"><text class="password-label">新密码</text><text class="required">*</text></view>
				<view class="input-card">
					<image class="lock-icon" src="/static/my/password/lock.png" mode="aspectFit"></image>
					<input class="password-input" v-model="newPassword" :password="!showNew" maxlength="30" placeholder="请输入新密码" placeholder-class="input-placeholder" />
					<image class="eye-icon" src="/static/my/password/lock_2.png" mode="aspectFit" @click="toggleNew"></image>
				</view>
				<text class="password-hint">密码长度不少于6位，建议包含字母和数字</text>
			</view>
			<view class="password-field next-field">
				<view class="label-row"><text class="password-label">确认新密码</text><text class="required">*</text></view>
				<view class="input-card">
					<image class="lock-icon" src="/static/my/password/lock.png" mode="aspectFit"></image>
					<input class="password-input" v-model="confirmPassword" :password="!showConfirm" maxlength="30" placeholder="请再次输入新密码" placeholder-class="input-placeholder" />
					<image class="eye-icon" src="/static/my/password/lock_2.png" mode="aspectFit" @click="toggleConfirm"></image>
				</view>
			</view>
			<view class="primary-button" @click="submit"><text class="primary-button-text">确认修改</text></view>
		</view>
	</ProfilePageShell>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
const oldPassword = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const showOld = ref(false)
const showNew = ref(false)
const showConfirm = ref(false)
function toggleOld() { showOld.value = !showOld.value }
function toggleNew() { showNew.value = !showNew.value }
function toggleConfirm() { showConfirm.value = !showConfirm.value }
function submit() {
	if (oldPassword.value == '' || newPassword.value == '' || confirmPassword.value == '') {
		uni.showToast({ title: '请完整填写密码信息', icon: 'none' })
		return
	}
	if (newPassword.value.length < 6) {
		uni.showToast({ title: '新密码不能少于6位', icon: 'none' })
		return
	}
	if (newPassword.value != confirmPassword.value) {
		uni.showToast({ title: '两次输入的新密码不一致', icon: 'none' })
		return
	}
	uni.showToast({ title: '修改成功', icon: 'success' })
}
</script>

<style>
.password-form { margin: 92rpx 20rpx 0; }
.password-field { width: 100%; }
.next-field { margin-top: 58rpx; }
.label-row { margin-left: 6rpx; flex-direction: row; align-items: center; }
.password-label { color: #123b78; font-size: 30rpx; font-weight: 700; line-height: 42rpx; }
.required { margin-left: 14rpx; color: #f04f48; font-size: 28rpx; }
.input-card { height: 108rpx; margin-top: 20rpx; padding: 0 30rpx; border-radius: 24rpx; background-color: rgba(255,255,255,0.82); box-shadow: 0 12rpx 30rpx rgba(90,123,185,0.12); flex-direction: row; align-items: center; }
.lock-icon { width: 44rpx; height: 44rpx; }
.password-input { flex: 1; height: 88rpx; margin-left: 28rpx; color: #405f98; font-size: 27rpx; }
.input-placeholder { color: #8ea2ca; }
.eye-icon { width: 44rpx; height: 44rpx; margin-left: 16rpx; opacity: 0.85; }
.password-hint { margin-top: 20rpx; margin-left: 8rpx; color: #7890bc; font-size: 23rpx; line-height: 34rpx; }
.primary-button { height: 104rpx; margin-top: 72rpx; border-radius: 52rpx; background-color: #527df3; justify-content: center; align-items: center; box-shadow: 0 14rpx 30rpx rgba(65,102,224,0.27); }
.primary-button-text { color: #ffffff; font-size: 30rpx; font-weight: 500; }
</style>
