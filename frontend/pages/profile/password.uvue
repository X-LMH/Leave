<template>
	<ProfilePageShell
		title="修改密码"
		subtitle=""
		:scrollable="true"
		:scroll-target="scrollTarget"
	>
		<view :class="themeClass('utility-intro')">
			<view :class="themeClass('utility-mark')">
				<image
					:class="themeClass('utility-icon')"
					:src="themeImage('/static/ios/lock-blue.svg')"
					mode="aspectFit"
				></image>
			</view>
			<text :class="themeClass('utility-title')">为账号设置新密码</text>
			<text :class="themeClass('utility-description')">修改后需要重新登录。</text>
		</view>
		<view :class="themeClass('password-card')">
			<view
				id="password-old"
				:class="themeClass(errorField == 'old' ? 'password-row password-row-invalid' : 'password-row')"
			>
				<text :class="themeClass('password-label')">旧密码</text>
				<view :class="themeClass('input-line')">
					<input
						:class="themeClass('password-input')"
						v-model="oldPassword"
						:disabled="submitting"
						:password="!showOld"
						:focus="focusedField == 'old'"
						:cursor-spacing="24"
						maxlength="30"
						placeholder="输入当前密码"
						:placeholder-class="themeClass('input-placeholder')"
						@input="clearError"
						@confirm="submit"
					/>
					<view
						:class="themeClass('eye-button')"
						role="button"
						aria-label="显示或隐藏密码"
						@click="toggleOld"
					>
						<image
							:class="themeClass('eye-icon')"
							:src="themeImage('/static/ios/eye-secondary.svg')"
							mode="aspectFit"
						></image>
						<view
							v-if="showOld"
							:class="themeClass('eye-slash')"
						></view>
					</view>
				</view>
				<text
					v-if="errorField == 'old'"
					:class="themeClass('field-error')"
				>
					{{ formError }}
				</text>
			</view>
			<view
				id="password-new"
				:class="themeClass(errorField == 'new' ? 'password-row password-row-invalid' : 'password-row')"
			>
				<text :class="themeClass('password-label')">新密码</text>
				<view :class="themeClass('input-line')">
					<input
						:class="themeClass('password-input')"
						v-model="newPassword"
						:disabled="submitting"
						:password="!showNew"
						:focus="focusedField == 'new'"
						:cursor-spacing="24"
						maxlength="30"
						placeholder="6–30 位新密码"
						:placeholder-class="themeClass('input-placeholder')"
						@input="clearError"
						@confirm="submit"
					/>
					<view
						:class="themeClass('eye-button')"
						role="button"
						aria-label="显示或隐藏密码"
						@click="toggleNew"
					>
						<image
							:class="themeClass('eye-icon')"
							:src="themeImage('/static/ios/eye-secondary.svg')"
							mode="aspectFit"
						></image>
						<view
							v-if="showNew"
							:class="themeClass('eye-slash')"
						></view>
					</view>
				</view>
				<text
					v-if="errorField == 'new'"
					:class="themeClass('field-error')"
				>
					{{ formError }}
				</text>
			</view>
			<view
				id="password-confirm"
				:class="themeClass(errorField == 'confirm' ? 'password-row password-row-invalid' : 'password-row')"
			>
				<text :class="themeClass('password-label')">确认新密码</text>
				<view :class="themeClass('input-line')">
					<input
						:class="themeClass('password-input')"
						v-model="confirmPassword"
						:disabled="submitting"
						:password="!showConfirm"
						:focus="focusedField == 'confirm'"
						:cursor-spacing="24"
						maxlength="30"
						placeholder="再次输入新密码"
						:placeholder-class="themeClass('input-placeholder')"
						@input="clearError"
						@confirm="submit"
					/>
					<view
						:class="themeClass('eye-button')"
						role="button"
						aria-label="显示或隐藏密码"
						@click="toggleConfirm"
					>
						<image
							:class="themeClass('eye-icon')"
							:src="themeImage('/static/ios/eye-secondary.svg')"
							mode="aspectFit"
						></image>
						<view
							v-if="showConfirm"
							:class="themeClass('eye-slash')"
						></view>
					</view>
				</view>
				<text
					v-if="errorField == 'confirm'"
					:class="themeClass('field-error')"
				>
					{{ formError }}
				</text>
			</view>
		</view>
		<text :class="themeClass('field-help')">新密码不少于 6 位，最多 30 位。</text>
		<text
			v-if="errorField == '' && formError != ''"
			:class="themeClass('form-error')"
		>
			{{ formError }}
		</text>
		<view
			:class="themeClass(submitting ? 'primary-button primary-button-disabled' : 'primary-button')"
			@click="submit"
		>
			<text :class="themeClass('primary-button-text')">{{ submitting ? '修改中…' : '确认修改' }}</text>
		</view>
	</ProfilePageShell>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { nextTick, ref } from 'vue'
import ProfilePageShell from '@/components/ProfilePageShell.uvue'
import { changePassword, getCurrentUser, logout } from '@/utils/api.uts'
const formError = ref('')
const errorField = ref('')
const focusedField = ref('')
const scrollTarget = ref('')
function showFieldError(field: string, message: string) {
	formError.value = message
	errorField.value = field
	focusedField.value = ''
	scrollTarget.value = ''
	nextTick(() => {
		focusedField.value = field
		scrollTarget.value = 'password-' + field
	})
}
function clearError() {
	formError.value = ''
	errorField.value = ''
}
const oldPassword = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const showOld = ref(false)
const showNew = ref(false)
const showConfirm = ref(false)
const submitting = ref(false)
function toggleOld() {
	if (submitting.value) return
	showOld.value = !showOld.value
}
function toggleNew() {
	if (submitting.value) return
	showNew.value = !showNew.value
}
function toggleConfirm() {
	if (submitting.value) return
	showConfirm.value = !showConfirm.value
}
function isBlank(value: string): boolean {
	return value.trim().length == 0
}
async function submit() {
	if (submitting.value) return
	if (isBlank(oldPassword.value)) {
		showFieldError('old', '请输入当前密码')
		return
	}
	if (isBlank(newPassword.value)) {
		showFieldError('new', '请输入新密码')
		return
	}
	if (newPassword.value.length < 6) {
		showFieldError('new', '新密码不能少于6位')
		return
	}
	if (isBlank(confirmPassword.value)) {
		showFieldError('confirm', '请再次输入新密码')
		return
	}
	if (newPassword.value != confirmPassword.value) {
		showFieldError('confirm', '两次输入的新密码不一致')
		return
	}
	clearError()
	const submittedOldPassword = oldPassword.value
	const submittedNewPassword = newPassword.value
	const submittedConfirmPassword = confirmPassword.value
	uni.hideKeyboard()
	submitting.value = true
	try {
		await changePassword(submittedOldPassword, submittedNewPassword, submittedConfirmPassword)
		oldPassword.value = ''
		newPassword.value = ''
		confirmPassword.value = ''
		showOld.value = false
		showNew.value = false
		showConfirm.value = false
		const studentID = getCurrentUser().student_id
		logout()
		uni.reLaunch({
			url: '/pages/auth/login?password_changed=1&student_id=' + encodeURIComponent(studentID)
		})
	} catch (error) {
		const message = (error as Error).message
		formError.value = message == null || message == '' ? '修改密码失败，请重试' : message
		uni.showToast({
			title: message == null || message == '' ? '修改密码失败' : message,
			icon: 'none'
		})
	} finally {
		submitting.value = false
	}
}

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>
<style lang="scss">
@import '@/styles/ios-controls.scss';
.password-card {
	box-sizing: border-box;
	padding: 0 16px;
	border-radius: 23px;
	background-color: $ios-surface;
}
.password-row {
	box-sizing: border-box;
	padding: 16px 0 7px;
	border-bottom: 0.5px solid $ios-separator;
}
.password-row-invalid {
	border-bottom-color: $ios-red;
}
.password-label {
	color: $ios-secondary;
	font-size: 13px;
}
.input-line {
	flex-direction: row;
	align-items: center;
	margin-top: 3px;
}
.password-input {
	flex: 1;
	min-width: 0;
	height: 48px;
	color: $ios-ink;
	font-size: 16px;
}
.input-placeholder {
	color: #767b85;
}
.eye-button {
	width: 44px;
	height: 44px;
	margin-right: -9px;
	align-items: center;
	justify-content: center;
}
.eye-icon {
	width: 20px;
	height: 20px;
}
.eye-slash {
	position: absolute;
	width: 22px;
	height: 1px;
	background-color: $ios-secondary;
	transform: rotate(45deg);
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-password-card {
	background-color: $ios-dark-surface;
}
.dark-password-row {
	border-bottom: 0.5px solid $ios-dark-separator;
}
.dark-password-row-invalid {
	border-bottom-color: $ios-dark-red;
}
.dark-password-label {
	color: $ios-dark-secondary;
}
.dark-password-input {
	color: $ios-dark-ink;
}
.dark-input-placeholder {
	color: $ios-dark-muted;
}
.dark-eye-slash {
	background-color: $ios-dark-secondary;
}
.contrast-password-row {
	border-bottom: 0.5px solid #737580;
}
.contrast-password-label {
	color: #d2d3dc;
}
.contrast-password-input {
	color: #ffffff;
}
.contrast-input-placeholder {
	color: #d2d3dc;
}
</style>
