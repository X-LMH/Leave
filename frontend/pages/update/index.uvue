<template>
	<view :class="themeClass('update-page')">
		<view :class="themeClass('update-safe-top')"></view>
		<view :class="themeClass('update-content')">
			<scroll-view
				id="update-scroll"
				:class="themeClass('update-scroll')"
				scroll-y="true"
				:show-scrollbar="false"
				><view
					:class="themeClass('update-main')"
					:style="{ minHeight: updateMainHeight + 'px' }"
				>
					<view :class="themeClass('update-heading')">
						<image
							:class="themeClass('update-illustration')"
							:src="themeImage('/static/update/version-update.svg')"
							mode="aspectFit"
						/>
						<view :class="themeClass('update-heading-copy')">
							<text :class="themeClass('update-title')">发现新版本</text>
							<text :class="themeClass('update-subtitle')">更新后可继续使用</text>
						</view>
					</view>

					<view
						v-if="loadingVersion"
						:class="themeClass('loading-panel')"
					>
						<text :class="themeClass('panel-message')">正在获取版本信息</text>
					</view>
					<view
						v-else-if="loadError != ''"
						:class="themeClass('loading-panel')"
					>
						<text :class="themeClass('panel-message')">{{ loadError }}</text>
						<button
							:class="themeClass('retry-button')"
							@click="loadVersion"
						>
							重试
						</button>
					</view>
					<view
						v-else
						:class="themeClass('update-details')"
					>
						<view :class="themeClass('version-card')">
							<view :class="themeClass('version-summary')">
								<view :class="themeClass('version-row')">
									<text :class="themeClass('version-label')">当前版本</text>
									<text :class="themeClass('version-value')">{{ currentVersionName }}</text>
								</view>
								<text :class="themeClass('version-direction')" aria-hidden="true">→</text>
								<view :class="themeClass('version-row version-row-latest')">
									<text :class="themeClass('version-label version-label-latest')">最新版本</text>
									<text :class="themeClass('version-value version-value-highlight')">{{ latestVersionName }}</text>
								</view>
							</view>
						</view>
						<view :class="themeClass('notes-section')">
							<text :class="themeClass('notes-title')">更新记录</text>
							<view
								v-if="updateGroups.length == 0"
								:class="themeClass('note-row')"
							>
								<text :class="themeClass('note-text')">该版本暂无更新说明</text>
							</view>
							<view
								v-for="(update, updateIndex) in updateGroups"
								:key="update.version_code"
								:class="themeClass(updateIndex > 0 ? 'update-group update-group-separated' : 'update-group')"
							>
								<view :class="themeClass('update-version-heading')">
									<text :class="themeClass('update-version')">{{ update.version_name }}</text>
									<text
										:class="themeClass(update.version_code == latestVersionCode ? 'update-version-meta update-version-latest' : 'update-version-meta')"
									>{{ update.version_code == latestVersionCode ? '最新版本' : '历史更新' }}</text>
								</view>
								<text
									v-if="releaseNoteSections(update).length == 0"
									:class="themeClass('note-text note-empty')"
								>该版本暂无更新说明</text>
								<view
									v-for="section in releaseNoteSections(update)"
									:key="section.title"
									:class="themeClass('note-category')"
								>
									<text :class="themeClass('note-category-title')">{{ section.title }}</text>
									<view :class="themeClass('note-items')">
										<view
											v-for="(note, noteIndex) in section.items"
											:key="noteIndex"
											:class="themeClass(noteIndex > 0 ? 'note-row note-row-spaced' : 'note-row')"
										>
											<text :class="themeClass('note-text')">{{ note }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
					</view>

					<view
						v-if="downloading"
						:class="themeClass('progress-wrap')"
					>
						<view :class="themeClass('progress-track')">
							<view
								:class="themeClass('progress-value')"
								:style="{ width: downloadProgress + '%' }"
							></view>
						</view>
						<text :class="themeClass('progress-text')">正在下载 {{ downloadProgressDisplay }}%</text>
					</view>
				</view>
			</scroll-view>
			<button
				v-if="!loadingVersion && loadError == ''"
				:class="themeClass('update-button')"
				:disabled="downloading || installing"
				@click="downloadAndInstall"
			>
				{{ actionText }}
			</button>
			<button
				v-if="!loadingVersion && loadError == '' && downloadedApk != ''"
				:class="themeClass('redownload-button')"
				:disabled="downloading || installing"
				@click="redownloadApk"
			>
				重新下载安装包
			</button>
			<text
				v-if="actionError != ''"
				:class="themeClass('action-error')"
				>{{ actionError }}</text
			>
		</view>
	</view>
</template>

<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { computed, nextTick, ref, watch } from 'vue'
import { refreshAppTheme } from '@/utils/app-theme.uts'
import {
	AppVersionInfo,
	AppVersionUpdate,
	getAppDownloadURL,
	getCurrentAppVersion,
	getStoredUpdateInfo,
	saveUpdateInfo,
	releaseNoteSections as resolveReleaseNoteSections,
	ReleaseNoteSection
} from '@/utils/api.uts'
import { getAppVersion } from '@/utils/device.uts'

// Keep template calls local for native UTS compilation.
function releaseNoteSections(update: AppVersionUpdate): ReleaseNoteSection[] {
	return resolveReleaseNoteSections(update)
}

onShow(() => refreshAppTheme())

const latestVersion = ref<AppVersionInfo | null>(getStoredUpdateInfo())
const loadingVersion = ref(latestVersion.value == null)
const loadError = ref('')
const downloading = ref(false)
const installing = ref(false)
const downloadProgress = ref(0)
const downloadProgressDisplay = computed((): number => Math.floor(downloadProgress.value))
const actionError = ref('')
const downloadedApk = ref('')
const updateMainHeight = ref(0)

function measureUpdateArea() {
	const area = uni.getElementById('update-scroll')
	if (area != null) updateMainHeight.value = area.offsetHeight
}
onReady(() => {
	nextTick(() => measureUpdateArea())
})
onResize(() => {
	nextTick(() => measureUpdateArea())
})
watch(
	(): string =>
		(loadingVersion.value ? 'loading' : 'ready') +
		'|' + loadError.value +
		'|' + actionError.value +
		'|' + downloadedApk.value,
	() => {
		nextTick(() => measureUpdateArea())
	}
)

const currentVersionName = computed((): string => getAppVersion())
const latestVersionName = computed((): string =>
	latestVersion.value == null ? '' : latestVersion.value.latest_version_name
)
const latestVersionCode = computed((): number =>
	latestVersion.value == null ? 0 : latestVersion.value.latest_version_code
)
const updateGroups = computed((): AppVersionUpdate[] => {
	if (latestVersion.value == null) return []
	// Sort a copy so historical cached responses also display newest first.
	return latestVersion.value.updates.slice().sort((a: AppVersionUpdate, b: AppVersionUpdate): number =>
		b.version_code - a.version_code
	)
})
const actionText = computed((): string => {
	if (downloading.value) return '正在下载'
	if (installing.value) return '正在调起安装'
	if (downloadedApk.value != '') return actionError.value == '' ? '安装更新' : '重试安装'
	return actionError.value == '' ? '下载并安装' : '重新下载'
})

async function loadVersion() {
	loadingVersion.value = true
	loadError.value = ''
	try {
		const version = await getCurrentAppVersion()
		latestVersion.value = version
		saveUpdateInfo(version)
	} catch (error) {
		const message = (error as Error).message
		loadError.value =
			message == null || message == '' ? '无法获取版本信息，请检查网络后重试' : message
	} finally {
		loadingVersion.value = false
	}
}

function downloadFailed(message: string) {
	downloading.value = false
	actionError.value = message
}

function installDownloadedApk(filePath: string) {
	actionError.value = ''
	installing.value = true
	uni.installApk({
		filePath: filePath,
		fail: (error) => {
			const detail = error.errMsg
			actionError.value = detail == null || detail == '' ? '无法调起安装，请重试' : detail
		},
		complete: () => {
			installing.value = false
		}
	})
}

function downloadAndInstall() {
	if (downloading.value || installing.value) return
	if (downloadedApk.value != '') {
		installDownloadedApk(downloadedApk.value)
		return
	}

	downloadProgress.value = 0
	actionError.value = ''
	downloading.value = true
	const downloadTask = uni.downloadFile({
		url: getAppDownloadURL(),
		success: (result) => {
			if (result.statusCode < 200 || result.statusCode >= 300) {
				downloadFailed('安装包下载失败，请重试')
				return
			}
			downloading.value = false
			downloadedApk.value = result.tempFilePath
			installDownloadedApk(result.tempFilePath)
		},
		fail: (error) => {
			const detail = error.errMsg
			downloadFailed(detail == null || detail == '' ? '安装包下载失败，请重试' : detail)
		}
	})

	downloadTask.onProgressUpdate((progress) => {
		downloadProgress.value = progress.progress
	})
}

function redownloadApk() {
	if (downloading.value || installing.value) return
	downloadedApk.value = ''
	downloadAndInstall()
}

onLoad(() => {
	if (latestVersion.value == null) {
		loadVersion()
	}
})

onBackPress((): boolean => true)

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
@import '@/styles/ios-theme.scss';
