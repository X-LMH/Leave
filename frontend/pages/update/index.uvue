	width: 100%;
	margin-top: 44rpx;
	padding: 32rpx;
	box-sizing: border-box;
	border-radius: 32rpx;
	background-color: #FFFFFF;
	box-shadow: 0 12rpx 36rpx rgba(37, 52, 83, 0.04);
}
.version-row {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 12rpx 0;
}
.version-label {
	color: #8994AA;
	font-size: 27rpx;
}
.version-value {
	color: #52627C;
	font-size: 28rpx;
	font-weight: 600;
}
.version-value-highlight {
	padding: 6rpx 16rpx;
	border-radius: 12rpx;
	background-color: #EDF1FF;
	color: #5874D8;
}
.notes-section {
	margin-top: 28rpx;
	padding-top: 26rpx;
	border-top-width: 1rpx;
	border-top-style: solid;
	border-top-color: #E8EDF8;
}
.notes-title {
	margin-bottom: 14rpx;
	color: #253453;
	font-size: 28rpx;
	font-weight: 700;
}
.note-row {
	flex-direction: row;
	margin-top: 10rpx;
}
.note-dot {
	width: 8rpx;
	height: 8rpx;
	margin-top: 15rpx;
	margin-right: 16rpx;
	border-radius: 4rpx;
	background-color: #A7B7E8;
}
.note-text {
	flex: 1;
	color: #62738E;
	font-size: 26rpx;
	line-height: 38rpx;
}
.loading-panel {
	width: 100%;
	margin-top: 44rpx;
	align-items: center;
}
.panel-message {
	color: #8994AA;
	font-size: 28rpx;
	text-align: center;
}
.retry-button {
	width: 260rpx;
	margin-top: 34rpx;
	border-radius: 999rpx;
	background-color: #5874D8;
	color: #FFFFFF;
	font-size: 28rpx;
}
.progress-wrap {
	width: 100%;
	margin-top: 44rpx;
}
.progress-track {
	width: 100%;
	height: 12rpx;
	overflow: hidden;
	border-radius: 6rpx;
	background-color: #DDE5F7;
}
.progress-value {
	height: 12rpx;
	border-radius: 6rpx;
	background-color: #5874D8;
}
.progress-text {
	margin-top: 16rpx;
	color: #8994AA;
	font-size: 25rpx;
	text-align: center;
}
.update-button {
	width: 100%;
	margin-top: auto;
	border-radius: 999rpx;
	background-color: #5874D8;
	color: #FFFFFF;
	font-size: 32rpx;
	font-weight: 600;
}
.action-error {
	margin-top: 22rpx;
	color: #D95B5B;
	font-size: 25rpx;
	text-align: center;
}
</style>
