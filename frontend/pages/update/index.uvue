	height: 12rpx;
	border-radius: 6rpx;
	background-color: $ios-blue;
}
.progress-text {
	margin-top: 16rpx;
	color: $ios-secondary;
	font-size: 12px;
	text-align: center;
	line-height: 18px;
}
.update-button {
	width: 100%;
	border-radius: 26px;
	background-color: $ios-blue;
	color: #ffffff;
