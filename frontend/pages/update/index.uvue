<template>
	<view class="update-page">
		<view class="update-content">
			<view class="update-main">
				<image class="update-illustration" src="/static/update/version-update.svg" mode="aspectFit" />
				<text class="update-title">发现新版本</text>
				<text class="update-subtitle">请更新后继续使用请假申请系统</text>

				<view v-if="loadingVersion" class="loading-panel">
					<text class="panel-message">正在获取版本信息</text>
				</view>
				<view v-else-if="loadError != ''" class="loading-panel">
					<text class="panel-message">{{ loadError }}</text>
					<button class="retry-button" @click="loadVersion">重试</button>
				</view>
				<view v-else class="version-card">
					<view class="version-row">
						<text class="version-label">当前版本</text>
						<text class="version-value">{{ currentVersionName }}</text>
					</view>
					<view class="version-row">
						<text class="version-label">最新版本</text>
						<text class="version-value version-value-highlight">{{ latestVersionName }}</text>
					</view>
					<view class="notes-section">
						<text class="notes-title">本次更新</text>
						<view v-if="releaseNotes.length == 0" class="note-row">
							<view class="note-dot"></view>
							<text class="note-text">修复已知问题并提升使用体验</text>
						</view>
						<view v-for="(note, index) in releaseNotes" :key="index" class="note-row">
							<view class="note-dot"></view>
							<text class="note-text">{{ note }}</text>
						</view>
					</view>
				</view>

				<view v-if="downloading" class="progress-wrap">
					<view class="progress-track">
						<view class="progress-value" :style="{ width: downloadProgress + '%' }"></view>
					</view>
					<text class="progress-text">正在下载 {{ downloadProgressDisplay }}%</text>
				</view>
			</view>

			<button v-if="!loadingVersion && loadError == ''" class="update-button" :disabled="downloading || installing" @click="downloadAndInstall">
				{{ actionText }}
			</button>
			<text v-if="actionError != ''" class="action-error">{{ actionError }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { AppVersionInfo, getAppDownloadURL, getCurrentAppVersion, getStoredUpdateInfo, saveUpdateInfo } from '@/utils/api.uts'
import { getAppVersion } from '@/utils/device.uts'

const latestVersion = ref<AppVersionInfo | null>(getStoredUpdateInfo())
const loadingVersion = ref(latestVersion.value == null)
const loadError = ref('')
const downloading = ref(false)
const installing = ref(false)
const downloadProgress = ref(0)
const downloadProgressDisplay = computed((): number => Math.floor(downloadProgress.value))
const actionError = ref('')

const currentVersionName = computed((): string => getAppVersion())
const latestVersionName = computed((): string => latestVersion.value == null ? '' : latestVersion.value.version_name)
const releaseNotes = computed((): string[] => latestVersion.value == null ? [] : latestVersion.value.release_notes)
const actionText = computed((): string => {
	if (downloading.value) return '正在下载'
	if (installing.value) return '正在调起安装'
	return '下载并安装'
})

async function loadVersion() {
	loadingVersion.value = true
	loadError.value = ''
	try {
		const version = await getCurrentAppVersion()
		latestVersion.value = version
		saveUpdateInfo(version)
	} catch (error) {
		const message = (error as Error).message
		loadError.value = message == null || message == '' ? '无法获取版本信息，请检查网络后重试' : message
	} finally {
		loadingVersion.value = false
	}
}

function downloadFailed(message: string) {
	downloading.value = false
	actionError.value = message
}

function installDownloadedApk(filePath: string) {
	installing.value = true
	uni.installApk({
		filePath: filePath,
		fail: (error) => {
			const detail = error.errMsg
			actionError.value = detail == null || detail == '' ? '无法调起安装，请重试' : detail
		},
		complete: () => {
			installing.value = false
		}
	})
}

function downloadAndInstall() {
	if (downloading.value || installing.value) return

	downloadProgress.value = 0
	actionError.value = ''
	downloading.value = true
	const downloadTask = uni.downloadFile({
		url: getAppDownloadURL(),
		success: (result) => {
			if (result.statusCode < 200 || result.statusCode >= 300) {
				downloadFailed('安装包下载失败，请重试')
				return
			}
			downloading.value = false
			installDownloadedApk(result.tempFilePath)
		},
		fail: (error) => {
			const detail = error.errMsg
			downloadFailed(detail == null || detail == '' ? '安装包下载失败，请重试' : detail)
		}
	})

	downloadTask.onProgressUpdate((progress) => {
		downloadProgress.value = progress.progress
	})
}

onLoad(() => {
	if (latestVersion.value == null) {
		loadVersion()
	}
})

onBackPress((): boolean => true)
</script>

