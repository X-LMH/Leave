}
.redownload-button {
	width: 100%;
	margin-top: 12px;
	height: 44px;
	line-height: 44px;
	padding: 0;
	border-radius: 22px;
	background-color: $ios-surface;
	color: $ios-blue;
	font-size: 14px;
	flex-shrink: 0;
}
.update-scroll {
	flex: 1;
	width: 100%;
	min-height: 0;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-update-page {
	background-color: $ios-dark-page;
}
.dark-update-title {
