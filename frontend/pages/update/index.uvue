	width: 260rpx;
	margin-top: 34rpx;
	border-radius: 22px;
	background-color: $ios-blue;
	color: #ffffff;
	font-size: 16px;
	height: 44px;
	line-height: 44px;
	padding: 0;
}
.progress-wrap {
	width: 100%;
	margin-top: 44rpx;
}
