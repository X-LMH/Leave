<template>
	<PageTransition enter-direction="forward">
		<view :class="themeClass('submit-page')">
			<view :class="themeClass('safe-top')"></view>
			<view :class="themeClass('top-nav')">
				<view
					:class="themeClass('round-control')"
					role="button"
					aria-label="返回"
					@click="goHome"
				>
					<image
						:class="themeClass('control-icon')"
						:src="themeImage('/static/ios/back-ink.svg')"
						mode="aspectFit"
					></image>
				</view>
				<text :class="themeClass('nav-title')">申请请假</text>
				<view
					:class="themeClass('round-control')"
					role="button"
					aria-label="关闭申请"
					@click="goHome"
				>
					<image
						:class="themeClass('control-icon')"
						:src="themeImage('/static/ios/close-secondary.svg')"
						mode="aspectFit"
					></image>
				</view>
			</view>
			<scroll-view
				:class="themeClass('form-scroll')"
				scroll-y="true"
				:scroll-into-view="scrollTarget"
				:show-scrollbar="false"
			>
				<view :class="themeClass('form-content')">
					<view
						id="apply-type"
						:class="themeClass(errorField == 'type' ? 'form-card field-invalid' : 'form-card')"
					>
						<ThemedPicker title="请假类型"
							:disabled="isSubmitting || createdRecordID > 0"
							:range="leaveTypeNames"
							:value="leaveTypeNames.indexOf(leaveType)"
							@change="leaveTypeChange"
						>
							<view :class="themeClass('field-row')">
								<view :class="themeClass('label-wrap')">
									<text :class="themeClass('field-label')">请假类型</text>
									<text :class="themeClass('required')">*</text>
								</view>
								<view :class="themeClass('picker-content')">
									<text :class="themeClass('field-value')">{{ leaveType == '' ? '请选择' : leaveType }}</text>
									<image
										:class="themeClass('picker-arrow')"
										:src="themeImage('/static/ios/back-ink.svg')"
										mode="aspectFit"
									></image>
								</view>
							</view>
						</ThemedPicker>
						<text
							v-if="errorField == 'type'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
					<view
						id="apply-time"
						:class="themeClass(errorField == 'time' ? 'form-card field-invalid' : 'form-card')"
					>
						<view
							:class="themeClass('time-row')"
							@click="openDatePicker('start')"
						>
							<view :class="themeClass('label-wrap')">
								<text :class="themeClass('field-label')">开始时间</text>
								<text :class="themeClass('required')">*</text>
							</view>
							<view :class="themeClass('date-line')">
								<text :class="themeClass(startDate == '' ? 'date-value date-placeholder' : 'date-value')">
									{{
										startDate == ''
											? '请选择'
											: startDate.slice(0, 16).replaceAll('-', '/')
									}}
								</text>
								<image
									:class="themeClass('calendar-icon')"
									:src="themeImage('/static/ios/calendar-secondary.svg')"
									mode="aspectFit"
								></image>
							</view>
						</view>
						<view
							:class="themeClass('time-row')"
							@click="openDatePicker('end')"
						>
							<view :class="themeClass('label-wrap')">
								<text :class="themeClass('field-label')">结束时间</text>
								<text :class="themeClass('required')">*</text>
							</view>
							<view :class="themeClass('date-line')">
								<text :class="themeClass(endDate == '' ? 'date-value date-placeholder' : 'date-value')">
									{{
										endDate == '' ? '请选择' : endDate.slice(0, 16).replaceAll('-', '/')
									}}
								</text>
								<image
									:class="themeClass('calendar-icon')"
									:src="themeImage('/static/ios/calendar-secondary.svg')"
									mode="aspectFit"
								></image>
							</view>
						</view>
						<view :class="themeClass('duration-row')">
							<text :class="themeClass('field-label')">请假时长</text>
							<text :class="themeClass('computed-value')">{{ hasDuration ? durationText : '—' }}</text>
						</view>
						<text
							v-if="errorField == 'time'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
					<view :class="themeClass('form-card')">
						<view :class="themeClass('field-row')">
							<text :class="themeClass('field-label')">影响课程</text>
							<input
								:class="themeClass('line-input')"
								v-model="course"
								:disabled="isSubmitting || createdRecordID > 0"
								maxlength="255"
								placeholder="请输入影响课程"
								:placeholder-class="themeClass('input-placeholder')"
								:cursor-spacing="24"
							/>
						</view>
					</view>
					<view :class="themeClass('form-card')">
						<ThemedPicker title="是否离校"
							:range="schoolOptions"
							:value="leaveSchool == '是' ? 0 : 1"
							:disabled="isSubmitting || createdRecordID > 0"
							@change="schoolChange"
						>
							<view :class="themeClass('field-row')">
								<view :class="themeClass('label-wrap')">
									<text :class="themeClass('field-label')">是否离校</text>
									<text :class="themeClass('required')">*</text>
								</view>
								<view :class="themeClass('picker-content')">
									<text :class="themeClass('field-value')">{{ leaveSchool }}</text>
									<image
										:class="themeClass('picker-arrow')"
										:src="themeImage('/static/ios/back-ink.svg')"
										mode="aspectFit"
									></image>
								</view>
							</view>
						</ThemedPicker>
					</view>
					<view
						v-if="leaveSchool == '是'"
						id="apply-destination"
						:class="themeClass(errorField == 'destination'
								? 'form-card destination-card field-invalid'
								: 'form-card destination-card')"
					>
						<view :class="themeClass('label-wrap')">
							<text :class="themeClass('destination-label')">请假去向</text>
							<text :class="themeClass('required')">*</text>
						</view>
						<view :class="themeClass('region-row')" role="button" aria-label="选择省市区" @click="openRegionPicker">
							<text :class="themeClass('region-summary')">{{ destination == '' ? '请选择省 / 市 / 区' : destination.replaceAll(',', ' / ') }}</text>
							<image :class="themeClass('picker-arrow')" :src="themeImage('/static/ios/back-ink.svg')" mode="aspectFit"></image>
						</view>
						<text
							v-if="errorField == 'destination'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
					<view id="apply-reason">
						<view :class="themeClass('reason-label')">
							<text :class="themeClass('destination-label')">请假理由</text>
							<text :class="themeClass('required')">*</text>
						</view>
						<view :class="themeClass(errorField == 'reason' ? 'reason-box field-invalid' : 'reason-box')">
							<textarea
								:class="themeClass('reason-input')"
								v-model="reason"
								:disabled="isSubmitting || createdRecordID > 0"
								:focus="focusedField == 'reason'"
								:cursor-spacing="24"
								maxlength="200"
								placeholder="请详细说明请假原因"
								:placeholder-class="themeClass('input-placeholder')"
								@input="clearError"
							/>
							<text :class="themeClass('word-count')">{{ reason.length }}/200</text>
						</view>
						<text
							v-if="errorField == 'reason'"
							:class="themeClass('field-error')"
						>
							{{ formError }}
						</text>
					</view>
					<view :class="themeClass('form-card travel-card')">
						<view :class="themeClass('field-row')">
							<text :class="themeClass('field-label')">出行方式</text>
							<input
								:class="themeClass('line-input')"
								v-model="travel"
								:disabled="isSubmitting || createdRecordID > 0"
								maxlength="255"
								placeholder="请输入出行方式"
								:placeholder-class="themeClass('input-placeholder')"
								:cursor-spacing="24"
							/>
						</view>
					</view>
					<text
						v-if="formError != '' && errorField == ''"
						:class="themeClass('form-error')"
					>
						{{ formError }}
					</text>
					<view
						:class="themeClass(isSubmitting ? 'primary-button primary-button-disabled' : 'primary-button')"
						@click="submit"
					>
						<text :class="themeClass('primary-button-text')">
							{{ isSubmitting ? '提交中…' : createdRecordID > 0 ? '查看已提交申请' : '提交申请' }}
						</text>
					</view>
				</view>
			</scroll-view>
			<page-container :show="showRegionPicker" position="bottom" @clickoverlay="cancelRegionPicker" @afterleave="cancelRegionPicker">
				<view :class="themeClass('destination-panel')" :style="{ paddingBottom: pickerBottomInset() + 'px' }">
					<view :class="themeClass('destination-panel-actions')">
						<text :class="themeClass('destination-panel-cancel')" @click="cancelRegionPicker">取消</text>
						<text :class="themeClass('destination-panel-title')">请假去向</text>
						<text :class="themeClass('destination-panel-confirm')" @click="confirmRegionPicker">确定</text>
					</view>
					<view class="region-headings">
						<text :class="themeClass('region-heading')">省份</text>
						<text :class="themeClass('region-heading')">城市</text>
						<text :class="themeClass('region-heading')">区县</text>
					</view>
					<picker-view class="region-wheel" :value="pendingRegionIndex" :indicator-style="pickerIndicator()"
						:mask-top-style="pickerMaskTop()" :mask-bottom-style="pickerMaskBottom()"
						@change="regionViewChange" @pickstart="regionRolling = true" @pickend="regionRolling = false">
						<picker-view-column>
							<view v-for="(item, index) in destinationRegionOptions[0]" :key="index" :class="themeClass('date-picker-item')">
								<text :class="themeClass('region-wheel-text')">{{ item }}</text>
							</view>
						</picker-view-column>
						<picker-view-column>
							<view v-for="(item, index) in destinationRegionOptions[1]" :key="index" :class="themeClass('date-picker-item')">
								<text :class="themeClass('region-wheel-text')">{{ item }}</text>
							</view>
						</picker-view-column>
						<picker-view-column>
							<view v-for="(item, index) in destinationRegionOptions[2]" :key="index" :class="themeClass('date-picker-item')">
								<text :class="themeClass('region-wheel-text')">{{ item }}</text>
							</view>
						</picker-view-column>
					</picker-view>
				</view>
			</page-container>
			<page-container
				:show="showDatePicker"
				position="bottom"
				@clickoverlay="cancelDatePicker"
				@afterleave="cancelDatePicker"
			>
				<view :class="themeClass('destination-panel')" :style="{ paddingBottom: pickerBottomInset() + 'px' }">
					<view :class="themeClass('destination-panel-actions')">
						<text
							:class="themeClass('destination-panel-cancel')"
							@click="datePickerBack"
						>
							{{ datePickerStep == 'date' ? '取消' : '上一步' }}
						</text>
						<text :class="themeClass('destination-panel-title')">{{ editingDate == 'start' ? '开始时间' : '结束时间' }} · {{ datePickerStep == 'date' ? '日期' : '时间' }}</text>
						<text
							:class="themeClass('destination-panel-confirm')"
							@click="advanceDatePicker"
						>
							{{ datePickerStep == 'date' ? '下一步' : '确定' }}
						</text>
					</view>
					<view :class="themeClass('date-picker-wheel-wrap')">
						<picker-view
							:class="themeClass(datePickerStep == 'date'
									? 'date-picker-wheel date-picker-wheel-active'
									: 'date-picker-wheel')"
							:value="pendingDateIndex"
							:indicator-style="pickerIndicator()"
							:mask-top-style="pickerMaskTop()"
							:mask-bottom-style="pickerMaskBottom()"
							@pickstart="dateRolling = true" @pickend="dateRolling = false"
							@change="dateViewChange"
						>
							<picker-view-column>
								<view
									v-for="(year, index) in dateYears"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ year }}年</text>
								</view>
							</picker-view-column>
							<picker-view-column>
								<view
									v-for="(month, index) in dateMonths"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ twoDigits(month) }}月</text>
								</view>
							</picker-view-column>
							<picker-view-column>
								<view
									v-for="(day, index) in dateDays"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ twoDigits(day) }}日</text>
								</view>
							</picker-view-column>
						</picker-view>
						<picker-view
							:class="themeClass(datePickerStep == 'time'
									? 'date-picker-wheel date-picker-wheel-active'
									: 'date-picker-wheel')"
							:value="pendingTimeIndex"
							:indicator-style="pickerIndicator()"
							:mask-top-style="pickerMaskTop()"
							:mask-bottom-style="pickerMaskBottom()"
							@pickstart="dateRolling = true" @pickend="dateRolling = false"
							@change="timeViewChange"
						>
							<picker-view-column>
								<view
									v-for="(hour, index) in timeHours"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ twoDigits(hour) }}时</text>
								</view>
							</picker-view-column>
							<picker-view-column>
								<view
									v-for="(minute, index) in timeMinutes"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ twoDigits(minute) }}分</text>
								</view>
							</picker-view-column>
							<picker-view-column>
								<view
									v-for="(second, index) in timeSeconds"
									:key="index"
									:class="themeClass('date-picker-item')"
								>
									<text :class="themeClass('destination-picker-item-text')">{{ twoDigits(second) }}秒</text>
								</view>
							</picker-view-column>
						</picker-view>
					</view>
				</view>
			</page-container>
		</view>
	</PageTransition>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { computed, nextTick, ref } from 'vue'
import { pickerIndicator as resolvePickerIndicator, pickerMaskTop as resolvePickerMaskTop, pickerMaskBottom as resolvePickerMaskBottom, pickerBottomInset as resolvePickerBottomInset } from '@/utils/picker-theme.uts'
import ThemedPicker from '@/components/ThemedPicker.uvue'
import PageTransition from '@/components/PageTransition.uvue'
import { createRecord, getLeaveTypes, LeaveTypeOption } from '@/utils/api.uts'
import { cityData } from '@/data/city.uts'

type RegionItem = {
	title: string
	id: string
	children: RegionItem[]
}

const formError = ref('')
const errorField = ref('')
const focusedField = ref('')
const scrollTarget = ref('')
const schoolOptions: string[] = ['是', '否']
function showFieldError(field: string, message: string) {
	formError.value = message
	errorField.value = field
	focusedField.value = ''
	scrollTarget.value = ''
	nextTick(() => {
		scrollTarget.value = 'apply-' + field
		focusedField.value = field
	})
}
function clearError() {
	formError.value = ''
	errorField.value = ''
}

const leaveTypes = ref<LeaveTypeOption[]>([])
const leaveType = ref('')
const leaveTypeID = ref(0)
const leaveSchool = ref('是')
const course = ref('')
const reason = ref('')
const travel = ref('')
const destination = ref('')
const showRegionPicker = ref(false)
const regionRolling = ref(false)
const pendingRegionIndex = ref<number[]>([0, 0, 0])
const destinationRegionIndex = ref<number[]>([0, 0, 0])
const destinationRegionOptions = ref<string[][]>([[], [], []])
const administrativeRegions = JSON.parse<RegionItem[]>(cityData)!
const startDate = ref('')
const endDate = ref('')
const showDatePicker = ref(false)
const editingDate = ref('start')
const datePickerStep = ref('date')
const pendingDateIndex = ref<number[]>([0, 0, 0])
// 时间滚轮常驻弹层内，先以当前时间定位，打开字段时再刷新为点击时刻。
const initialPickerTime = new Date()
const pendingTimeIndex = ref<number[]>([
	initialPickerTime.getHours(),
	initialPickerTime.getMinutes(),
	initialPickerTime.getSeconds()
])
const dateYears: number[] = []
const dateMonths: number[] = []
const timeHours: number[] = []
const timeMinutes: number[] = []
const timeSeconds: number[] = []
// App 的长年份滚轮在初次定位时会出现选中行偏移，限制在请假业务所需的年份范围内。
const firstDateYear = new Date().getFullYear() - 5
for (let year = firstDateYear; year <= firstDateYear + 20; year++) dateYears.push(year)
for (let month = 1; month <= 12; month++) dateMonths.push(month)
for (let hour = 0; hour < 24; hour++) timeHours.push(hour)
for (let value = 0; value < 60; value++) {
	timeMinutes.push(value)
	timeSeconds.push(value)
}
const dateDays = ref<number[]>([])
const dateRolling = ref(false)
const isSubmitting = ref(false)
const createdRecordID = ref(0)
const openingDetail = ref(false)
const appliedAt = ref('')
function twoDigits(value: number): string {
	return value < 10 ? `0${value}` : `${value}`
}
function randomInteger(min: number, max: number): number {
	return Math.floor(Math.random() * (max - min + 1)) + min
}
const advanceMilliseconds = randomInteger(60 * 60, 2 * 60 * 60) * 1000
const leaveTypeNames = computed((): string[] => leaveTypes.value.map((item): string => item.name))
const durationHours = computed((): number => {
	if (startDate.value == '' || endDate.value == '') return 0
	const difference =
		new Date(endDate.value.replace(' ', 'T')).getTime() -
		new Date(startDate.value.replace(' ', 'T')).getTime()
	return difference <= 0 ? 0 : Math.ceil(difference / 3600000)
})
const hasDuration = computed((): boolean => durationHours.value > 0)
const durationDays = computed((): number => Math.floor(durationHours.value / 24))
const remainingDurationHours = computed((): number => durationHours.value % 24)
const durationText = computed(
	(): string => `${durationDays.value}天${remainingDurationHours.value}小时`
)
function leaveTypeChange(index: number) {
	const selected = leaveTypes.value[index]
	if (selected == null) return
	leaveType.value = selected.name
	leaveTypeID.value = selected.id
}

function updateDateDays(yearIndex: number, monthIndex: number) {
	const count = new Date(dateYears[yearIndex], monthIndex + 1, 0).getDate()
	const days: number[] = []
	for (let day = 1; day <= count; day++) days.push(day)
	dateDays.value = days
}

function openDatePicker(field: string) {
	if (isSubmitting.value || createdRecordID.value > 0) return
	editingDate.value = field
	const saved = field == 'start' ? startDate.value : endDate.value
	const now = new Date()
	const year = saved == '' ? now.getFullYear() : parseInt(saved.slice(0, 4))
	const month = saved == '' ? now.getMonth() + 1 : parseInt(saved.slice(5, 7))
	const day = saved == '' ? now.getDate() : parseInt(saved.slice(8, 10))
	const yearIndex = Math.max(0, Math.min(dateYears.length - 1, year - firstDateYear))
	const monthIndex = Math.max(0, Math.min(11, month - 1))
	updateDateDays(yearIndex, monthIndex)
	pendingDateIndex.value = [yearIndex, monthIndex, Math.min(day - 1, dateDays.value.length - 1)]
	if (saved == '') {
		pendingTimeIndex.value = [now.getHours(), now.getMinutes(), now.getSeconds()]
	} else {
		pendingTimeIndex.value = [
			parseInt(saved.slice(11, 13)),
			parseInt(saved.slice(14, 16)),
			parseInt(saved.slice(17, 19))
		]
	}
	dateRolling.value = false
	datePickerStep.value = 'date'
	showDatePicker.value = true
}

function cancelDatePicker() {
	showDatePicker.value = false
}

function datePickerBack() {
	if (datePickerStep.value == 'time') {
		datePickerStep.value = 'date'
		return
	}
	cancelDatePicker()
}

function dateViewChange(e: UniPickerViewChangeEvent) {
	if (datePickerStep.value != 'date') return
	const selected = e.detail.value
	if (selected.length < 3) return
	if (selected[0] != pendingDateIndex.value[0] || selected[1] != pendingDateIndex.value[1]) {
		updateDateDays(selected[0], selected[1])
	}
	pendingDateIndex.value = [
		selected[0],
		selected[1],
		Math.min(selected[2], dateDays.value.length - 1)
	]
}

function timeViewChange(e: UniPickerViewChangeEvent) {
	if (datePickerStep.value != 'time') return
	const selected = e.detail.value
	if (selected.length < 3) return
	pendingTimeIndex.value = [selected[0], selected[1], selected[2]]
}

function advanceDatePicker() {
	if (dateRolling.value) return
	const date = pendingDateIndex.value
	const selectedDate = `${dateYears[date[0]]}-${twoDigits(date[1] + 1)}-${twoDigits(date[2] + 1)}`
	if (datePickerStep.value == 'date') {
		if (
			editingDate.value == 'end' &&
			startDate.value != '' &&
			selectedDate < startDate.value.slice(0, 10)
		) {
			uni.showToast({ title: '结束时间必须晚于开始时间', icon: 'none' })
			return
		}
		if (
			editingDate.value == 'start' &&
			endDate.value != '' &&
			selectedDate > endDate.value.slice(0, 10)
		) {
			uni.showToast({ title: '开始时间必须早于结束时间', icon: 'none' })
			return
		}
		datePickerStep.value = 'time'
		return
	}
	const time = pendingTimeIndex.value
	// 两步都完成后才更新表单，取消或返回时保留原值。
	const value = `${selectedDate} ${twoDigits(time[0])}:${twoDigits(time[1])}:${twoDigits(time[2])}`
	if (editingDate.value == 'start') {
		if (endDate.value != '' && value >= endDate.value) {
			uni.showToast({ title: '开始时间必须早于结束时间', icon: 'none' })
			return
		}
		startDate.value = value
	} else {
		if (startDate.value != '' && value <= startDate.value) {
			uni.showToast({ title: '结束时间必须晚于开始时间', icon: 'none' })
			return
		}
		endDate.value = value
	}
	showDatePicker.value = false
}

function setLeaveSchool(value: string) {
	if (isSubmitting.value || createdRecordID.value > 0) return
	leaveSchool.value = value
}

function setDestinationRegionOptions(provinceIndex: number, cityIndex: number) {
	const province = administrativeRegions[provinceIndex]
	if (province == null) return
	const cities = province.children
	destinationRegionOptions.value[1] = cities.map((item): string => item.title)
	const city = cities[cityIndex]
	destinationRegionOptions.value[2] =
		city == null ? [] : city.children.map((item): string => item.title)
}

function openRegionPicker() {
	if (isSubmitting.value || createdRecordID.value > 0) return
	pendingRegionIndex.value = [...destinationRegionIndex.value]
	setDestinationRegionOptions(pendingRegionIndex.value[0], pendingRegionIndex.value[1])
	regionRolling.value = false
	showRegionPicker.value = true
}
function cancelRegionPicker() {
	showRegionPicker.value = false
}
function regionViewChange(event: UniPickerViewChangeEvent) {
	const selected = event.detail.value
	if (selected.length < 3 || !showRegionPicker.value) return
	const previous = pendingRegionIndex.value
	const provinceIndex = selected[0]
	if (provinceIndex < 0 || provinceIndex >= administrativeRegions.length) return
	// 上一级变化后，下级回到首项，避免旧列索引落到新地区中。
	const provinceChanged = provinceIndex != previous[0]
	const cities = administrativeRegions[provinceIndex].children
	const cityIndex = provinceChanged ? 0 : Math.max(0, Math.min(selected[1], cities.length - 1))
	const cityChanged = provinceChanged || cityIndex != previous[1]
	const city = cities[cityIndex]
	const districtIndex = cityChanged || city == null ? 0 : Math.max(0, Math.min(selected[2], city.children.length - 1))
	setDestinationRegionOptions(provinceIndex, cityIndex)
	pendingRegionIndex.value = [provinceIndex, cityIndex, districtIndex]
}
function confirmRegionPicker() {
	if (regionRolling.value || isSubmitting.value || createdRecordID.value > 0) return
	const selected = pendingRegionIndex.value
	const province = administrativeRegions[selected[0]]
	const city = province?.children[selected[1]]
	const district = city?.children[selected[2]]
	if (province == null || city == null || district == null) return
	destinationRegionIndex.value = [...selected]
	destination.value = province.title + ',' + city.title + ',' + district.title
	clearError()
	showRegionPicker.value = false
}

function initializeDestinationRegion() {
	const provinceName = '内蒙古自治区'
	const cityName = '呼和浩特市'
	const districtName = '土默特左旗'
	let provinceIndex = 0
	let cityIndex = 0
	let districtIndex = 0
	for (let i = 0; i < administrativeRegions.length; i++) {
		if (administrativeRegions[i].title == provinceName) {
			provinceIndex = i
			break
		}
	}
	const province = administrativeRegions[provinceIndex]
	if (province != null) {
		for (let i = 0; i < province.children.length; i++) {
			if (province.children[i].title == cityName) {
				cityIndex = i
				break
			}
		}
		const city = province.children[cityIndex]
		if (city != null) {
			for (let i = 0; i < city.children.length; i++) {
				if (city.children[i].title == districtName) {
					districtIndex = i
					break
				}
			}
		}
	}
	destinationRegionIndex.value = [provinceIndex, cityIndex, districtIndex]
	destinationRegionOptions.value[0] = administrativeRegions.map((item): string => item.title)
	setDestinationRegionOptions(provinceIndex, cityIndex)
	destination.value = `${provinceName},${cityName},${districtName}`
}

initializeDestinationRegion()

function schoolChange(index: number) {
	if (index == 0 || index == 1) setLeaveSchool(schoolOptions[index])
}

let initialForm = ''
let leaving = false
let confirmingLeave = false
function formSnapshot(): string {
	return JSON.stringify([
		leaveType.value,
		startDate.value,
		endDate.value,
		course.value,
		reason.value,
		leaveSchool.value,
		destination.value,
		travel.value
	])
}
function leavePage() {
	leaving = true
	uni.navigateBack({
		fail: () => {
			uni.reLaunch({
				url: '/pages/home/index',
				fail: () => {
					leaving = false
				}
			})
		}
	})
}
function goHome() {
	if (showRegionPicker.value) {
		cancelRegionPicker()
		return
	}
	if (isSubmitting.value || openingDetail.value || confirmingLeave) return
	if (createdRecordID.value > 0 || formSnapshot() == initialForm) {
		leavePage()
		return
	}
	confirmingLeave = true
	uni.showModal({
		title: '放弃本次申请？',
		content: '尚未提交的内容将不会保存。',
		confirmText: '放弃',
		cancelText: '继续填写',
		success: (result) => {
			if (result.confirm) leavePage()
		},
		complete: () => {
			confirmingLeave = false
		}
	})
}
function toRFC3339(value: string): string {
	return new Date(value.replace(' ', 'T')).toISOString()
}

async function loadLeaveTypes() {
	try {
		leaveTypes.value = await getLeaveTypes()
		if (leaveTypes.value.length == 0) {
			uni.showToast({ title: '暂无可用请假类型', icon: 'none' })
		}
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({
			title: message == null || message == '' ? '请假类型加载失败' : message,
			icon: 'none'
		})
	}
}

function openCreatedRecord() {
	if (openingDetail.value || createdRecordID.value <= 0) return
	openingDetail.value = true
	uni.redirectTo({
		url: `/pages/leave/detail?id=${createdRecordID.value}`,
		fail: () => {
			uni.showToast({ title: '申请已提交，点击按钮查看详情', icon: 'none' })
		},
		complete: () => {
			openingDetail.value = false
		}
	})
}

onBackPress((): boolean => {
	if (leaving) return false
	if (showDatePicker.value) {
		cancelDatePicker()
		return true
	}

	goHome()
	return true
})

async function submit() {
	if (isSubmitting.value) return
	if (createdRecordID.value > 0) {
		openCreatedRecord()
		return
	}
	if (leaveType.value == '' || leaveTypeID.value == 0) {
		showFieldError('type', '请选择请假类型')
		return
	}
	if (startDate.value == '' || endDate.value == '') {
		showFieldError('time', '请选择请假时间')
		return
	}
	if (
		new Date(endDate.value.replace(' ', 'T')).getTime() <=
		new Date(startDate.value.replace(' ', 'T')).getTime()
	) {
		showFieldError('time', '结束时间必须晚于开始时间')
		return
	}
	if (reason.value.trim() == '') {
		showFieldError('reason', '请填写请假理由')
		return
	}
	if (leaveSchool.value == '是' && destination.value == '') {
		showFieldError('destination', '请选择请假去向')
		return
	}
	clearError()
	uni.hideKeyboard()
	isSubmitting.value = true
	try {
		const now = new Date().toISOString()
		const record = await createRecord({
			leave_type_id: leaveTypeID.value,
			start_time: toRFC3339(startDate.value),
			end_time: toRFC3339(endDate.value),
			affected_course: course.value,
			is_leave_school: leaveSchool.value == '是',
			leave_reason: reason.value,
			travel_way: travel.value,
			destination: leaveSchool.value == '是' ? destination.value : '',
			applied_at: appliedAt.value,
			approved_at: now
		})
		createdRecordID.value = record.id
		openCreatedRecord()
	} catch (error) {
		const message = (error as Error).message
		formError.value = message == null || message == '' ? '提交申请失败，请重试' : message
		uni.showToast({
			title: message == null || message == '' ? '提交申请失败' : message,
			icon: 'none'
		})
	} finally {
		isSubmitting.value = false
	}
}

onLoad(() => {
	initialForm = formSnapshot()
	appliedAt.value = new Date(Date.now() - advanceMilliseconds).toISOString()
	loadLeaveTypes()
})

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
function pickerIndicator(): string {
	return resolvePickerIndicator()
}
function pickerMaskTop(): string {
	return resolvePickerMaskTop()
}
function pickerMaskBottom(): string {
	return resolvePickerMaskBottom()
}
function pickerBottomInset(): number {
	return resolvePickerBottomInset()
}
</script>
