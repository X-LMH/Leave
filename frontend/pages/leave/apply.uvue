<template>
	<PageTransition ref="pageTransition" enter-direction="forward">
	<view class="submit-page">
		<view class="safe-top">
		</view>
		<view class="top-nav">
			<view class="back-button" @click="goHome">
				<view class="back-chevron">
				</view>
			</view>
			<text class="nav-title">发起请假</text>
			<view class="nav-placeholder">
			</view>
		</view>
		<scroll-view class="form-scroll" scroll-y="true" :show-scrollbar="false">
			<view class="form-content">
				<view class="hero-copy">
					<text class="hero-title">请填写请假信息</text>
					<text class="hero-subtitle">请如实填写，以便审批</text>
				</view>
				<image class="hero-illustration" src="/static/leave/apply/2.png" mode="aspectFit"></image>
				<view class="hero-orb hero-orb-small">
				</view>
				<view class="hero-orb hero-orb-large">
				</view>
				<view class="form-card single-card">
					<picker class="field-picker picker-row" :range="leaveTypes" @change="leaveTypeChange">
						<view class="field-row">
							<view class="label-wrap">
								<text class="field-label">请假类型</text>
								<text class="required">*</text>
							</view>
							<view class="picker-content">
								<text :class="leaveType == '' ? 'field-placeholder' : 'field-value'">{{ leaveType == '' ? '请选择请假类型     ' : leaveType }}</text>
							</view>
						</view>
					</picker>
				</view>
				<view class="form-card time-card">
					<picker class="field-picker picker-row time-picker-row" mode="date" :value="startPickerDate" @change="startDateChange">
						<view class="field-row time-row">
							<view class="label-wrap">
								<text class="field-label">开始时间</text>
								<text class="required">*</text>
							</view>
							<view class="date-content">
								<view class="time-value-wrap">
									<text :class="startDate == '' ? 'field-placeholder' : 'field-value'">{{ startDate == '' ? '请选择开始时间     ' : startDate }}</text>
								</view>
							</view>
						</view>
					</picker>
					<view class="time-divider">
					</view>
					<picker class="field-picker picker-row time-picker-row" mode="date" :value="endPickerDate" @change="endDateChange">
						<view class="field-row time-row">
							<view class="label-wrap">
								<text class="field-label">结束时间</text>
								<text class="required">*</text>
							</view>
							<view class="date-content">
								<view class="time-value-wrap">
									<text :class="endDate == '' ? 'field-placeholder' : 'field-value'">{{ endDate == '' ? '请选择结束时间     ' : endDate }}</text>
								</view>
							</view>
						</view>
					</picker>
					<view class="time-divider">
					</view>
					<view class="field-row duration-row">
						<text class="field-label">请假时长</text>
						<view class="duration-content">
							<text :class="hasDuration ? 'duration-value' : 'field-placeholder'">{{ hasDuration ? durationHours + ' 小时' : " " }}</text>
						</view>
					</view>
				</view>
				<view class="form-card single-card">
					<view class="field-row">
						<text class="field-label">影响课程</text>
						<view class="text-field">
							<input class="line-input" v-model="course" maxlength="255" placeholder="请输入影响课程     " placeholder-class="course-placeholder" placeholder-style="text-align:right;color:#a6b6d6" />
						</view>
					</view>
				</view>
				<view class="form-card single-card">
					<view class="field-row">
						<view class="label-wrap">
							<text class="field-label">是否离校</text>
							<text class="required">*</text>
						</view>
						<view class="school-segment">
							<view :class="leaveSchool == '是' ? 'school-option school-option-active' : 'school-option'" @click="setLeaveSchool('是')">
								<text :class="leaveSchool == '是' ? 'school-text school-text-active' : 'school-text'">是</text>
							</view>
							<view :class="leaveSchool == '否' ? 'school-option school-option-active' : 'school-option'" @click="setLeaveSchool('否')">
								<text :class="leaveSchool == '否' ? 'school-text school-text-active' : 'school-text'">否</text>
							</view>
						</view>
					</view>
				</view>
				<view class="form-card reason-card">
					<view class="label-wrap reason-label">
						<text class="field-label">请假理由</text>
						<text class="required">*</text>
					</view>
					<view class="reason-box">
						<textarea class="reason-input" v-model="reason" maxlength="200" placeholder="请详细说明请假原因" placeholder-class="input-placeholder" />
						<text class="word-count">{{ reason.length }}/200</text>
					</view>
				</view>
				<view class="form-card single-card travel-card">
					<view class="field-row">
						<text class="field-label">出行方式</text>
						<view class="text-field">
							<input class="line-input" v-model="travel" maxlength="255" placeholder="请输入出行方式     " placeholder-class="input-placeholder" />
						</view>
					</view>
				</view>
				<view class="submit-button" @click="submit">
					<text class="submit-text">提交申请</text>
				</view>
			</view>
		</scroll-view>
	</view>
	</PageTransition>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import PageTransition from '@/components/PageTransition.uvue'


const leaveTypes = ['病假-本科生', '事假-本科生']
const leaveType = ref('')
const leaveSchool = ref('是')
const course = ref('')
const reason = ref('')
const travel = ref('')
const startDate = ref('')
const endDate = ref('')
class ApplicationTimes {
	startDate: string = ''
	endDate: string = ''
	submitTime: string = ''
	approvalTime: string = ''

	constructor(startDate: string, endDate: string, submitTime: string, approvalTime: string) {
		this.startDate = startDate
		this.endDate = endDate
		this.submitTime = submitTime
		this.approvalTime = approvalTime
	}
}
function twoDigits(value: number): string {
	return value < 10 ? `0${value}` : `${value}`
}
function formatTime(date: Date): string {
	return `${twoDigits(date.getHours())}:${twoDigits(date.getMinutes())}:${twoDigits(date.getSeconds())}`
}
function withTime(dateValue: string, time: Date): string {
	return `${dateValue} ${formatTime(time)}`
}
function createApplicationTimes(startDateValue: string, endDateValue: string): ApplicationTimes {
	const approvalTime = new Date()
	const oneHourEarlier = new Date(approvalTime.getTime() - 60 * 60 * 1000)
	const startDay = startDateValue.slice(0, 10)
	const endDay = endDateValue.slice(0, 10)
	return new ApplicationTimes(
		withTime(startDay, oneHourEarlier),
		withTime(endDay, oneHourEarlier),
		withTime(startDay, oneHourEarlier),
		withTime(endDay, approvalTime)
	)
}
const startPickerDate = computed((): string => startDate.value == '' ? '' : startDate.value.slice(0, 10))
const endPickerDate = computed((): string => endDate.value == '' ? '' : endDate.value.slice(0, 10))
const durationHours = computed((): number => {
	if (startDate.value == '' || endDate.value == '') return 0
	const difference = new Date(endDate.value.replace(' ', 'T')).getTime() - new Date(startDate.value.replace(' ', 'T')).getTime()
	return difference <= 0 ? 0 : Math.ceil(difference / 3600000)
})
const hasDuration = computed((): boolean => durationHours.value > 0)
function leaveTypeChange(e: UniPickerChangeEvent) {
	leaveType.value = leaveTypes[e.detail.value as number]
}

function startDateChange(e: UniPickerChangeEvent) {
	const oneHourEarlier = new Date(Date.now() - 60 * 60 * 1000)
	startDate.value = withTime(e.detail.value as string, oneHourEarlier)
}

function endDateChange(e: UniPickerChangeEvent) {
	const oneHourEarlier = new Date(Date.now() - 60 * 60 * 1000)
	endDate.value = withTime(e.detail.value as string, oneHourEarlier)
}

function setLeaveSchool(value: string) {
	leaveSchool.value = value
}

function goHome() {
	uni.reLaunch({ url: '/pages/home/index' })
}
function submit() {
	if (leaveType.value == '') {
		uni.showToast({ title: '请选择请假类型', icon: 'none' })
		return
	}
	if (startDate.value == '' || endDate.value == '') {
		uni.showToast({ title: '请选择请假时间', icon: 'none' })
		return
	}
	if (new Date(endDate.value.replace(' ', 'T')).getTime() < new Date(startDate.value.replace(' ', 'T')).getTime()) {
		uni.showToast({ title: '结束时间不能早于开始时间', icon: 'none' })
		return
	}
	if (reason.value.trim() == '') {
		uni.showToast({ title: '请填写请假理由', icon: 'none' })
		return
	}
	const applicationTimes = createApplicationTimes(startDate.value, endDate.value)
	startDate.value = applicationTimes.startDate
	endDate.value = applicationTimes.endDate
	const application = JSON.stringify({
		leaveType: leaveType.value,
		startDate: startDate.value,
		endDate: endDate.value,
		duration: durationHours.value,
		course: course.value,
		leaveSchool: leaveSchool.value,
		reason: reason.value,
		travel: travel.value,
		submitTime: applicationTimes.submitTime,
		approvalTime: applicationTimes.approvalTime
	})
	const query = `?application=${encodeURIComponent(application)}`
	uni.navigateTo({ url: `/pages/leave/detail${query}` })
}
</script>

