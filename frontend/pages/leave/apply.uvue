<template>
	<PageTransition ref="pageTransition" enter-direction="forward">
	<view class="submit-page">
		<view class="safe-top">
		</view>
		<view class="top-nav">
			<view class="back-button" @click="goHome">
				<view class="back-chevron">
				</view>
			</view>
			<text class="nav-title">发起请假</text>
			<view class="nav-placeholder">
			</view>
		</view>
		<scroll-view class="form-scroll" scroll-y="true" :show-scrollbar="false">
			<view class="form-content">
				<view class="hero-copy">
					<text class="hero-title">请填写请假信息</text>
					<text class="hero-subtitle">请如实填写，以便审批</text>
				</view>
				<image class="hero-illustration" src="/static/leave/apply/2.png" mode="aspectFit"></image>
				<view class="hero-orb hero-orb-small">
				</view>
				<view class="hero-orb hero-orb-large">
				</view>
				<view class="form-card single-card">
					<picker class="field-picker picker-row" :range="leaveTypeNames" @change="leaveTypeChange">
						<view class="field-row">
							<view class="label-wrap">
								<text class="field-label">请假类型</text>
								<text class="required">*</text>
							</view>
							<view class="picker-content">
								<text :class="leaveType == '' ? 'field-placeholder' : 'field-value'">{{ leaveType == '' ? '请选择请假类型     ' : leaveType }}</text>
							</view>
						</view>
					</picker>
				</view>
				<view class="form-card time-card">
					<picker class="field-picker picker-row time-picker-row" mode="date" :value="startPickerDate" @change="startDateChange">
						<view class="field-row time-row">
							<view class="label-wrap">
								<text class="field-label">开始时间</text>
								<text class="required">*</text>
							</view>
							<view class="date-content">
								<view class="time-value-wrap">
									<text :class="startDate == '' ? 'field-placeholder' : 'field-value'">{{ startDate == '' ? '请选择开始时间     ' : startDate }}</text>
								</view>
							</view>
						</view>
					</picker>
					<view class="time-divider">
					</view>
					<picker class="field-picker picker-row time-picker-row" mode="date" :value="endPickerDate" @change="endDateChange">
						<view class="field-row time-row">
							<view class="label-wrap">
								<text class="field-label">结束时间</text>
								<text class="required">*</text>
							</view>
							<view class="date-content">
								<view class="time-value-wrap">
									<text :class="endDate == '' ? 'field-placeholder' : 'field-value'">{{ endDate == '' ? '请选择结束时间     ' : endDate }}</text>
								</view>
							</view>
						</view>
					</picker>
					<view class="time-divider">
					</view>
					<view class="field-row duration-row">
						<text class="field-label">请假时长</text>
						<view class="duration-content">
							<text :class="hasDuration ? 'duration-value' : 'field-placeholder'">{{ hasDuration ? durationText : " " }}</text>
						</view>
					</view>
				</view>
				<view class="form-card single-card">
					<view class="field-row">
						<text class="field-label">影响课程</text>
						<view class="text-field">
							<input class="line-input" v-model="course" maxlength="255" placeholder="请输入影响课程     " placeholder-class="course-placeholder" placeholder-style="text-align:right;color:#a6b6d6" />
						</view>
					</view>
				</view>
				<view class="form-card single-card">
					<view class="field-row">
						<view class="label-wrap">
							<text class="field-label">是否离校</text>
							<text class="required">*</text>
						</view>
						<view class="school-segment">
							<view :class="leaveSchool == '是' ? 'school-option school-option-active' : 'school-option'" @click="setLeaveSchool('是')">
								<text :class="leaveSchool == '是' ? 'school-text school-text-active' : 'school-text'">是</text>
							</view>
							<view :class="leaveSchool == '否' ? 'school-option school-option-active' : 'school-option'" @click="setLeaveSchool('否')">
								<text :class="leaveSchool == '否' ? 'school-text school-text-active' : 'school-text'">否</text>
							</view>
						</view>
					</view>
				</view>
				<view v-if="leaveSchool == '是'" class="form-card single-card destination-card" @click="openDestinationPicker">
					<view class="destination-content">
						<view class="label-wrap">
							<text class="field-label" @click="openDestinationPicker">请假去向</text>
							<text class="required" @click="openDestinationPicker">*</text>
						</view>
						<view class="destination-value-row">
							<text :class="destination == '' ? 'field-placeholder destination-value' : 'field-value destination-value'" @click="openDestinationPicker">{{ destination == '' ? '请选择省 / 市 / 区县' : destination }}</text>
							<view class="destination-arrow" @click="openDestinationPicker"></view>
						</view>
					</view>
				</view>
				<view class="form-card reason-card">
					<view class="label-wrap reason-label">
						<text class="field-label">请假理由</text>
						<text class="required">*</text>
					</view>
					<view class="reason-box">
						<textarea class="reason-input" v-model="reason" maxlength="200" placeholder="请详细说明请假原因" placeholder-class="input-placeholder" />
						<text class="word-count">{{ reason.length }}/200</text>
					</view>
				</view>
				<view class="form-card single-card travel-card">
					<view class="field-row">
						<text class="field-label">出行方式</text>
						<view class="text-field">
							<input class="line-input" v-model="travel" maxlength="255" placeholder="请输入出行方式     " placeholder-class="input-placeholder" />
						</view>
					</view>
				</view>
				<view class="submit-button" @click="submit">
					<text class="submit-text">提交申请</text>
				</view>
			</view>
		</scroll-view>
		<page-container :show="showDestinationPicker" position="bottom" @clickoverlay="cancelDestinationPicker">
			<view class="destination-panel">
				<view class="destination-panel-actions">
					<text class="destination-panel-cancel" @click="cancelDestinationPicker">取消</text>
					<text class="destination-panel-confirm" @click="confirmDestinationPicker">确定</text>
				</view>
				<picker-view class="destination-picker-view" :value="pendingDestinationRegionIndex" indicator-style="height:72rpx" @change="destinationRegionViewChange">
					<picker-view-column>
						<view v-for="(name, index) in destinationRegionOptions[0]" :key="index" class="destination-picker-item">
							<text class="destination-picker-item-text">{{ name }}</text>
						</view>
					</picker-view-column>
					<picker-view-column>
						<view v-for="(name, index) in destinationRegionOptions[1]" :key="index" class="destination-picker-item">
							<text class="destination-picker-item-text">{{ name }}</text>
						</view>
					</picker-view-column>
					<picker-view-column>
						<view v-for="(name, index) in destinationRegionOptions[2]" :key="index" class="destination-picker-item">
							<text class="destination-picker-item-text">{{ name }}</text>
						</view>
					</picker-view-column>
				</picker-view>
			</view>
		</page-container>
	</view>
	</PageTransition>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import PageTransition from '@/components/PageTransition.uvue'
import { createRecord, getLeaveTypes, LeaveTypeOption } from '@/utils/api.uts'
import { cityData } from '@/data/city.uts'

type RegionItem = {
	title: string
	id: string
	children: RegionItem[]
}

const leaveTypes = ref<LeaveTypeOption[]>([])
const leaveType = ref('')
const leaveTypeID = ref(0)
const leaveSchool = ref('是')
const course = ref('')
const reason = ref('')
const travel = ref('')
const destination = ref('')
const destinationRegionIndex = ref<number[]>([0, 0, 0])
const pendingDestinationRegionIndex = ref<number[]>([0, 0, 0])
const showDestinationPicker = ref(false)
const destinationRegionOptions = ref<string[][]>([[], [], []])
const administrativeRegions = JSON.parse<RegionItem[]>(cityData)!
const startDate = ref('')
const endDate = ref('')
const isSubmitting = ref(false)
const appliedAt = ref('')
function twoDigits(value: number): string {
	return value < 10 ? `0${value}` : `${value}`
}
function randomInteger(min: number, max: number): number {
	return Math.floor(Math.random() * (max - min + 1)) + min
}
function formatTime(date: Date): string {
	return `${twoDigits(date.getHours())}:${twoDigits(date.getMinutes())}:${twoDigits(date.getSeconds())}`
}
function withTime(dateValue: string, time: Date): string {
	return `${dateValue} ${formatTime(time)}`
}
const advanceMilliseconds = randomInteger(60 * 60, 2 * 60 * 60) * 1000
const startPickerDate = computed((): string => startDate.value == '' ? '' : startDate.value.slice(0, 10))
const endPickerDate = computed((): string => endDate.value == '' ? '' : endDate.value.slice(0, 10))
const leaveTypeNames = computed((): string[] => leaveTypes.value.map((item): string => item.name))
const durationHours = computed((): number => {
	if (startDate.value == '' || endDate.value == '') return 0
	const difference = new Date(endDate.value.replace(' ', 'T')).getTime() - new Date(startDate.value.replace(' ', 'T')).getTime()
	return difference <= 0 ? 0 : Math.ceil(difference / 3600000)
})
const hasDuration = computed((): boolean => durationHours.value > 0)
const durationDays = computed((): number => Math.floor(durationHours.value / 24))
const remainingDurationHours = computed((): number => durationHours.value % 24)
const durationText = computed((): string => `${durationDays.value}天${remainingDurationHours.value}小时`)
function leaveTypeChange(e: UniPickerChangeEvent) {
	const selected = leaveTypes.value[e.detail.value as number]
	if (selected == null) return
	leaveType.value = selected.name
	leaveTypeID.value = selected.id
}

function startDateChange(e: UniPickerChangeEvent) {
	const earlierTime = new Date(Date.now() - advanceMilliseconds)
	startDate.value = withTime(e.detail.value as string, earlierTime)
}

function endDateChange(e: UniPickerChangeEvent) {
	const earlierTime = new Date(Date.now() - advanceMilliseconds)
	endDate.value = withTime(e.detail.value as string, earlierTime)
}

function setLeaveSchool(value: string) {
	leaveSchool.value = value
}

function setDestinationRegionOptions(provinceIndex: number, cityIndex: number) {
	const province = administrativeRegions[provinceIndex]
	if (province == null) return
	const cities = province.children
	destinationRegionOptions.value[1] = cities.map((item): string => item.title)
	const city = cities[cityIndex]
	destinationRegionOptions.value[2] = city == null ? [] : city.children.map((item): string => item.title)
}

function openDestinationPicker() {
	if (showDestinationPicker.value) return
	pendingDestinationRegionIndex.value = [...destinationRegionIndex.value]
	setDestinationRegionOptions(pendingDestinationRegionIndex.value[0], pendingDestinationRegionIndex.value[1])
	showDestinationPicker.value = true
}

function cancelDestinationPicker() {
	showDestinationPicker.value = false
}

function destinationRegionViewChange(e: UniPickerViewChangeEvent) {
	const selected = e.detail.value
	if (selected.length < 3) return
	const previous = pendingDestinationRegionIndex.value
	// 上级地区变化时，下级索引必须回到新列表的首项。
	if (selected[0] != previous[0]) {
		pendingDestinationRegionIndex.value = [selected[0], 0, 0]
		setDestinationRegionOptions(selected[0], 0)
		return
	}
	if (selected[1] != previous[1]) {
		pendingDestinationRegionIndex.value = [selected[0], selected[1], 0]
		setDestinationRegionOptions(selected[0], selected[1])
		return
	}
	pendingDestinationRegionIndex.value = selected
}

function confirmDestinationPicker() {
	const selected = pendingDestinationRegionIndex.value
	const province = administrativeRegions[selected[0]]
	const city = province == null ? null : province.children[selected[1]]
	const district = city == null ? null : city.children[selected[2]]
	if (province == null || city == null || district == null) return
	destinationRegionIndex.value = [...selected]
	destination.value = `${province.title},${city.title},${district.title}`
	showDestinationPicker.value = false
}

function initializeDestinationRegion() {
	const provinceName = '内蒙古自治区'
	const cityName = '呼和浩特市'
	const districtName = '土默特左旗'
	let provinceIndex = 0
	let cityIndex = 0
	let districtIndex = 0
	for (let i = 0; i < administrativeRegions.length; i++) {
		if (administrativeRegions[i].title == provinceName) {
			provinceIndex = i
			break
		}
	}
	const province = administrativeRegions[provinceIndex]
	if (province != null) {
		for (let i = 0; i < province.children.length; i++) {
			if (province.children[i].title == cityName) {
				cityIndex = i
				break
			}
		}
		const city = province.children[cityIndex]
		if (city != null) {
			for (let i = 0; i < city.children.length; i++) {
				if (city.children[i].title == districtName) {
					districtIndex = i
					break
				}
			}
		}
	}
	destinationRegionIndex.value = [provinceIndex, cityIndex, districtIndex]
	destinationRegionOptions.value[0] = administrativeRegions.map((item): string => item.title)
	setDestinationRegionOptions(provinceIndex, cityIndex)
	destination.value = `${provinceName},${cityName},${districtName}`
}

initializeDestinationRegion()

function goHome() {
	uni.reLaunch({ url: '/pages/home/index' })
}
function toRFC3339(value: string): string {
	return new Date(value.replace(' ', 'T')).toISOString()
}

async function loadLeaveTypes() {
	try {
		leaveTypes.value = await getLeaveTypes()
		if (leaveTypes.value.length == 0) {
			uni.showToast({ title: '暂无可用请假类型', icon: 'none' })
		}
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '请假类型加载失败' : message, icon: 'none' })
	}
}

async function submit() {
	if (isSubmitting.value) return
	if (leaveType.value == '' || leaveTypeID.value == 0) {
		uni.showToast({ title: '请选择请假类型', icon: 'none' })
		return
	}
	if (startDate.value == '' || endDate.value == '') {
		uni.showToast({ title: '请选择请假时间', icon: 'none' })
		return
	}
	if (new Date(endDate.value.replace(' ', 'T')).getTime() <= new Date(startDate.value.replace(' ', 'T')).getTime()) {
		uni.showToast({ title: '结束时间必须晚于开始时间', icon: 'none' })
		return
	}
	if (reason.value.trim() == '') {
		uni.showToast({ title: '请填写请假理由', icon: 'none' })
		return
	}
	if (leaveSchool.value == '是' && destination.value == '') {
		uni.showToast({ title: '请选择请假去向', icon: 'none' })
		return
	}
	isSubmitting.value = true
	try {
		const now = new Date().toISOString()
		const record = await createRecord({
			leave_type_id: leaveTypeID.value,
			start_time: toRFC3339(startDate.value),
			end_time: toRFC3339(endDate.value),
			affected_course: course.value,
			is_leave_school: leaveSchool.value == '是',
			leave_reason: reason.value,
			travel_way: travel.value,
			destination: leaveSchool.value == '是' ? destination.value : '',
			applied_at: appliedAt.value,
			approved_at: now
		})
		uni.navigateTo({ url: `/pages/leave/detail?id=${record.id}` })
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '提交申请失败' : message, icon: 'none' })
	} finally {
		isSubmitting.value = false
	}
}

onLoad(() => {
	appliedAt.value = new Date(Date.now() - advanceMilliseconds).toISOString()
	loadLeaveTypes()
})
</script>

