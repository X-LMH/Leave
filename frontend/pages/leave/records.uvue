<template><view :class="themeClass('records-entry')"></view></template>
<script setup lang="uts">
import { themeClass as resolveThemeClass } from '@/utils/app-theme.uts'
// 兼容旧地址；记录由常驻主页面承载。
onLoad(() => {
	uni.reLaunch({
		url: '/pages/home/index?tab=records',
		fail: () => uni.showToast({ title: '记录页面打开失败，请重试', icon: 'none' })
	})
})

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}
</script>
<style lang="scss">
@import '@/styles/ios-theme.scss';

.records-entry {
	flex: 1;
	background-color: #f2f2f7;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-records-entry {
	background-color: $ios-dark-page;
}
</style>
