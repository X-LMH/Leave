<template>
	<PageTransition ref="pageTransition" enter-direction="forward">
		<view class="compare-page">
			<view class="safe-top" :class="{ 'nav-dark-background': isDarkMode }">
			</view>
			<view class="top-nav-wrap" :class="{ 'nav-dark-background': isDarkMode }">
				<view class="top-nav-content" :class="{ 'nav-dark-background': isDarkMode }">
					<view class="top-back-shaft" :class="{ 'nav-dark-icon': isDarkMode }"></view>
					<view class="top-back-upper" :class="{ 'nav-dark-icon': isDarkMode }"></view>
					<view class="top-back-lower" :class="{ 'nav-dark-icon': isDarkMode }"></view>
					<text class="top-nav-title" :class="{ 'nav-dark-title': isDarkMode }">请销假申请</text>
					<view class="top-more-dots">
						<view class="top-more-dot" :class="{ 'nav-dark-icon': isDarkMode }"></view>
						<view class="top-more-dot" :class="{ 'nav-dark-icon': isDarkMode }"></view>
						<view class="top-more-dot" :class="{ 'nav-dark-icon': isDarkMode }"></view>
					</view>
					<view class="top-nav-divider" :class="{ 'nav-dark-background': isDarkMode }"></view>
					<view class="top-nav-bottom" :class="{ 'nav-dark-background': isDarkMode }"></view>
				</view>
				<view class="top-back-hit" @click="goHome">
				</view>
			</view>
			<!-- 暗色仅作用于原生顶部导航，假条正文保持网页原有配色。 -->
			<web-view
				v-if="webSrc != ''"
				id="leave-detail-web-view"
				class="compare-web-view"
				:src="webSrc"
				:dark-mode="false"
				@loading="fixDetailTextZoom"
				@load="fixDetailTextZoom"
			></web-view>
		</view>
	</PageTransition>
</template>

<script setup lang="uts">
import { ref, nextTick } from 'vue'
// #ifdef APP-ANDROID
import WebView from 'android.webkit.WebView'
// #endif
import PageTransition from '@/components/PageTransition.uvue'
import { getRecord, RecordDetail } from '@/utils/api.uts'

const webSrc = ref('')
const fromRecords = ref(false)
const isDarkMode = ref(false)
let isPageVisible = false

function fixDetailTextZoom() {
	// #ifdef APP-ANDROID
	// 保留修复前手机 0.9 字号下的正文大小，不再跟随系统字体缩放。
	const element = uni.getElementById('leave-detail-web-view')
	element?.getAndroidView<WebView>()?.getSettings()?.setTextZoom(90)
	// #endif
}

function applyNavTheme(theme: string) {
	isDarkMode.value = theme == 'dark'
	// 该 API 作用于栈顶页面，隐藏时只更新本页状态。
	if (!isPageVisible) return
	uni.setNavigationBarColor({
		frontColor: isDarkMode.value ? '#ffffff' : '#000000',
		backgroundColor: isDarkMode.value ? '#000000' : '#ffffff'
	})
}

function syncNavTheme() {
	// #ifdef APP
	const theme = uni.getAppBaseInfo().appTheme
	applyNavTheme(theme == 'auto' ? uni.getDeviceInfo().osTheme ?? 'light' : theme ?? 'light')
	// #endif
}

// #ifdef APP
syncNavTheme()
const appThemeChangeId = uni.onAppThemeChange((result: AppThemeChangeResult) => {
	applyNavTheme(result.appTheme)
})

onUnload(() => {
	uni.offAppThemeChange(appThemeChangeId)
})
// #endif

onShow(() => {
	isPageVisible = true
	syncNavTheme()
	nextTick(() => {
		fixDetailTextZoom()
	})
})

onHide(() => {
	isPageVisible = false
})

function twoDigits(value: number): string {
	return value < 10 ? `0${value}` : `${value}`
}

function formatTime(value: string): string {
	const date = new Date(value)
	if (isNaN(date.getTime())) return '-'
	return `${date.getFullYear()}-${twoDigits(date.getMonth() + 1)}-${twoDigits(date.getDate())} ${twoDigits(date.getHours())}:${twoDigits(date.getMinutes())}:${twoDigits(date.getSeconds())}`
}

function detailApplication(record: RecordDetail): string {
	return JSON.stringify({
		studentName: record.applicant_info.name,
		gender: record.applicant_info.gender,
		parentName: record.applicant_info.parent_name,
		parentPhone: record.applicant_info.parent_phone,
		teacherName: record.applicant_info.teacher_name,
		studentId: record.student_id,
		classInfo: `${record.class_info.college} · ${record.class_info.major} · ${record.class_info.class_name}`,
		leaveType: record.leave_type,
		startDate: formatTime(record.start_time),
		endDate: formatTime(record.end_time),
		durationDays: record.duration_days,
		durationHours: record.duration_hours,
		course: record.affected_course,
		leaveSchool: record.is_leave_school ? '是' : '否',
		reason: record.leave_reason,
		travel: record.travel_way,
		destination: record.destination,
		submitTime: formatTime(record.applied_at),
		approvalTime: formatTime(record.approved_at)
	})
}

function returnToPreviousPage() {
	uni.navigateBack({})
}

async function loadRecord(id: number) {
	try {
		const record = await getRecord(id)
		webSrc.value = `/static/leave/detail/index.html?application=${encodeURIComponent(detailApplication(record))}`
		nextTick(() => {
			fixDetailTextZoom()
		})
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({ title: message == null || message == '' ? '请假记录加载失败' : message, icon: 'none' })
		setTimeout(returnToPreviousPage, 1200)
	}
}

onLoad((options) => {
	fromRecords.value = options?.source == 'records'
	const idText = options?.id ?? '0'
	const id = parseInt(idText, 10)
	if (id <= 0 || Math.floor(id) != id) {
		uni.showToast({ title: '请假记录不存在', icon: 'none' })
		setTimeout(returnToPreviousPage, 1200)
		return
	}
	loadRecord(id)
})
function goHome() {
	if (fromRecords.value) {
		uni.navigateBack({})
		return
	}
	uni.reLaunch({ url: '/pages/home/index' })
}
</script>

<style>
.compare-page {
	flex: 1;
	position: relative;
	background-color: #f6f7fb;
}
.safe-top {
	height:var(--status-bar-height);
	background-color:#fff
}
.top-nav-wrap {
	position: relative;
	/* 原图 1260 × 164，按 750rpx 等比换算，并保留原来的 4px 上移及占高。 */
	height: 97.619rpx;
	margin-bottom: -4px;
	flex-shrink: 0;
	background-color: #fff;
}
.top-nav-content {
	position: absolute;
	left: 0;
	top: -4px;
	width: 100%;
	height: 97.619rpx;
	background-color: #fff;
}
.top-back-shaft {
	position: absolute;
	left: 26.19rpx;
	top: 50.595rpx;
	width: 27.976rpx;
	height: 2.679rpx;
	border-radius: 1.34rpx;
	background-color: #000;
	/* 保留亚像素线宽，避免 Android 布局取整后比原图偏粗。 */
	transform: scaleY(0.92);
}
.top-back-upper {
	position: absolute;
	left: 22.916rpx;
	top: 44.048rpx;
	width: 19.048rpx;
	height: 2.679rpx;
	border-radius: 1.34rpx;
	background-color: #000;
	transform: rotate(-45deg) scaleY(0.92);
}
.top-back-lower {
	position: absolute;
	left: 22.916rpx;
	top: 57.143rpx;
	width: 19.048rpx;
	height: 2.679rpx;
	border-radius: 1.34rpx;
	background-color: #000;
	transform: rotate(45deg) scaleY(0.92);
}
.top-nav-title {
	position: absolute;
	/* Android 实机对照原图校准字重、字面宽度及基线。 */
	left: -1.19rpx;
	top: 30.357rpx;
	width: 100%;
	height: 42.857rpx;
	line-height: 42.857rpx;
	text-align: center;
	font-size: 30.952rpx;
	font-weight: 700;
	color: #000;
	transform: scale(1.02);
}
.top-more-dots {
	position: absolute;
	left: 702.381rpx;
	top: 34.524rpx;
	width: 7.143rpx;
	height: 34.524rpx;
	justify-content: space-between;
}
.top-more-dot {
	width: 7.143rpx;
	height: 7.143rpx;
	border-radius: 3.572rpx;
	background-color: #000;
}
.top-nav-divider {
	position: absolute;
	left: 0;
	bottom: 1.19rpx;
	width: 100%;
	height: 0.595rpx;
	background-color: #c7c9cc;
}
.top-nav-bottom {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	height: 1.19rpx;
	background-color: #f4f5fa;
}
.top-back-hit {
	position:absolute;
	left:0;
	top:0;
	width:120rpx;
	height:100%;
	z-index:2
}
.compare-web-view {
	flex:1
}
.nav-dark-background {
	background-color: #000;
}
.nav-dark-icon {
	background-color: #f8f8f8;
}
.nav-dark-title {
	color: #f8f8f8;
}
</style>
