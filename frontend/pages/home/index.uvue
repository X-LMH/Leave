<template>
	<PageTransition enter-direction="peer">
		<view class="tab-shell">
			<view v-show="activeTab == 'home'" class="tab-panel">
				<HomeTabContent ref="homeContent" />
			</view>
			<view v-if="profileVisited" v-show="activeTab == 'profile'" class="tab-panel">
				<ProfileTabContent ref="profileContent" :active="activeTab == 'profile'" />
			</view>
			<BottomNavigation ref="bottomNavigation" :active="activeTab" @navigate="handleTabNavigation" />
		</view>
	</PageTransition>
</template>

<script setup lang="uts">
import { nextTick, ref } from 'vue'
import BottomNavigation from '@/components/BottomNavigation.uvue'
import HomeTabContent from '@/components/HomeTabContent.uvue'
import ProfileTabContent from '@/components/ProfileTabContent.uvue'
import PageTransition from '@/components/PageTransition.uvue'

const activeTab = ref('home')
const profileVisited = ref(false)
const homeContent = ref<ComponentPublicInstance | null>(null)
const profileContent = ref<ComponentPublicInstance | null>(null)
const bottomNavigation = ref<ComponentPublicInstance | null>(null)
let pageReady = false

function refreshActiveTab() {
	if (activeTab.value == 'profile') {
		profileContent.value?.$callMethod('refresh')
	} else {
		homeContent.value?.$callMethod('refresh')
	}
}

function handleTabNavigation(url: string) {
	const nextTab = url == '/pages/profile/index' ? 'profile' : 'home'
	if (activeTab.value == nextTab) return
	if (nextTab == 'profile') profileVisited.value = true
	activeTab.value = nextTab
	// 仅切换保留的内容面板，导航和各页滚动容器不销毁。
	nextTick(() => refreshActiveTab())
}

onLoad((options) => {
	if (options['tab'] == 'profile') {
		profileVisited.value = true
		activeTab.value = 'profile'
	}
})
onReady(() => {
	pageReady = true
	refreshActiveTab()
})
onShow(() => {
	if (pageReady) refreshActiveTab()
})
onResize(() => {
	bottomNavigation.value?.$callMethod('updateLayout')
})
</script>

<style>
.tab-shell {
	position: relative;
	flex: 1;
	overflow: hidden;
	background-color: #f5f5f7;
}
.tab-panel {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
}
</style>
