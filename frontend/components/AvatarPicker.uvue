<template>
	<view :class="themeClass('avatar-picker')">
		<view :class="themeClass(props.compact == true ? 'avatar-frame avatar-frame-compact' : 'avatar-frame')">
			<image
				v-if="previewURL != '' && !previewFailed"
				:class="themeClass(props.compact == true ? 'avatar-preview avatar-preview-compact' : 'avatar-preview')"
				:src="themeImage(previewURL)"
				mode="aspectFill"
				@error="handlePreviewError"
			/>
			<view
				v-else
				:class="themeClass(props.compact == true
						? 'avatar-preview avatar-preview-compact avatar-placeholder'
						: 'avatar-preview avatar-placeholder')"
			>
				<text :class="themeClass('avatar-placeholder-text')">
					{{ props.initial == null || props.initial == '' ? '同' : props.initial.slice(0, 1) }}
				</text>
			</view>
		</view>
		<view
			:class="themeClass('avatar-select')"
			@click="choose"
		>
			<text :class="themeClass('avatar-select-text')">{{ choosing ? '正在读取图片…' : '选择头像' }}</text>
		</view>
		<text
			v-if="props.compact != true"
			:class="themeClass('avatar-hint')"
		>
			支持相册或拍照，JPEG / PNG，不超过 5 MiB
		</text>
		<text
			v-if="props.compact != true"
			:class="themeClass('avatar-hint')"
		>
			图片宽高分别不超过 4096 像素
		</text>
	</view>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { computed, ref, watch } from 'vue'
import { chooseAvatarImage } from '@/utils/avatar-picker.uts'
import { getAvatarDisplayURL } from '@/utils/avatar-cache.uts'

const props = defineProps<{
	avatarUrl: string
	filePath: string
	disabled: boolean
	compact?: boolean
	initial?: string
}>()
const emit = defineEmits(['select', 'busy', 'previewError'])
const choosing = ref(false)
const previewFailed = ref(false)
const previewURL = computed((): string => {
	if (props.filePath != '') return props.filePath
	// 未上传头像时使用姓名首字，服务器默认图片不作为用户头像。
	return getAvatarDisplayURL(props.avatarUrl)
})

watch(
	(): string => props.filePath,
	() => {
		previewFailed.value = false
	}
)

watch(
	(): string => props.avatarUrl,
	() => {
		previewFailed.value = false
	}
)

function handlePreviewError() {
	previewFailed.value = true
	if (props.filePath == '') emit('previewError')
}

async function choose() {
	if (props.disabled || choosing.value) return
	choosing.value = true
	emit('busy', true)
	try {
		const path = await chooseAvatarImage()
		if (path != '') emit('select', path)
	} finally {
		choosing.value = false
		emit('busy', false)
	}
}

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
@import '@/styles/ios-theme.scss';

.avatar-picker {
	box-sizing: border-box;
	padding: 14px 0 12px;
	align-items: center;
}
.avatar-preview {
	box-sizing: border-box;
	width: 180rpx;
	height: 180rpx;
	border-radius: 90rpx;
	background-color: #dce0e8;
}
.avatar-frame {
	width: 180rpx;
	height: 180rpx;
}
.avatar-frame-compact {
	box-sizing: border-box;
	width: 88px;
	height: 88px;
	border-radius: 44px;
}
.avatar-preview-compact {
	box-sizing: border-box;
	width: 88px;
	height: 88px;
	border-radius: 44px;
}
.avatar-placeholder {
	align-items: center;
	justify-content: center;

	background-color: #5265a2;

	border: 1px solid #8290bb;
}
.avatar-placeholder-text {
	font-size: 43px;
	font-weight: 500;

	color: #ffffff;
}
.avatar-select {
	box-sizing: border-box;
	height: 44px;
	margin-top: 6px;
	padding: 8px 0;
	align-items: center;
	justify-content: center;
}
.avatar-select-text {
	font-size: 15px;
	color: #0066dc;
}
.avatar-hint {
	margin-top: 14rpx;
	font-size: 22rpx;
	color: #7890bc;
	text-align: center;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-avatar-preview {
	background-color: $ios-dark-panel;
}
.dark-avatar-select-text {
	color: $ios-dark-blue;
}
.dark-avatar-hint {
	color: $ios-dark-secondary;
}
.contrast-avatar-hint {
	color: #d2d3dc;
}
</style>
