<template>
	<scroll-view
		class="overview-scroll"
		:style="'height:' + height + 'px;'"
		:scroll-y="!dragging"
		:refresher-enabled="!dragging"
		:android-refresher-color="themeState.isDark ? '#6aa9ff' : '#0066dc'"
		:refresher-triggered="busy"
		@refresherrefresh="refresh"
	>
		<view class="overview-content">
			<view :class="themeClass('overview-metrics')">
				<view
					v-for="(stat, index) in stats"
					:key="stat.label"
					:class="
						themeClass(
							index == 0
								? 'overview-metric'
								: 'overview-metric overview-metric-divided',
						)
					"
					role="button"
					:aria-label="stat.label + '，' + stat.value + '，点击查看'"
					@click="openMetric(index)"
				>
					<text :class="themeClass('overview-value')">{{ stat.value }}</text
					><text :class="themeClass('overview-muted')">{{ stat.label }}</text>
				</view>
			</view>
			<text v-if="error != ''" class="overview-error" @click="refresh"
				>{{ error }} · 点击重试</text
			>
			<template v-if="loaded">
				<view :class="themeClass('overview-card')">
					<view class="overview-heading-row"
						><text :class="themeClass('overview-heading')">请假申请趋势</text
						><text :class="themeClass('overview-muted')">每周申请量</text></view
					>
					<view class="trend-summary">
						<text :class="themeClass('overview-total')"
							>{{ applicationTotal }} 份</text
						>
						<text :class="themeClass('overview-muted')">近8周及本周累计</text>
					</view>
					<view v-if="weeks.length > 0" :class="themeClass('trend-detail')">
						<view class="trend-detail-heading">
							<text :class="themeClass('trend-detail-label')">{{
								selectedLabel
							}}</text>
							<text v-if="selectedCurrent" :class="themeClass('trend-badge')"
								>进行中</text
							>
							<text :class="themeClass('trend-detail-count')"
								>{{ selectedCount }} 份</text
							>
						</view>
						<text :class="themeClass('overview-muted')">{{
							selectedCaption
						}}</text>
					</view>
					<view
						v-if="weeks.length > 0"
						id="overview-trend-chart"
						class="trend-chart"
						@touchstart="trendTouchStart"
						@touchmove="trendTouchMove"
						@touchend="trendTouchEnd"
						@touchcancel="trendTouchCancel"
					>
						<template v-if="chartWidth > 0">
							<view
								v-for="tick in [0, 1, 2]"
								:key="tick"
								class="trend-grid-row"
								:style="
									'top:' + (8 + tick * 65) + 'px;width:' + chartWidth + 'px;'
								"
							>
								<text :class="themeClass('trend-axis')">{{
									Math.round((maximum * (2 - tick)) / 2)
								}}</text
								><view
									:class="themeClass('trend-grid')"
									:style="
										'width:' + Math.max(1, chartWidth - axisWidth) + 'px;'
									"
								></view>
							</view>
							<view
								:class="themeClass('trend-guide')"
								:style="'left:' + pointX(selectedWeek) + 'px;'"
							></view>
							<template v-for="(week, index) in weeks" :key="week.start">
								<view
									v-if="index > 0"
									:class="
										themeClass(
											week.current
												? 'trend-segment trend-current'
												: 'trend-segment',
										)
									"
									:style="segmentStyle(index)"
									><view
										v-if="week.current"
										v-for="dash in [0, 1, 2, 3, 4, 5]"
										:key="dash"
										:class="themeClass('trend-dash')"
									></view
								></view>
								<view
									:class="
										themeClass(
											selectedWeek == index
												? 'trend-point trend-selected'
												: 'trend-point',
										)
									"
									:style="pointStyle(index)"
									><view :class="themeClass('trend-point-dot')"></view
								></view>
								<text
									v-if="showWeekLabel(index)"
									:class="
										themeClass(
											selectedWeek == index
												? 'trend-date trend-date-selected'
												: 'trend-date',
										)
									"
									:style="'left:' + (pointX(index) - 20) + 'px;'"
									>{{ weekLabel(index) }}</text
								>
							</template>
							<view
								v-for="(week, index) in weeks"
								:key="'hit-' + week.start"
								class="trend-hit"
								:style="hitStyle(index)"
								role="button"
								:aria-label="
									week.start +
									'至' +
									week.end +
									'，' +
									week.count +
									'份' +
									(selectedWeek == index ? '，已选中' : '')
								"
								@click="selectWeek(index)"
							></view>
						</template>
					</view>
					<text v-if="weeks.length == 0" :class="themeClass('overview-muted')">暂无趋势数据</text>
				</view>
				<view :class="themeClass('overview-card')">
					<text :class="themeClass('overview-heading')"
						>客户端版本使用情况</text
					>
					<view class="overview-heading-row"
						><text :class="themeClass('overview-value')">{{ coverage }}</text
						><text :class="themeClass('overview-muted')">{{
							latestVersion == ''
								? '暂无已发布版本'
								: '当前版本 ' + latestVersion
						}}</text></view
					>
					<text :class="themeClass('overview-muted')">最新版覆盖率</text>
					<view v-if="versionTotal > 0" class="version-bar"
						><view
							v-for="group in versionGroups"
							:key="group.key"
							:style="versionBarStyle(group)"
						></view
					></view>
					<view
						v-for="group in versionGroups"
						:key="group.key"
						class="version-row"
						><view
							class="version-dot"
							:style="'background-color:' + versionColor(group.key) + ';'"
						></view
						><text :class="themeClass('version-label')">{{
							versionLabel(group)
						}}</text
						><text :class="themeClass('overview-text')"
							>{{ group.count }} 人</text
						></view
					>
					<text v-if="versionTotal == 0" :class="themeClass('overview-muted')"
						>暂无版本上报数据</text
					>
				</view>
			</template>
			<text v-else-if="busy" :class="themeClass('overview-muted')"
				>正在加载统计…</text
			>
		</view>
	</scroll-view>
</template>
<script setup lang="uts">
import { ref, computed, watch, nextTick, onMounted, onUnmounted } from 'vue'
import { onReady, onResize } from '@dcloudio/uni-app'
import { themeClass as resolveThemeClass, themeState } from '@/utils/app-theme.uts'
import {
	AdminField,
	AdminWeek,
	AdminVersionGroup,
	adminOverview,
	adminRevision,
	adminSession,
	requireAdmin,
} from '@/utils/admin-api.uts'
const props = defineProps<{ active: boolean; height: number }>()
const emit = defineEmits(['navigate'])
const stats = ref<AdminField[]>([
	{ label: '学生', value: '—' },
	{ label: '假条', value: '—' },
	{ label: '未处理反馈', value: '—' },
])
const weeks = ref<AdminWeek[]>([])
const versionGroups = ref<AdminVersionGroup[]>([])
const applicationTotal = ref(0)
const versionTotal = ref(0)
const latestCount = ref(0)
const latestVersion = ref('')
const selectedWeek = ref(0)
const chartWidth = ref(0)
const dragging = ref(false)
const busy = ref(false)
const loaded = ref(false)
const error = ref('')
let sequence = 0
let revision = -1
let session = ''
let gesture = ''
let startX = 0
let startY = 0
let chartLeft = 0
let suppressClickUntil = 0
function themeClass(value: string): string {
	return resolveThemeClass(value)
}
const maximum = computed((): number => {
	let max = 0
	for (const week of weeks.value) max = Math.max(max, week.count)
	return Math.max(2, Math.ceil(max / 2) * 2)
})
const axisWidth = computed((): number =>
	Math.max(30, maximum.value.toString().length * 6 + 10),
)
function measureChart() {
	const rect = uni.getElementById('overview-trend-chart')?.getBoundingClientRect()
	if (rect != null && rect.width > 0) {
		chartWidth.value = rect.width
		chartLeft = rect.left
	}
}
function plotWidth(): number {
	return Math.max(1, chartWidth.value - axisWidth.value - 32)
}
const coverage = computed((): string =>
	versionTotal.value == 0 || latestVersion.value == ''
		? '—'
		: ((latestCount.value / versionTotal.value) * 100).toFixed(1) + '%',
)
function pointX(index: number): number {
	return (
		axisWidth.value + 12 +
		(weeks.value.length <= 1
			? plotWidth() / 2
			: (index * plotWidth()) / (weeks.value.length - 1))
	)
}
function pointY(index: number): number {
	return 144 - (weeks.value[index].count / maximum.value) * 130
}
function pointStyle(index: number): string {
	return (
		'left:' + (pointX(index) - 12) + 'px;top:' + (pointY(index) - 12) + 'px;'
	)
}
// 使用原生视图绘制九个节点，避免引入图表依赖或 WebView 滚动容器。
function segmentStyle(index: number): string {
	const dx = pointX(index) - pointX(index - 1)
	const dy = pointY(index) - pointY(index - 1)
	const length = Math.sqrt(dx * dx + dy * dy)
	return (
		'left:' +
		(pointX(index) + pointX(index - 1) - length) / 2 +
		'px;top:' +
		((pointY(index) + pointY(index - 1)) / 2 - 1) +
		'px;width:' +
		length +
		'px;transform:rotate(' +
		(Math.atan2(dy, dx) * 180) / Math.PI +
		'deg);'
	)
}
function weekLabel(index: number): string {
	const week = weeks.value[index]
	return week.current ? '本周' : week.start.substring(5, 10).replace('-', '/')
}
function showWeekLabel(index: number): boolean {
	const last = weeks.value.length - 1
	if (index == 0 || index == last) return true
	const spacing = plotWidth() / Math.max(1, last)
	const step = Math.max(1, Math.ceil(52 / spacing))
	return index % step == 0 && pointX(last) - pointX(index) >= 52
}
function hitStyle(index: number): string {
	const left = index == 0
		? axisWidth.value
		: (pointX(index - 1) + pointX(index)) / 2
	const right = index == weeks.value.length - 1
		? chartWidth.value
		: (pointX(index) + pointX(index + 1)) / 2
	return 'left:' + left + 'px;width:' + (right - left) + 'px;'
}
function selectWeek(index: number) {
	if (Date.now() < suppressClickUntil) return
	selectedWeek.value = index
}
function selectAt(pageX: number) {
	if (weeks.value.length == 0) return
	const position = (pageX - chartLeft - pointX(0)) / plotWidth()
	selectedWeek.value = Math.max(
		0,
		Math.min(weeks.value.length - 1, Math.round(position * (weeks.value.length - 1))),
	)
}
function trendTouchCancel() {
	gesture = ''
	dragging.value = false
	suppressClickUntil = Date.now() + 350
}
function trendTouchStart(event: UniTouchEvent) {
	if (event.touches.length != 1) {
		trendTouchCancel()
		return
	}
	measureChart()
	startX = event.touches[0].pageX
	startY = event.touches[0].pageY
	gesture = 'pending'
}
function trendTouchMove(event: UniTouchEvent) {
	if (gesture == '') return
	if (event.touches.length != 1) {
		trendTouchCancel()
		return
	}
	const touch = event.touches[0]
	const dx = Math.abs(touch.pageX - startX)
	const dy = Math.abs(touch.pageY - startY)
	if (gesture == 'pending') {
		if (Math.max(dx, dy) <= 8) return
		if (dy >= dx) {
			trendTouchCancel()
			return
		}
		gesture = 'horizontal'
		dragging.value = true
	}
	event.preventDefault()
	selectAt(touch.pageX)
}
function trendTouchEnd(event: UniTouchEvent) {
	if (event.touches.length > 0) {
		trendTouchCancel()
		return
	}
	if (gesture == 'horizontal' && event.changedTouches.length > 0)
		selectAt(event.changedTouches[0].pageX)
	if (gesture == '') suppressClickUntil = Date.now() + 350
	if (gesture == 'horizontal') suppressClickUntil = Date.now() + 350
	gesture = ''
	dragging.value = false
}
const selectedCount = computed((): number =>
	weeks.value.length == 0 ? 0 : weeks.value[selectedWeek.value].count,
)
const selectedCurrent = computed((): boolean =>
	weeks.value.length > 0 && weeks.value[selectedWeek.value].current,
)
const selectedLabel = computed((): string =>
	selectedCurrent.value ? '本周申请' : '所选周申请',
)
const selectedCaption = computed((): string => {
	if (weeks.value.length == 0) return ''
	const week = weeks.value[Math.min(selectedWeek.value, weeks.value.length - 1)]
	return (
		week.start.substring(0, 10) +
		' — ' +
		week.end.substring(0, 10)
	)
})
function versionColor(key: string): string {
	return key == 'latest'
		? '#408cf2'
		: key == 'previous'
			? '#87b8f5'
			: key == 'older'
				? '#a8caf2'
				: key == 'unreported'
					? '#a3a8b2'
					: '#737c8c'
}
function versionBarStyle(group: AdminVersionGroup): string {
	return (
		'height:12px;flex-grow:' +
		group.count +
		';background-color:' +
		versionColor(group.key) +
		';'
	)
}
function versionLabel(group: AdminVersionGroup): string {
	const label =
		group.key == 'latest'
			? '最新版'
			: group.key == 'previous'
				? '上一版'
				: group.key == 'older'
					? '更早版本'
					: group.key == 'unreported'
						? '未上报'
						: '其他版本'
	return label + (group.version == '' ? '' : ' ' + group.version)
}
function openMetric(index: number) {
	emit('navigate', index == 0 ? 'students' : index == 1 ? 'records' : 'pending')
}
async function load(force: boolean = false) {
	if (!props.active || busy.value) return
	trendTouchCancel()
	const seq = ++sequence
	const key = adminSession()
	const dataRevision = adminRevision
	busy.value = true
	error.value = ''
	try {
		if (
			!(await requireAdmin()) ||
			!props.active ||
			seq != sequence ||
			key != adminSession() ||
			dataRevision != adminRevision
		) return
		const data = await adminOverview(force)
		if (
			!props.active ||
			sequence != seq ||
			key != adminSession() ||
			dataRevision != adminRevision
		) return
		stats.value = [
			{ label: '学生', value: data.studentCount.toString() },
			{ label: '假条', value: data.recordCount.toString() },
			{ label: '未处理反馈', value: data.unhandledFeedbackCount.toString() },
		]
		selectedWeek.value = 0
		weeks.value = data.weeks
		applicationTotal.value = data.applicationTotal
		versionGroups.value = data.versionGroups
		versionTotal.value = data.versionTotal
		latestCount.value = data.latestCount
		latestVersion.value = data.latestVersion
		selectedWeek.value = Math.max(0, data.weeks.length - 1)
		for (let i = 0; i < data.weeks.length; i++) {
			if (data.weeks[i].current) selectedWeek.value = i
		}
		revision = dataRevision
		session = key
		loaded.value = true
		nextTick(() => measureChart())
	} catch (e) {
		if (props.active && sequence == seq && key == adminSession())
			error.value = (e as Error).message
	} finally {
		if (sequence == seq) busy.value = false
	}
}
function refresh() {
	load(true)
}
watch(
	(): number => props.height,
	() => {
		nextTick(() => measureChart())
	},
)
watch(
	(): boolean => props.active,
	(active: boolean) => {
		if (!active) {
			trendTouchCancel()
			sequence++
			busy.value = false
			return
		}
		nextTick(() => measureChart())
		if (session != adminSession()) {
			loaded.value = false
			weeks.value = []
			versionGroups.value = []
		}
		if (revision != adminRevision || session != adminSession()) load()
	},
	{ immediate: true },
)
onMounted(() => {
	nextTick(() => measureChart())
})
onReady(() => measureChart())
onResize((_options: OnResizeOptions) => {
	nextTick(() => measureChart())
})
onUnmounted(() => {
	sequence++
})
</script>
<style lang="scss">
@import '@/styles/ios-theme.scss';
.overview-scroll {
	flex-shrink: 0;
}
.overview-content {
	padding-bottom: 110px;
}
