	color: $ios-ink;
	font-size: 29px;
	font-weight: 600;
	margin-bottom: 2px;
}
.trend-summary {
	margin-top: 6px;
	margin-bottom: 18px;
}
.trend-detail {
	background-color: #f2f6fc;
	border-radius: 14px;
	padding: 12px;
}
.trend-detail-heading {
	flex-direction: row;
	align-items: center;
	margin-bottom: 4px;
}
.trend-detail-label {
	color: $ios-ink;
	font-size: 13px;
	font-weight: 500;
}
.trend-badge {
	margin-left: 8px;
	color: $ios-blue;
	font-size: 10px;
}
.trend-detail-count {
	flex: 1;
	text-align: right;
	color: $ios-blue;
	font-size: 21px;
	font-weight: 600;
}
.trend-chart {
	height: 184px;
	margin-top: 18px;
	position: relative;
}
.trend-grid-row {
	position: absolute;
	left: 0;
	height: 12px;
	flex-direction: row;
	align-items: center;
}
