	margin-right: 2px;
	background-color: $ios-blue;
}
.trend-guide {
	position: absolute;
	top: 10px;
	height: 136px;
	width: 1px;
	background-color: #c4d9f4;
}
.trend-hit {
	position: absolute;
	top: 0;
	height: 184px;
}
.trend-point {
	position: absolute;
	width: 24px;
	height: 24px;
	border-radius: 12px;
	align-items: center;
	justify-content: center;
}
.trend-selected {
	background-color: rgba(64, 140, 242, 0.18);
}
.trend-point-dot {
	width: 7px;
