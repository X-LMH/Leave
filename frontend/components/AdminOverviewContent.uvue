	color: $ios-secondary;
	font-size: 12px;
	line-height: 20px;
}
.overview-text {
	color: $ios-ink;
	font-size: 14px;
}
.overview-card {
	padding: 20px 16px;
	border-radius: 22px;
	background-color: $ios-surface;
	margin-bottom: 14px;
}
.overview-heading-row {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
