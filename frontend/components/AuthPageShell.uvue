<template>
	<PageTransition ref="pageTransition" :enter-direction="enterDirection">
	<view class="auth-page">
		<image class="auth-background" src="/static/auth/background.png" mode="aspectFill"></image>
		<view class="auth-safe-top"></view>
		<view class="auth-content">
			<view class="auth-heading">
				<view class="auth-brand-row">
					<view class="auth-brand-halo">
						<view class="auth-brand-icon">
							<view class="auth-brand-icon-center"></view>
						</view>
					</view>
					<view class="auth-brand-label">
						<view class="auth-brand-label-dot"></view>
						<text class="auth-brand-label-text">LEAVE MANAGEMENT</text>
					</view>
				</view>
				<text class="auth-title">{{ title }}</text>
				<text class="auth-subtitle">{{ subtitle }}</text>
			</view>
			<view class="auth-form-card" :class="cardClass">
				<view class="auth-card-accent">
					<view class="auth-card-accent-main"></view>
					<view class="auth-card-accent-dot"></view>
				</view>
				<slot></slot>
			</view>
			<slot name="card-footer"></slot>
			<view class="auth-submit-button" @click="submit">
				<view class="auth-button-light"></view>
				<text class="auth-submit-text">{{ buttonText }}</text>
				<view class="auth-button-arrow">
					<text class="auth-button-arrow-text">→</text>
				</view>
			</view>
			<view class="auth-switch-row" @click="switchPage">
				<text class="auth-switch-prefix">{{ switchPrefix }}</text>
				<text class="auth-switch-action">{{ switchText }}</text>
			</view>
		</view>
	</view>
	</PageTransition>
</template>

<script setup lang="uts">
import PageTransition from '@/components/PageTransition.uvue'

defineProps<{
	title: string
	subtitle: string
	buttonText: string
	switchPrefix: string
	switchText: string
	cardClass: string
	enterDirection: string
}>()

const emit = defineEmits(['submit', 'switch-page'])
function navigate(url: string, method: string = 'navigateTo', direction: string = 'forward') {
	if (method == 'reLaunch') uni.reLaunch({ url: url })
	else if (method == 'redirectTo') uni.redirectTo({ url: url })
	else if (method == 'navigateBack') uni.navigateBack({})
	else uni.navigateTo({ url: url })
}

function submit() {
	emit('submit')
}

function switchPage() {
	emit('switch-page')
}

defineExpose({ navigate })
</script>

<style>
.auth-page { position: relative; flex: 1; overflow: hidden; background-color: #f4f7ff; }
.auth-background { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.auth-safe-top { height: var(--status-bar-height); }
.auth-content { position: relative; z-index: 1; flex: 1; box-sizing: border-box; padding: 28rpx 28rpx 44rpx; justify-content: center; }
.auth-heading { margin-left: 30rpx; }
.auth-brand-row { height: 104rpx; margin-bottom: -28rpx; flex-direction: row; align-items: flex-start; }
