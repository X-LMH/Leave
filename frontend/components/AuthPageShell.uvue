<template>
	<PageTransition enter-direction="forward">
		<view :class="themeClass('auth-page')">
			<view :class="themeClass('auth-safe-top')"></view>
			<scroll-view
				:class="themeClass('auth-scroll')"
				scroll-y="true"
				:show-scrollbar="false"
				:scroll-into-view="scrollTarget"
			>
				<view
					:class="themeClass('auth-content')"
					:style="contentStyle"
				>
					<view :class="themeClass('auth-heading')">
						<AppBrand
							:app-icon="true"
							:subtitle="registering ? '创建账号，开始使用校园请假' : '使用学号登录，管理你的请假'"
						/>
					</view>
					<view
						:class="themeClass('auth-segment')"
						role="tablist"
					>
						<view
							:class="themeClass(registering ? 'auth-option' : 'auth-option auth-option-selected')"
							role="tab"
							:aria-selected="!registering"
							@click="chooseMode(false)"
						>
							<text
								:class="themeClass(registering ? 'auth-option-text' : 'auth-option-text auth-option-text-selected')"
							>
								登录
							</text>
						</view>
						<view
							:class="themeClass(registering ? 'auth-option auth-option-selected' : 'auth-option')"
							role="tab"
							:aria-selected="registering"
							@click="chooseMode(true)"
						>
							<text
								:class="themeClass(registering ? 'auth-option-text auth-option-text-selected' : 'auth-option-text')"
							>
								注册
							</text>
						</view>
					</view>
					<view :class="themeClass('auth-form-card')"><slot></slot></view>
					<text
						v-if="errorMessage != ''"
						:class="themeClass('form-error')"
					>
						{{ errorMessage }}
					</text>
					<view
						:class="themeClass(busy ? 'primary-button auth-submit primary-button-disabled' : 'primary-button auth-submit')"
						hover-class="auth-submit-pressed"
						:hover-stay-time="80"
						role="button"
						:aria-label="buttonText"
						@click="submit"
					>
						<text :class="themeClass('primary-button-text')">{{ buttonText }}</text>
					</view>
				</view>
			</scroll-view>
		</view>
	</PageTransition>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass } from '@/utils/app-theme.uts'
import PageTransition from '@/components/PageTransition.uvue'
import AppBrand from '@/components/AppBrand.uvue'
const props = withDefaults(
	defineProps<{
		buttonText: string
		registering: boolean
		busy: boolean
		errorMessage?: string
		scrollTarget?: string
	}>(),
	{ errorMessage: '', scrollTarget: '' }
)
const emit = defineEmits(['submit', 'switch-page'])
const contentStyle =
	'padding-top:' + Math.min(48, Math.max(24, uni.getWindowInfo().windowHeight * 0.05)) + 'px;'
function chooseMode(registering: boolean) {
	if (!props.busy && registering != props.registering) emit('switch-page')
}
function submit() {
	if (!props.busy) emit('submit')
}

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}
</script>
<style lang="scss">
@import '@/styles/ios-controls.scss';
.auth-page {
	flex: 1;
	background-color: $ios-page;
}
.auth-safe-top {
	height: var(--status-bar-height);
}
.auth-scroll {
	flex: 1;
}
.auth-content {
	box-sizing: border-box;
	width: 100%;
	max-width: 440px;
	align-self: center;
	padding: 40px 24px 32px;
}
.auth-heading {
	box-sizing: border-box;
	padding-bottom: 28px;
	align-items: center;
}
.auth-segment {
	box-sizing: border-box;
	flex-direction: row;
	padding: 3px;
	border-radius: 12px;
	background-color: #e7e7ed;
	margin-bottom: 20px;
}
.auth-option {
	box-sizing: border-box;
	flex: 1;
	height: 44px;
	border-radius: 9px;
	align-items: center;
	justify-content: center;
}
.auth-option-selected {
	background-color: $ios-surface;
	box-shadow: 0 2px 5px rgba(21, 27, 40, 0.07);
}
.auth-option-text {
	color: $ios-secondary;
	font-size: 16px;
	font-weight: 600;
}
.auth-option-text-selected {
	color: $ios-ink;
}
.auth-form-card {
	box-sizing: border-box;
	background-color: $ios-surface;
	border-radius: 16px;
	padding: 0 16px;
}
.auth-submit {
	min-height: 52px;
	border-radius: 14px;
	margin-top: 24px;
}
.auth-submit-pressed {
	opacity: 0.8;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-auth-page {
	background-color: $ios-dark-page;
}
.dark-auth-segment {
	background-color: $ios-dark-panel;
}
.dark-auth-option-selected {
	background-color: $ios-dark-surface;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
}
.dark-auth-option-text {
	color: $ios-dark-secondary;
}
.dark-auth-option-text-selected {
	color: $ios-dark-ink;
}
.dark-auth-form-card {
	background-color: $ios-dark-surface;
}
.contrast-auth-option-text {
	color: #d2d3dc;
}
.contrast-auth-option-text-selected {
	color: #ffffff;
}
</style>
