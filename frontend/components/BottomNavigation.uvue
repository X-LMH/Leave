<template>
	<view
		:class="themeClass('navigation-dock')"
		:style="dockStyle"
	>
		<view
			:class="themeClass(navigationClass)"
			:style="navigationStyle"
			@touchstart="handleTouchStart"
			@touchmove="handleTouchMove"
			@touchend="handleTouchEnd"
			@touchcancel="handleTouchCancel"
		>
			<view
				:class="themeClass('nav-glass-sheen')"
				:style="sheenStyle"
			></view>
			<view
				:class="themeClass(selectionClass)"
				:style="selectionStyle"
			></view>
			<view
				:class="themeClass('nav-items')"
				role="tablist"
			>
                <view v-for="(item, index) in items" :key="item.key" :id="item.id"
                    :class="themeClass('nav-item')" role="tab" :aria-label="item.label" :aria-selected="active == item.key"
                    @touchstart.stop="handleTouchStart" @touchmove.stop="handleTouchMove"
                    @touchend.stop="handleTouchEnd" @touchcancel.stop="handleTouchCancel" @click="selectTab(index)">
                    <image :class="themeClass(iconClass(index))" :src="themeImage(selectedIndex == index ? item.selectedIcon : item.icon)" mode="aspectFit" />
                    <text :class="themeClass(labelClass(index))">{{ item.label }}</text>
                </view>
			</view>
		</view>
		<view
			v-if="mode != 'admin'"
			:class="themeClass('nav-create')"
			role="button"
			aria-label="申请请假"
			@click="emit('create')"
		>
			<image
				:class="themeClass('nav-create-symbol')"
				:src="themeImage('/static/ios/plus-white.svg')"
				mode="aspectFit"
			></image>
		</view>
	</view>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { computed, nextTick, onMounted, onUnmounted, ref, watch } from 'vue'
import {
	configureNavigationAccessibility,
	navigationSelectionFeedback,
	readNavigationPreferences,
	systemIncreasesContrast,
	systemReducesMotion
} from '@/utils/navigation-preferences.uts'

const props = withDefaults(defineProps<{ active: string, mode?: string }>(), { mode: 'student' })
type NavigationItem = { key: string, label: string, id: string, icon: string, selectedIcon: string, url: string }
const items = computed((): NavigationItem[] => {
 const keys = props.mode == 'admin' ? ['overview', 'students', 'records', 'more'] : ['home', 'records', 'profile']
 const labels = props.mode == 'admin' ? ['概览', '学生', '假条', '更多'] : ['总览', '记录', '我的']
 const icons = props.mode == 'admin' ? ['home', 'profile', 'records', 'more'] : ['home', 'records', 'profile']
 const urls = ['/pages/home/index', '/pages/leave/records', '/pages/profile/index']
 const result: NavigationItem[] = []
 for (let i = 0; i < keys.length; i++) {
  result.push({ key: keys[i], label: labels[i], id: (props.mode == 'admin' ? 'admin-navigation-' : 'navigation-') + keys[i],
   icon: '/static/common/tabbar/' + icons[i] + '-outline.svg', selectedIcon: '/static/common/tabbar/' + icons[i] + '-outline-blue.svg',
   url: props.mode == 'admin' ? keys[i] : urls[i] } as NavigationItem)
 }
 return result
})
const emit = defineEmits(['navigate', 'create'])
const windowWidth = ref(uni.getWindowInfo().windowWidth)
const navigationWidth = computed((): number => props.mode == 'admin' ? Math.min(408, windowWidth.value - 32) : Math.min(340, windowWidth.value - 110))
const dockStyle = computed(
	(): string =>
		'width:' +
		(navigationWidth.value + (props.mode == 'admin' ? 0 : 68)) +
		'px;left:' +
		(windowWidth.value - navigationWidth.value - (props.mode == 'admin' ? 0 : 68)) / 2 +
		'px;'
)
function activeIndex(): number {
	for (let i = 0; i < items.value.length; i++) if (items.value[i].key == props.active) return i
	return 0
}
const selectedIndex = ref(activeIndex())
const selectionX = ref(0)
const dragging = ref(false)
const pressed = ref(false)
const reduceMotion = ref(false)
const reduceTransparency = ref(false)
const highContrast = ref(false)
const haptics = ref(true)
let tracking = false
let gestureCancelled = false
let moved = false
let locked = false
let startX = 0
let startY = 0
let startSelectionX = 0
let suppressClickUntil = 0
let settleTimer = 0

// Android 页面未开启底部穿透，系统导航区域已在页面之外。
const navigationStyle = computed((): string => {
	return 'width:' + navigationWidth.value + 'px;'
})
const navigationClass = computed((): string => {
	let value = 'bottom-navigation'
	if (reduceTransparency.value) value += ' bottom-navigation-solid'
	if (highContrast.value) value += ' bottom-navigation-contrast'
	return value
})
const selectionWidth = computed((): number => (navigationWidth.value - 12) / items.value.length)
const selectionClass = computed((): string => {
	let value = 'nav-selection'
	if (highContrast.value) value += ' nav-selection-contrast'
	if (dragging.value || reduceMotion.value) value += ' nav-selection-instant'
	return value
})
const selectionStyle = computed((): string => {
	let scaleX = 1
	let scaleY = 1
	if (!reduceMotion.value && pressed.value) {
		scaleX = dragging.value ? 1.075 : 1.035
		scaleY = dragging.value ? 0.96 : 1.06
	}
	return (
		'width:' +
		selectionWidth.value +
		'px;transform:translateX(' +
		selectionX.value +
		'px) scaleX(' +
		scaleX +
		') scaleY(' +
		scaleY +
		');'
	)
})
const sheenStyle = computed((): string => {
	return (
		'opacity:' +
		(reduceTransparency.value || highContrast.value ? '0' : pressed.value ? '0.9' : '0.5') +
		';'
	)
})

function iconClass(index: number): string {
	let value = 'nav-icon'
	if (selectedIndex.value == index && !reduceMotion.value)
		value += pressed.value ? ' nav-icon-pressed' : ' nav-icon-active'
	if (reduceMotion.value) value += ' nav-icon-instant'
	return value
}

function labelClass(index: number): string {
	if (selectedIndex.value != index)
		return highContrast.value ? 'nav-label nav-label-contrast' : 'nav-label'
	return highContrast.value
		? 'nav-label nav-label-active nav-label-active-contrast'
		: 'nav-label nav-label-active'
}

function restore() {
	clearTimeout(settleTimer)
	tracking = false
	dragging.value = false
	pressed.value = false
	locked = false
	selectedIndex.value = activeIndex()
	selectionX.value = selectedIndex.value * selectionWidth.value
}

function updateLayout() {
	windowWidth.value = uni.getWindowInfo().windowWidth
	restore()
}

function settle(index: number) {
	selectedIndex.value = index
	selectionX.value = index * selectionWidth.value
	dragging.value = false
	pressed.value = false
	locked = true
	settleTimer = setTimeout(
		() => {
			locked = false
		},
		reduceMotion.value ? 0 : 320
	)
	if (index != activeIndex()) {
		// 常驻主页面立即确认切换，胶囊在同一视图中继续完成回弹。
		emit('navigate', items.value[index].url)
	}
}

function selectTab(index: number) {
	if (locked || tracking || Date.now() < suppressClickUntil) return
	if (index == activeIndex()) return
	settle(index)
}

function updateAccessibility() {
 for (let i = 0; i < items.value.length; i++) {
  const index = i
  const item = items.value[index]
  configureNavigationAccessibility(uni.getElementById(item.id), item.label, props.active == item.key, () => selectTab(index))
 }
}

function refreshPreferences() {
	const preferences = readNavigationPreferences()
	reduceMotion.value = preferences.reduceMotion || systemReducesMotion()
	highContrast.value = preferences.highContrast || systemIncreasesContrast()
	reduceTransparency.value = preferences.reduceTransparency || highContrast.value
	haptics.value = preferences.haptics
	restore()
	nextTick(() => updateAccessibility())
}

function handleTouchCancel() {
	if (locked) return
	gestureCancelled = true
	suppressClickUntil = Date.now() + 350
	restore()
}

function handleTouchStart(event: UniTouchEvent) {
	if (locked) return
	if (event.touches.length != 1) {
		handleTouchCancel()
		return
	}
	const touch = event.touches[0]
	gestureCancelled = false
	tracking = true
	moved = false
	pressed.value = true
	startX = touch.pageX
	startY = touch.pageY
	startSelectionX = selectionX.value
}

function handleTouchMove(event: UniTouchEvent) {
	if (locked || !tracking) return
	if (event.touches.length != 1) {
		handleTouchCancel()
		return
	}
	const touch = event.touches[0]
	const dx = touch.pageX - startX
	const dy = touch.pageY - startY
	if (!moved && Math.abs(dy) > 8 && Math.abs(dy) > Math.abs(dx)) {
		handleTouchCancel()
		return
	}
	if (!moved && Math.abs(dx) <= 8) return
	moved = true
	dragging.value = true
	event.preventDefault()
	selectionX.value = Math.max(0, Math.min(selectionWidth.value * (items.value.length - 1), startSelectionX + dx))
	selectedIndex.value = Math.round(selectionX.value / selectionWidth.value)
}

function handleTouchEnd(event: UniTouchEvent) {
	if (gestureCancelled) {
		suppressClickUntil = Date.now() + 350
		if (event.touches.length == 0) gestureCancelled = false
		return
	}
	if (locked || !tracking) return
	if (event.touches.length > 0) {
		handleTouchCancel()
		return
	}
	tracking = false
	pressed.value = false
	if (!moved) return
	suppressClickUntil = Date.now() + 350
	settle(Math.round(selectionX.value / selectionWidth.value))
}

refreshPreferences()
watch(
	(): string => props.active,
	(active: string, previous: string) => {
		selectedIndex.value = activeIndex()
		selectionX.value = selectedIndex.value * selectionWidth.value
		nextTick(() => {
			updateAccessibility()
			if (active != previous && haptics.value) {
				navigationSelectionFeedback(
					uni.getElementById(
						items.value[activeIndex()].id
					)
				)
			}
		})
	}
)
onMounted(() => updateAccessibility())
onPageShow(() => refreshPreferences())
onPageHide(() => {
	gestureCancelled = true
	restore()
})
onUnmounted(() => clearTimeout(settleTimer))
defineExpose({ restore, updateLayout })

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
@import '@/styles/ios-theme.scss';

.navigation-dock {
	position: fixed;
	bottom: 12px;
	z-index: 6;
	height: 64px;
	flex-direction: row;
	align-items: center;
}
.nav-create {
	box-sizing: border-box;
	width: 56px;
	height: 56px;
	margin-left: 12px;
	border-radius: 28px;
	background-color: #0066dc;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4px 12px rgba(0, 102, 220, 0.22);
}
.nav-create-symbol {
	width: 29px;
	height: 29px;
}
.bottom-navigation {
	box-sizing: border-box;
	position: relative;
	height: 64px;
	border-radius: 32px;
	background-color: rgba(250, 251, 253, 0.83);
	border: 1px solid rgba(255, 255, 255, 0.65);
	box-shadow: 0 8px 24px rgba(20, 25, 36, 0.13);
}
.bottom-navigation-solid {
	background-color: #f7f8fa;
}
.bottom-navigation-contrast {
	box-sizing: border-box;
	background-color: #ffffff;
	border-color: #727780;
}
.nav-glass-sheen {
	box-sizing: border-box;
	position: absolute;
	left: 12px;
	right: 12px;
	top: 1px;
	height: 30px;
	border-radius: 28px;
	background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
	transition-property: opacity;
	transition-duration: 120ms;
}
.nav-selection {
	box-sizing: border-box;
	position: absolute;
	left: 5px;
	top: 5px;
	height: 52px;
	border-radius: 26px;
	background-color: rgba(218, 225, 234, 0.56);
	border: 0.5px solid rgba(255, 255, 255, 0.68);
	box-shadow: 0 2px 5px rgba(37, 44, 59, 0.06);
	transition-property: transform;
	transition-duration: 320ms;
	transition-timing-function: cubic-bezier(0.2, 1.35, 0.35, 1);
}
.nav-selection-contrast {
	box-sizing: border-box;
	background-color: #e1ebf9;
	border-color: #0055b3;
}
.nav-selection-instant {
	transition-duration: 0ms;
}
.nav-items {
	position: absolute;
	left: 5px;
	right: 5px;
	top: 5px;
	height: 52px;
	flex-direction: row;
}
.nav-item {
	flex: 1;
	height: 52px;
	align-items: center;
	justify-content: center;
}
.nav-icon {
	width: 21px;
	height: 21px;
	transition-property: transform;
	transition-duration: 320ms;
	transition-timing-function: cubic-bezier(0.2, 1.35, 0.35, 1);
}
.nav-icon-active {
	transform: scale(1.04);
}
.nav-icon-pressed {
	transform: scale(1.12);
}
.nav-icon-instant {
	transition-duration: 0ms;
}
.nav-label {
	margin-top: 3px;
	font-size: 11px;
	line-height: 14px;
	font-weight: 500;
	color: #606773;
}
.nav-label-active {
	color: #0063d1;
	font-weight: 600;
}
.nav-label-contrast {
	color: #252932;
}
.nav-label-active-contrast {
	color: #004fa8;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-nav-create {
	background-color: $ios-dark-button;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
}
.dark-bottom-navigation {
	background-color: rgba(28, 29, 35, 0.94);
	border-color: $ios-dark-separator;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
}
.dark-bottom-navigation-solid {
	background-color: $ios-dark-panel;
}
.dark-bottom-navigation-contrast {
	background-color: $ios-dark-surface;
	border-color: #8e909d;
}
.dark-nav-glass-sheen {
	background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
}
.dark-nav-selection {
	background-color: #303c50;
	border-color: #485265;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
}
.dark-nav-selection-contrast {
	background-color: #263c5b;
	border-color: #91c0ff;
}
.dark-nav-label {
	color: $ios-dark-secondary;
}
.dark-nav-label-active {
	color: $ios-dark-blue;
}
.dark-nav-label-contrast {
	color: $ios-dark-ink;
}
.dark-nav-label-active-contrast {
	color: #91c0ff;
}
.contrast-nav-label {
	color: #d2d3dc;
}
.contrast-nav-label-contrast {
	color: #ffffff;
}
</style>
