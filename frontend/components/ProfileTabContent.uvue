<template>
	<view :class="themeClass('page')">
		<scroll-view
			:class="themeClass('content-scroll')"
			scroll-y="true"
			:scroll-top="scrollTop"
			:show-scrollbar="false"
			@scroll="rememberScroll"
		>
			<view :class="themeClass('safe-top')"></view>
			<view :class="themeClass('content')">
				<view :class="themeClass('header')">
					<text :class="themeClass('page-title')">我的</text>
					<view
						:class="themeClass('settings-button')"
						role="button"
						aria-label="设置"
						@click="openSettings"
					>
						<image
							:class="themeClass('settings-symbol')"
							:src="themeImage('/static/ios/settings-secondary.svg')"
							mode="aspectFit"
						></image>
					</view>
				</view>
				<view
					:class="themeClass('profile-card')"
					@click="openInfo"
				>
					<view :class="themeClass('card-orb')"></view>
					<view :class="themeClass('identity-row')">
						<view :class="themeClass('identity-copy')">
							<image
								:class="themeClass('identity-icon')"
								:src="themeImage('/static/ios/school-white.svg')"
								mode="aspectFit"
							></image>
							<text :class="themeClass('identity-label')">校园身份</text>
						</view>
						<text :class="themeClass('identity-arrow')">查看信息 ›</text>
					</view>
					<view :class="themeClass('profile-main')">
						<image
							v-if="avatarURL != '' && !avatarLoadFailed"
							:class="themeClass('profile-avatar')"
							:src="themeImage(avatarURL)"
							mode="aspectFill"
							@click.stop="openAvatar"
							@error="handleAvatarError"
						></image>
						<view
							v-else
							:class="themeClass('profile-avatar profile-avatar-placeholder')"
							@click.stop="openAvatar"
						>
							<text :class="themeClass('avatar-initial')">
								{{ profileName.trim() == '' ? '同' : profileName.trim().slice(0, 1) }}
							</text>
						</view>
						<view :class="themeClass('profile-details')">
							<text :class="themeClass('profile-name')">{{ profileName == '' ? '未完善资料' : profileName }}</text>
							<text :class="themeClass('profile-class')">
								{{ className == '' ? '请完善个人资料' : className }}
							</text>
						</view>
					</view>
					<view :class="themeClass('student-row')">
						<text :class="themeClass('student-label')">学号</text>
						<text :class="themeClass('student-number')">{{ studentID }}</text>
					</view>
				</view>
				<view :class="themeClass('service-group')">
					<text :class="themeClass('section-title')"> 资料与账号 </text>
					<view :class="themeClass('service-card')">
						<view
							:class="themeClass('service-item')"
							@click="openInfo"
						>
							<view :class="themeClass('service-icon-box service-icon-blue')">
								<image
									:class="themeClass('service-icon')"
									:src="themeImage('/static/ios/user-white.svg')"
									mode="aspectFit"
								></image>
							</view>
							<text :class="themeClass('service-title')"> 个人信息 </text>
							<image
								:class="themeClass('service-arrow')"
								:src="themeImage('/static/ios/arrow-secondary.svg')"
								mode="aspectFit"
							></image>
						</view>
						<view
							:class="themeClass('service-item')"
							@click="openEdit"
						>
							<view :class="themeClass('service-icon-box service-icon-green')">
								<image
									:class="themeClass('service-icon')"
									:src="themeImage('/static/ios/edit-white.svg')"
									mode="aspectFit"
								></image>
							</view>
							<text :class="themeClass('service-title')"> 编辑资料 </text>
							<image
								:class="themeClass('service-arrow')"
								:src="themeImage('/static/ios/arrow-secondary.svg')"
								mode="aspectFit"
							></image>
						</view>
						<view
							:class="themeClass('service-item')"
							@click="openPassword"
						>
							<view :class="themeClass('service-icon-box service-icon-grey')">
								<image
									:class="themeClass('service-icon')"
									:src="themeImage('/static/ios/lock-white.svg')"
									mode="aspectFit"
								></image>
							</view>
							<text :class="themeClass('service-title')"> 修改密码 </text>
							<image
								:class="themeClass('service-arrow')"
								:src="themeImage('/static/ios/arrow-secondary.svg')"
								mode="aspectFit"
							></image>
						</view>
					</view>
				</view>
				<view :class="themeClass('service-group')">
					<text :class="themeClass('section-title')"> 偏好与支持 </text>
					<view :class="themeClass('service-card')">
						<view
							:class="themeClass('service-item')"
							@click="openSettings"
						>
							<view :class="themeClass('service-icon-box service-icon-grey')">
								<image
									:class="themeClass('service-icon')"
									:src="themeImage('/static/ios/settings-white.svg')"
									mode="aspectFit"
								></image>
							</view>
							<text :class="themeClass('service-title')"> 设置 </text>
							<image
								:class="themeClass('service-arrow')"
								:src="themeImage('/static/ios/arrow-secondary.svg')"
								mode="aspectFit"
							></image>
						</view>
						<view
							:class="themeClass('service-item')"
							@click="openFeedback"
						>
							<view :class="themeClass('service-icon-box service-icon-orange')">
								<image
									:class="themeClass('service-icon')"
									:src="themeImage('/static/ios/bubble-white.svg')"
									mode="aspectFit"
								></image>
							</view>
							<text :class="themeClass('service-title')"> 反馈与建议 </text>
							<image
								:class="themeClass('service-arrow')"
								:src="themeImage('/static/ios/arrow-secondary.svg')"
								mode="aspectFit"
							></image>
						</view>
					</view>
				</view>
				<view
					:class="themeClass('logout-card')"
					@click="handleLogout"
				>
					<text :class="themeClass('logout-text')">退出登录</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { onUnmounted, ref, watch } from 'vue'
import {
	cacheAvatarFile,
	clearAvatarFileCache,
	getCachedAvatarSource
} from '@/utils/avatar-cache.uts'
import {
	getCurrentUser,
	getProfile,
	getStoredAvatarURL,
	uploadAvatar,
	AvatarUploadError,
	logout as clearSession,
	logoutRequest
} from '@/utils/api.uts'
import { chooseAvatarImage } from '@/utils/avatar-picker.uts'

const props = defineProps<{ active: boolean }>()
const scrollTop = ref(0)
function rememberScroll(event: UniScrollEvent) {
	scrollTop.value = event.detail.scrollTop
}
const profileName = ref(getCurrentUser().name)
const studentID = ref(getCurrentUser().student_id)
const className = ref(getCurrentUser().class_name)
const avatarURL = ref(getCachedAvatarSource(getCurrentUser().student_id, getStoredAvatarURL()))
const avatarLoadFailed = ref(false)
const changingAvatar = ref(false)
const avatarMenuOpen = ref(false)
let avatarUpdateVersion = 0
let pageActive = props.active

function handleAvatarError() {
	const remoteURL = getStoredAvatarURL()
	if (remoteURL != '' && avatarURL.value != remoteURL) {
		clearAvatarFileCache(getCurrentUser().student_id)
		avatarURL.value = remoteURL
		return
	}
	avatarLoadFailed.value = true
}

async function changeAvatar(): Promise<void> {
	if (changingAvatar.value) return
	changingAvatar.value = true
	const currentStudentID = getCurrentUser().student_id
	let uploading = false
	try {
		const path = await chooseAvatarImage()
		if (path == '' || !pageActive || currentStudentID != getCurrentUser().student_id) return
		// 上传期间使旧的头像加载任务失效，避免覆盖新头像。
		avatarUpdateVersion++
		uploading = true
		uni.showLoading({ title: '正在上传…', mask: true })
		const remoteURL = await uploadAvatar(path)
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		avatarLoadFailed.value = false
		avatarURL.value = remoteURL
		const source = await cacheAvatarFile(currentStudentID, remoteURL)
		if (
			!pageActive ||
			currentStudentID != getCurrentUser().student_id ||
			remoteURL != getStoredAvatarURL()
		)
			return
		avatarLoadFailed.value = false
		avatarURL.value = source
		uni.hideLoading()
		uploading = false
		uni.showToast({ title: '头像更新成功', icon: 'success' })
	} catch (error) {
		if (uploading) {
			uni.hideLoading()
			uploading = false
		}
		if (!pageActive || currentStudentID != getCurrentUser().student_id) return
		if (error instanceof AvatarUploadError) return
		const message = (error as Error).message
		if (message == '请先完善个人信息') {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		uni.showToast({
			title: message == null || message == '' ? '头像上传失败，请重试' : message,
			icon: 'none'
		})
	} finally {
		if (uploading) uni.hideLoading()
		changingAvatar.value = false
	}
}

function openAvatar() {
	if (changingAvatar.value || avatarMenuOpen.value) return
	avatarMenuOpen.value = true
	const currentStudentID = getCurrentUser().student_id
	uni.showActionSheet({
		itemList: ['查看头像', '更换头像'],
		success: (result) => {
			if (!pageActive || currentStudentID != getCurrentUser().student_id) return
			if (result.tapIndex == 1) {
				changeAvatar()
				return
			}
			if (result.tapIndex != 0) return
			const source = avatarLoadFailed.value ? getStoredAvatarURL() : avatarURL.value
			if (source == '') {
				uni.showToast({ title: '暂无可查看的头像', icon: 'none' })
				return
			}
			uni.previewImage({
				urls: [source],
				current: source,
				fail: (_) => {
					uni.showToast({ title: '头像预览失败，请重试', icon: 'none' })
				}
			})
		},
		complete: (_) => {
			avatarMenuOpen.value = false
		}
	})
}

async function loadAvatar() {
	if (changingAvatar.value) return
	const updateVersion = avatarUpdateVersion
	const currentStudentID = getCurrentUser().student_id
	try {
		const profile = await getProfile()
		if (
			!pageActive ||
			currentStudentID != getCurrentUser().student_id ||
			updateVersion != avatarUpdateVersion
		)
			return
		if (profile == null) {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		const cachedURL = getStoredAvatarURL()
		const remoteURL = cachedURL == '' ? profile.avatar_url : cachedURL
		const latestURL = await cacheAvatarFile(currentStudentID, remoteURL)
		if (
			!pageActive ||
			currentStudentID != getCurrentUser().student_id ||
			updateVersion != avatarUpdateVersion ||
			remoteURL != getStoredAvatarURL()
		)
			return
		if (latestURL != avatarURL.value || avatarLoadFailed.value) {
			avatarLoadFailed.value = false
			avatarURL.value = latestURL
		}
	} catch (error) {
		if (
			!pageActive ||
			currentStudentID != getCurrentUser().student_id ||
			updateVersion != avatarUpdateVersion
		)
			return
		const message = (error as Error).message
		if (message == '请先完善个人信息') {
			uni.reLaunch({ url: '/pages/profile/edit?first=1' })
			return
		}
		uni.showToast({
			title: message == null || message == '' ? '头像加载失败' : message,
			icon: 'none'
		})
	}
}

function openInfo() {
	uni.navigateTo({ url: '/pages/profile/info' })
}

function openEdit() {
	uni.navigateTo({ url: '/pages/profile/edit' })
}

function openRecords() {
	uni.navigateTo({ url: '/pages/leave/records' })
}

function openFeedback() {
	uni.navigateTo({ url: '/pages/profile/feedback' })
}

function openPassword() {
	uni.navigateTo({ url: '/pages/profile/password' })
}

function openSettings() {
	uni.navigateTo({ url: '/pages/profile/settings' })
}

async function handleLogout() {
	try {
		await logoutRequest()
	} catch (error) {
		const message = (error as Error).message
		uni.showToast({
			title: message == null || message == '' ? '退出登录失败' : message,
			icon: 'none'
		})
	} finally {
		clearSession()
		uni.reLaunch({ url: '/pages/auth/login' })
	}
}
function refresh() {
	const user = getCurrentUser()
	profileName.value = user.name
	studentID.value = user.student_id
	className.value = user.class_name
	const cachedURL = getStoredAvatarURL()
	const cachedSource = getCachedAvatarSource(user.student_id, cachedURL)
	if (cachedSource != '' && cachedSource != avatarURL.value) {
		avatarLoadFailed.value = false
		avatarURL.value = cachedSource
	}
	loadAvatar()
}
watch(
	(): boolean => props.active,
	(active: boolean) => {
		pageActive = active
		if (!active) avatarUpdateVersion++
	}
)
onUnmounted(() => {
	pageActive = false
	avatarUpdateVersion++
})

defineExpose({ refresh })

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
