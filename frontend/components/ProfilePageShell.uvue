<template>
	<PageTransition ref="pageTransition" enter-direction="forward">
		<view class="shell-page">
			<image class="shell-background" src="/static/my/common/background/default.png" mode="aspectFill"></image>
			<view class="shell-safe-top"></view>
			<view class="shell-back-row">
				<view class="shell-back-button" @click="goBack">
					<image class="shell-back-icon" src="/static/my/password/back.png" mode="aspectFit"></image>
				</view>
			</view>
			<scroll-view v-if="scrollable" class="shell-scroll" scroll-y="true" :show-scrollbar="false">
				<view class="shell-content">
					<view class="shell-heading">
						<text class="shell-title">{{ title }}</text>
						<text class="shell-subtitle">{{ subtitle }}</text>
					</view>
					<slot></slot>
				</view>
			</scroll-view>
			<view v-else class="shell-content shell-fixed-content">
				<view class="shell-heading">
					<text class="shell-title">{{ title }}</text>
					<text class="shell-subtitle">{{ subtitle }}</text>
				</view>
				<slot></slot>
			</view>
		</view>
	</PageTransition>
</template>

<script setup lang="uts">
import PageTransition from '@/components/PageTransition.uvue'

const props = defineProps<{
		title: string
		subtitle: string
		scrollable: boolean
	}>()

function goBack() {
	uni.navigateBack({})
}

function navigate(url: string, method: string = 'navigateTo', direction: string = 'forward') {
	if (method == 'reLaunch') uni.reLaunch({ url: url })
	else if (method == 'redirectTo') uni.redirectTo({ url: url })
	else if (method == 'navigateBack') uni.navigateBack({})
	else uni.navigateTo({ url: url })
}

defineExpose({ navigate })
</script>

