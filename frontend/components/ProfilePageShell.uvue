<template>
	<PageTransition enter-direction="forward">
		<view :class="themeClass('shell-page')">
			<view :class="themeClass('shell-safe-top')"></view>
			<view :class="themeClass('shell-toolbar')">
				<view
					:class="themeClass('shell-back-button')"
					role="button"
					aria-label="返回"
					@click="goBack"
				>
					<image
						:class="themeClass('shell-chevron')"
						:src="themeImage('/static/ios/back-ink.svg')"
						mode="aspectFit"
					></image>
				</view>
				<text :class="themeClass('shell-title')">{{ title }}</text>
				<view :class="themeClass('shell-toolbar-end')">
					<view
						v-if="showClose"
						:class="themeClass('shell-back-button')"
						role="button"
						aria-label="关闭"
						@click="goBack"
					>
						<image
							:class="themeClass('shell-chevron')"
							:src="themeImage('/static/ios/close-secondary.svg')"
							mode="aspectFit"
						></image>
					</view>
					<slot
						v-else
						name="toolbar"
					></slot>
				</view>
			</view>
			<scroll-view
				v-if="scrollable"
				:class="themeClass('shell-scroll')"
				scroll-y="true"
				:show-scrollbar="false"
				:scroll-into-view="scrollTarget"
				@scrolltolower="emit('scrolltolower')"
			>
				<view :class="themeClass('shell-content')">
					<text
						v-if="subtitle != ''"
						:class="themeClass('shell-subtitle')"
					>
						{{ subtitle }}
					</text>
					<slot></slot>
				</view>
			</scroll-view>
			<view
				v-else
				:class="themeClass('shell-content shell-fixed-content')"
			>
				<text
					v-if="subtitle != ''"
					:class="themeClass('shell-subtitle')"
				>
					{{ subtitle }}
				</text>
				<slot></slot>
			</view>
		</view>
	</PageTransition>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import PageTransition from '@/components/PageTransition.uvue'
import { logout } from '@/utils/api.uts'

const props = withDefaults(
	defineProps<{
		title: string
		subtitle: string
		scrollable: boolean
		logoutOnBack?: boolean
		interceptBack?: boolean
		showClose?: boolean
		scrollTarget?: string
	}>(),
	{ logoutOnBack: false, interceptBack: false, showClose: false, scrollTarget: '' }
)

const emit = defineEmits(['scrolltolower', 'back'])

function goBack() {
	if (props.interceptBack) {
		emit('back')
		return
	}
	if (props.logoutOnBack) {
		logout()
		uni.reLaunch({ url: '/pages/auth/login' })
		return
	}
	uni.navigateBack({})
}

function navigate(url: string, method: string = 'navigateTo', direction: string = 'forward') {
	if (method == 'reLaunch') uni.reLaunch({ url: url })
	else if (method == 'redirectTo') uni.redirectTo({ url: url })
	else if (method == 'navigateBack') uni.navigateBack({})
	else uni.navigateTo({ url: url })
}

defineExpose({ navigate })

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

<style lang="scss">
@import '@/styles/ios-theme.scss';
.shell-page {
	flex: 1;
	overflow: hidden;
	background-color: $ios-page;
}
.shell-safe-top {
	height: var(--status-bar-height);
}
.shell-toolbar {
	box-sizing: border-box;
	height: 53px;
	padding: 0 15px;
	flex-direction: row;
	align-items: center;
}
.shell-back-button {
	box-sizing: border-box;
	width: 44px;
	height: 44px;
	border-radius: 22px;
	background-color: #e8e8ed;
	align-items: center;
	justify-content: center;
}
.shell-chevron {
	width: 21px;
	height: 21px;
}
.shell-title {
	flex: 1;
	text-align: center;
	color: $ios-ink;
	font-size: 17px;
	font-weight: 600;
}
.shell-toolbar-end {
	min-width: 44px;
	align-items: flex-end;
}
.shell-scroll {
	flex: 1;
}
.shell-content {
	box-sizing: border-box;
	padding: 13px 21px 38px;
}
.shell-fixed-content {
	flex: 1;
}
.shell-subtitle {
	font-size: 13px;
	line-height: 20px;
	color: $ios-secondary;
	margin: 6px 2px 8px;
}

// Dark appearance. Geometry stays shared with the light appearance.
.dark-shell-page {
	background-color: $ios-dark-page;
}
.dark-shell-back-button {
	background-color: $ios-dark-panel;
}
.dark-shell-title {
	color: $ios-dark-ink;
}
.dark-shell-subtitle {
	color: $ios-dark-secondary;
}
.contrast-shell-title {
	color: #ffffff;
}
.contrast-shell-subtitle {
	color: #d2d3dc;
}
</style>
