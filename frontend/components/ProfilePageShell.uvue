	height: var(--status-bar-height);
}
.shell-back-row {
	position: relative;
	z-index: 2;
	height: 92rpx;
	padding-left: 38rpx;
	justify-content: center;
}
.shell-back-button {
	width: 82rpx;
	height: 84rpx;
	justify-content: center;
	align-items: flex-start;
}
.shell-back-icon {
	width: 50rpx;
	height: 50rpx;
}
.shell-scroll {
	position: relative;
	z-index: 1;
	flex: 1;
}
.shell-content {
	box-sizing: border-box;
	padding: 12rpx 44rpx 80rpx;
}
.shell-fixed-content {
	position: relative;
	z-index: 1;
	flex: 1;
}
.shell-heading {
	margin-left: 8rpx;
}
.shell-title {
	color: #123b78;
	font-size: 48rpx;
