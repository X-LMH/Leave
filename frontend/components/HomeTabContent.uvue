<template>
	<view class="page">
		<image class="page-background" src="/static/home/index/background.png" mode="aspectFill"></image>
		<scroll-view class="home-scroll" scroll-y="true" :scroll-top="scrollTop" @scroll="rememberScroll" :show-scrollbar="false">
			<view class="foreground-content">
				<view class="welcome-row">
					<view class="welcome-copy">
						<view class="greeting-row">
							<text class="greeting">{{ timeGreeting }}，</text>
							<text class="greeting-name">{{ userName == '' ? '同学' : userName }}</text>
							<text class="greeting-wave"> 👋</text>
						</view>
						<text class="greeting-subtitle">{{ greetingSubtitle }}</text>
					</view>
				</view>
				<view class="hero">
					<text class="hero-title">请假申请</text>
					<text class="hero-subtitle">轻松请假 · 简单高效</text>
					<view class="leave-wrap" @touchstart="handleLeavePress" @touchend="handleLeaveRelease" @touchcancel="handleLeaveRelease" @click="handleCreateLeave">
						<view :class="isLeavePressed ? 'leave-halo halo-outer halo-outer-pressed' : 'leave-halo halo-outer'">
						</view>
						<view :class="isLeavePressed ? 'leave-halo halo-middle halo-middle-pressed' : 'leave-halo halo-middle'">
						</view>
						<view :class="isLeavePressed ? 'leave-halo halo-inner halo-inner-pressed' : 'leave-halo halo-inner'">
						</view>
						<view :class="isLeavePressed ? 'leave-button leave-button-pressed' : 'leave-button'">
							<view class="leave-button-content">
								<image class="leave-icon" src="/static/home/index/icons/leave-main.png" mode="widthFix"></image>
								<text class="leave-label">发起请假</text>
							</view>
						</view>
					</view>
				</view>
				<view class="records-card" @click="openRecords">
					<view class="records-icon-wrap">
						<image class="records-icon" src="/static/my/index/icons/form-edit.png" mode="aspectFit"></image>
					</view>
					<view class="records-copy">
						<text class="records-title">请假记录</text>
						<text class="records-description">查看申请进度与历史记录</text>
					</view>
					<image class="records-arrow" src="/static/my/index/icons/arrow-right.png" mode="aspectFit"></image>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { getCurrentUser } from '@/utils/api.uts'

const isLeavePressed = ref(false)
const userName = ref(getCurrentUser().name)
function getTimeGreeting(date: Date): string {
	const hour = date.getHours()
	if (hour >= 5 && hour < 11) return '早上好'
	if (hour >= 11 && hour < 13) return '中午好'
	if (hour >= 13 && hour < 18) return '下午好'
	return '晚上好'
}

const timeGreeting = ref(getTimeGreeting(new Date()))
const greetingSubtitles = [
	'今天也要好好照顾自己哦',
	'愿你今天也有好心情',
	'累了就休息一下吧',
	'照顾好自己，再出发',
	'愿每一天都轻松一点'
]
const greetingIndexStorageKey = 'home_greeting_index'
const storedGreetingIndex = uni.getStorageSync(greetingIndexStorageKey)
let greetingIndex = typeof storedGreetingIndex == 'number' ? storedGreetingIndex as number : 0
const greetingSubtitle = ref(greetingSubtitles[0])

function handleLeavePress() {
	isLeavePressed.value = true
}

function handleLeaveRelease() {
	isLeavePressed.value = false
}

function handleCreateLeave() {
	isLeavePressed.value = false
	uni.navigateTo({ url: '/pages/leave/apply' })
}

function openRecords() {
	uni.navigateTo({ url: '/pages/leave/records' })
}

function refresh() {
	userName.value = getCurrentUser().name
	timeGreeting.value = getTimeGreeting(new Date())
	greetingSubtitle.value = greetingSubtitles[greetingIndex]
	greetingIndex = (greetingIndex + 1) % greetingSubtitles.length
	uni.setStorageSync(greetingIndexStorageKey, greetingIndex)
}

const scrollTop = ref(0)
function rememberScroll(event: UniScrollEvent) {
	scrollTop.value = event.detail.scrollTop
}
defineExpose({ refresh })
</script>

<style>
