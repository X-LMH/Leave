<template>
	<view :class="themeClass('home-page')">
		<scroll-view
			:class="themeClass('home-scroll')"
			scroll-y="true"
			:scroll-top="scrollTop"
			:show-scrollbar="false"
			@scroll="rememberScroll"
		>
			<view :class="themeClass('safe-top')"></view>
			<view :class="themeClass('home-content')">
				<view :class="themeClass('home-header')">
					<text :class="themeClass('page-title')">请假</text>
					<view
						:class="themeClass('account-button')"
						role="button"
						aria-label="个人信息"
						@click="openInfo"
					>
						<image
							v-if="avatarURL != '' && !avatarFailed"
							:class="themeClass('account-avatar')"
							:src="themeImage(avatarURL)"
							mode="aspectFill"
							@error="handleAvatarError"
						></image>
						<view
							v-else
							:class="themeClass('account-avatar account-avatar-placeholder')"
						>
							<text :class="themeClass('account-initial')">
								{{ profileName.trim() == '' ? '同' : profileName.trim().slice(0, 1) }}
							</text>
						</view>
					</view>
				</view>
				<view
					:class="themeClass('application-card')"
					role="button"
					aria-label="申请请假"
					@click="createLeave"
				>
					<view :class="themeClass('application-copy')">
						<text :class="themeClass('application-title')">申请请假</text>
						<text :class="themeClass('application-description')">填写信息，生成假条</text>
					</view>
					<view :class="themeClass('application-art-back')"></view>
					<view :class="themeClass('application-art')">
						<image
							:class="themeClass('application-art-symbol')"
							:src="themeImage('/static/ios/calendar-blue.svg')"
							mode="aspectFit"
						></image>
						<view :class="themeClass('paper-line')"></view>
						<view :class="themeClass('paper-line paper-line-short')"></view>
					</view>
				</view>

				<view :class="themeClass('overview-section')">
					<view :class="themeClass('overview-heading')">
						<text :class="themeClass('section-title')">数据概览</text>
						<view :class="themeClass('example-badge')"><text :class="themeClass('example-text')">示例</text></view>
					</view>
					<view :class="themeClass('overview-card')">
						<view
							v-for="(metric, index) in homeOverview.metrics"
							:key="metric.label"
							:class="themeClass(index == 2 ? 'overview-item overview-item-last' : 'overview-item')"
						>
							<view :class="themeClass('metric-value-row')">
								<text :class="themeClass('metric-value')">{{ metric.value }}</text>
								<text :class="themeClass('metric-unit')">{{ metric.unit }}</text>
							</view>
							<text :class="themeClass('metric-label')">{{ metric.label }}</text>
						</view>
					</view>
				</view>
				<view :class="themeClass('latest-section')">
					<view :class="themeClass('section-heading')">
						<text :class="themeClass('section-title')">最新假条</text>
						<view
							:class="themeClass('records-link')"
							@click="emit('records')"
						>
							<text :class="themeClass('link-text')">查看记录 ›</text>
						</view>
					</view>
					<view
						v-if="loading"
						:class="themeClass('empty-card')"
					>
						<text :class="themeClass('state-text')">正在加载最新假条…</text>
					</view>
					<view
						v-else-if="loadError != ''"
						:class="themeClass('empty-card')"
						@click="refresh"
					>
						<text :class="themeClass('state-text')">{{ loadError }}</text>
						<text :class="themeClass('retry-text')">轻点重试</text>
					</view>
					<view
						v-else-if="recordID > 0"
						:class="themeClass('latest-card')"
						@click="openDetail"
					>
						<view :class="themeClass('request-heading')">
							<view :class="themeClass('request-type-row')">
								<image
									:class="themeClass('request-type-icon')"
									:src="themeImage('/static/ios/calendar-purple.svg')"
									mode="aspectFit"
								></image>
								<text :class="themeClass('request-type')">{{ leaveType }}</text>
							</view>
							<view :class="themeClass('request-status-row')">
								<image
									:class="themeClass('status-icon')"
									:src="themeImage('/static/ios/check-green.svg')"
									mode="aspectFit"
								></image>
								<text :class="themeClass('request-status')">已同意</text>
							</view>
						</view>
						<text :class="themeClass('request-date')">{{ dateText }}</text>
						<text :class="themeClass('request-time')">{{ timeText }}</text>
						<view :class="themeClass('request-meta')">
							<view :class="themeClass('meta-item')">
								<image
									:class="themeClass('meta-icon')"
									:src="themeImage('/static/ios/clock-secondary.svg')"
									mode="aspectFit"
								></image>
								<text :class="themeClass('meta-text')">{{ durationText }}</text>
							</view>
							<view
								v-if="outsideText != ''"
								:class="themeClass('meta-item')"
							>
								<image
									:class="themeClass('meta-icon')"
									:src="themeImage('/static/ios/location-secondary.svg')"
									mode="aspectFit"
								></image>
								<text :class="themeClass('meta-text')">{{ outsideText }}</text>
							</view>
						</view>
						<view :class="themeClass('request-footer')">
							<text :class="themeClass('link-text')">查看假条</text>
							<image
								:class="themeClass('link-arrow')"
								:src="themeImage('/static/ios/arrow-blue.svg')"
								mode="aspectFit"
							></image>
						</view>
					</view>
					<view
						v-else
						:class="themeClass('empty-card')"
					>
						<text :class="themeClass('empty-title')">还没有假条</text>
						<text :class="themeClass('state-text')">需要请假时，轻点下方的加号。</text>
					</view>
				</view>
				<view :class="themeClass('shortcut-row')">
					<view
						:class="themeClass('shortcut')"
						@click="openInfo"
					>
						<image
							:class="themeClass('shortcut-symbol')"
							:src="themeImage('/static/common/tabbar/profile-outline-blue.svg')"
							mode="aspectFit"
						></image>
						<view :class="themeClass('shortcut-copy')">
							<text :class="themeClass('shortcut-title')">个人资料</text>
							<text :class="themeClass('shortcut-description')">身份与联系方式</text>
						</view>
					</view>
					<view
						:class="themeClass('shortcut')"
						@click="createLeave"
					>
						<image
							:class="themeClass('shortcut-symbol')"
							:src="themeImage('/static/common/tabbar/records-outline-blue.svg')"
							mode="aspectFit"
						></image>
						<view :class="themeClass('shortcut-copy')">
							<text :class="themeClass('shortcut-title')">填写申请</text>
							<text :class="themeClass('shortcut-description')">时间、课程与去向</text>
						</view>
					</view>
				</view>

				<view :class="themeClass('reminder-card')">
					<image
						:class="themeClass('reminder-icon')"
						:src="themeImage('/static/ios/calendar-blue.svg')"
						mode="aspectFit"
					></image>
					<view :class="themeClass('reminder-copy')"
						><text :class="themeClass('reminder-title')">{{ homeOverview.reminderTitle }}</text>
						<text :class="themeClass('reminder-text')">{{ homeOverview.reminderText }}</text></view
					>
				</view>
			</view>
		</scroll-view>
	</view>
</template>
<script setup lang="uts">
import { themeClass as resolveThemeClass, themeImage as resolveThemeImage } from '@/utils/app-theme.uts'
import { onUnmounted, ref } from 'vue'
import {
	getCurrentUser,
	getRecord,
	getRecords,
	getStoredAvatarURL,
	getProfile
} from '@/utils/api.uts'
import {
	cacheAvatarFile,
	getCachedAvatarSource,
	clearAvatarFileCache
} from '@/utils/avatar-cache.uts'

type HomeMetric = {
	label: string
	value: number
	unit: string
}
type HomeOverview = {
	metrics: HomeMetric[]
	reminderTitle: string
	reminderText: string
}
// 独立于真实最新假条；统计区域明确标注示例，后续由后端提供同形数据。
const homeOverview: HomeOverview = {
	metrics: [
		{ label: '累计请假', value: 12, unit: '次' },
		{ label: '本月请假', value: 2, unit: '次' },
		{ label: '累计时长', value: 36, unit: '小时' }
	],
	reminderTitle: '校园提醒',
	reminderText: '提交前核对时间、课程与去向，确保联系方式准确'
}

const emit = defineEmits(['records'])
const scrollTop = ref(0)
function rememberScroll(event: UniScrollEvent) {
	scrollTop.value = event.detail.scrollTop
}
const profileName = ref(getCurrentUser().name)
const avatarURL = ref(getCachedAvatarSource(getCurrentUser().student_id, getStoredAvatarURL()))
const avatarFailed = ref(false)
let avatarRequest = 0
function handleAvatarError() {
	const remoteURL = getStoredAvatarURL()
	if (remoteURL != '' && avatarURL.value != remoteURL) {
		clearAvatarFileCache(getCurrentUser().student_id)
		avatarURL.value = getCachedAvatarSource('', remoteURL)
		return
	}
	avatarFailed.value = true
}
async function refreshAvatar() {
	const request = ++avatarRequest
	const user = getCurrentUser()
	profileName.value = user.name
	avatarURL.value = getCachedAvatarSource(user.student_id, getStoredAvatarURL())
	avatarFailed.value = false
	try {
		const profile = await getProfile()
		if (
			request != avatarRequest ||
			user.student_id != getCurrentUser().student_id ||
			profile == null
		)
			return
		profileName.value = profile.name
		const storedURL = getStoredAvatarURL()
		const remoteURL = storedURL == '' ? profile.avatar_url : storedURL
		const source = await cacheAvatarFile(user.student_id, remoteURL)
		if (
			request != avatarRequest ||
			user.student_id != getCurrentUser().student_id ||
			remoteURL != getStoredAvatarURL()
		)
			return
		avatarURL.value = source
		avatarFailed.value = false
	} catch (_) {
		/* 头像失败不阻断首页真实假条。 */
	}
}
const loading = ref(false)
const loadError = ref('')
const recordID = ref(0)
const leaveType = ref('')
const dateText = ref('')
const timeText = ref('')
const durationText = ref('')
const outsideText = ref('')
let requestVersion = 0
function createLeave() {
	uni.navigateTo({ url: '/pages/leave/apply' })
}
function openInfo() {
	uni.navigateTo({ url: '/pages/profile/info' })
}
function openDetail() {
	uni.navigateTo({ url: '/pages/leave/detail?id=' + recordID.value + '&source=records' })
}
function clock(value: string): string {
	const date = new Date(value)
	if (isNaN(date.getTime())) return value
	return (
		(date.getHours() < 10 ? '0' : '') +
		date.getHours() +
		':' +
		(date.getMinutes() < 10 ? '0' : '') +
		date.getMinutes()
	)
}
function day(value: string): string {
	const date = new Date(value)
	if (isNaN(date.getTime())) return value
	return date.getMonth() + 1 + '月' + date.getDate() + '日'
}
async function refresh() {
	refreshAvatar()
	const version = ++requestVersion
	const studentID = getCurrentUser().student_id
	loading.value = true
	loadError.value = ''
	outsideText.value = ''
	try {
		const records = await getRecords(1, 1)
		if (version != requestVersion || studentID != getCurrentUser().student_id) return
		if (records.length == 0) {
			recordID.value = 0
			return
		}
		const item = records[0]
		recordID.value = item.id
		leaveType.value = item.leave_type.replace('-本科生', '')
		dateText.value =
			day(item.start_time) +
			(day(item.start_time) == day(item.end_time) ? '' : ' — ' + day(item.end_time))
		timeText.value = clock(item.start_time) + ' — ' + clock(item.end_time)
		durationText.value =
			(item.duration_days > 0 ? item.duration_days.toFixed(0) + '天' : '') +
			(item.duration_hours > 0 || item.duration_days == 0
				? item.duration_hours.toFixed(0) + '小时'
				: '')
		// 列表不含离校字段；详情失败不影响已加载的假条入口。
		try {
			const detail = await getRecord(item.id)
			if (version == requestVersion && studentID == getCurrentUser().student_id)
				outsideText.value = detail.is_leave_school ? '离校' : '不离校'
		} catch (_) {}
	} catch (error) {
		if (version != requestVersion || studentID != getCurrentUser().student_id) return
		const message = (error as Error).message
		loadError.value = message == null || message == '' ? '最新假条加载失败' : message
	} finally {
		if (version == requestVersion) loading.value = false
	}
}
onUnmounted(() => {
	requestVersion++
	avatarRequest++
})
defineExpose({ refresh })

// 原生模板通过本地方法调用主题函数，避免导入函数被编译为 unref 后调用。
function themeClass(classes: string): string {
	return resolveThemeClass(classes)
}

function themeImage(source: string): string {
	return resolveThemeImage(source)
}
</script>

