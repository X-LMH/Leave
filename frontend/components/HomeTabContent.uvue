	letter-spacing:2rpx
}
.records-card {
	flex-direction:row;
	align-items:center;
	margin-top:64rpx;
	padding:32rpx 28rpx;
	border-radius:32rpx;
	background:rgba(255,255,255,.78);
	border:2rpx solid rgba(255,255,255,.9);
	box-shadow:0 12rpx 32rpx rgba(79,106,180,.06)
}
.records-icon-wrap {
