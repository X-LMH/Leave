	flex-shrink:0;
	color:#173766;
	font-size:42rpx;
	font-weight:700
}
.greeting-subtitle {
	margin-top:12rpx;
	color:#7d90b3;
	font-size:28rpx;
	line-height:42rpx
}
.hero {
	align-items:center;
	margin-top:128rpx
}
.hero-title {
	color:#173766;
	font-size:48rpx;
	font-weight:700;
	letter-spacing:2rpx
}
.hero-subtitle {
	margin-top:12rpx;
	color:#7d90b3;
	font-size:28rpx;
	line-height:42rpx
}
.leave-wrap {
	position:relative;
	z-index:2;
	width:100%;
	height:520rpx;
	margin-top:48rpx;
	align-items:center;
	justify-content:center
}
.leave-halo {
	position:absolute;
	border-radius:9999rpx;
	transition-property:opacity;
	transition-duration:140ms
}
.halo-outer {
	width:520rpx;
	height:520rpx;
	opacity:.72;
	background:rgba(255,255,255,.12);
	border:2rpx solid rgba(255,255,255,.38)
}
.halo-middle {
	width:476rpx;
	height:476rpx;
	opacity:.86;
	background:rgba(255,255,255,.2);
	border:3rpx solid rgba(255,255,255,.58);
	box-shadow:0 0 36rpx rgba(255,255,255,.48)
}
.halo-inner {
	width:426rpx;
	height:426rpx;
	background:rgba(255,255,255,.42);
	border:3rpx solid rgba(255,255,255,.9);
	box-shadow:inset 0 0 24rpx rgba(255,255,255,.72)
}
.halo-outer-pressed {
	opacity:.42
}
.halo-middle-pressed {
	opacity:.58
}
.halo-inner-pressed {
	opacity:.78
}
.leave-button {
	position:relative;
	width:360rpx;
	height:360rpx;
	border-radius:180rpx;
	align-items:center;
	justify-content:center;
	background-color:#4778f6;
	background-image:linear-gradient(145deg,#5b8cff 0%,#4778f6 50%,#315fdf 100%);
	border:3rpx solid rgba(255,255,255,.72);
	box-shadow:inset 0 10rpx 18rpx rgba(255,255,255,.26),0 18rpx 34rpx rgba(55,88,196,.3);
	transition-property:transform,box-shadow;
	transition-duration:140ms
}
.leave-button-pressed {
	transform:scale(.96);
	box-shadow:inset 0 7rpx 14rpx rgba(255,255,255,.24),0 8rpx 18rpx rgba(55,88,196,.2)
}
.leave-button-content {
