# 可提交的完整测试构建配置，仅包含浏览器可见的非敏感设置。
# 本地或 CI 使用前复制为 .env.test；同域 /api/v1 由测试站点 Nginx 代理。
VITE_BASE_URL=/
VITE_APP_TITLE=请销假管理系统（测试环境）
VITE_ROUTER_HISTORY_MODE=history

VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local

VITE_SERVICE_BASE_URL=/api/v1
# 服务器静态部署不使用 Vite 开发代理；API 由 Nginx 转发。
VITE_SERVICE_PROXY_TARGET=
VITE_SERVICE_SUCCESS_CODE=0
VITE_SERVICE_LOGOUT_CODES=401
VITE_SERVICE_MODAL_LOGOUT_CODES=401
VITE_SERVICE_EXPIRED_TOKEN_CODES=401
VITE_OTHER_SERVICE_BASE_URL={}
VITE_HTTP_PROXY=N
VITE_SOURCE_MAP=N
# 测试环境使用 leave-admin-test，避免复用默认开发环境的登录信息。
VITE_STORAGE_PREFIX=leave-admin-test

VITE_STATIC_SUPER_ROLE=R_SUPER
VITE_AUTH_ROUTE_MODE=static
VITE_ROUTE_HOME=home
VITE_MENU_ICON=carbon:circle-dash
